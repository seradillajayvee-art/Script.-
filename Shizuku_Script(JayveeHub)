    round(bar, 3)

    local startPos = math.clamp((default - min) / (max - min), 0, 1)

    local fill = mk("Frame", { Size = UDim2.new(startPos, 0, 1, 0), BackgroundColor3 = Theme.Accent }, bar)
    round(fill, 3)
    mk("UIGradient", { Color = ColorSequence.new(Theme.AccentDark, Theme.Accent) }, fill)

    local knob = mk("Frame", {
        Size = UDim2.new(0, 14, 0, 14), AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(startPos, 0, 0.5, 0), BackgroundColor3 = Color3.new(1, 1, 1),
        ZIndex = 2,
    }, bar)
    round(knob, 7)

    local hit = mk("TextButton", {
        Size = UDim2.new(1, 0, 0, 28), AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 0, 0.5, 0), BackgroundTransparency = 1, Text = "",
    }, bar)

    local dragging = false

    local function update(input)
        local pos = math.clamp((input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
        local val = math.floor((min + (max - min) * pos) * 100 + 0.5) / 100
        if max - min > 10 then val = math.floor(val + 0.5) end
        fill.Size = UDim2.new(pos, 0, 1, 0)
        knob.Position = UDim2.new(pos, 0, 0.5, 0)
        valLbl.Text = tostring(val)
        callback(val)
    end

    hit.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            tween(knob, 0.12, { Size = UDim2.new(0, 19, 0, 19) })
            update(input)
        end
    end)

    table.insert(connections, UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            if dragging then
                dragging = false
                tween(knob, 0.12, { Size = UDim2.new(0, 14, 0, 14) })
            end
        end
    end))

    table.insert(connections, UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            update(input)
        end
    end))
end

