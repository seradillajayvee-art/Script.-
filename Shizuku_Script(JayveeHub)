    local firstFace = mainFrameObj:FindFirstChild("Face")
    if not firstFace then return nil, nil end

    local innerFrames = {}
    for _, child in ipairs(firstFace:GetChildren()) do
        if child:IsA("Frame") then table.insert(innerFrames, child) end
    end

    local targetFrame1, targetFrame2 = nil, nil
    for _, f in ipairs(innerFrames) do
        local subFace = f:FindFirstChild("Face")
        if subFace and subFace:IsA("GuiObject") then
            if not targetFrame1 then
                targetFrame1 = subFace
            else
                targetFrame2 = subFace
                break
            end
        end
    end
    return targetFrame1, targetFrame2
end

local function clickButton(button)
    if button and button:IsA("TextButton") then
        local success = false
        pcall(function()
            for _, conn in ipairs(getconnections(button.Activated)) do
                conn:Fire()
                success = true
            end
            for _, conn in ipairs(getconnections(button.MouseButton1Click)) do
                conn:Fire()
                success = true
            end
        end)
        if not success then
            pcall(function()
                local absPos = button.AbsolutePosition
                local absSize = button.AbsoluteSize
                local cx = absPos.X + (absSize.X / 2)
                local cy = absPos.Y + (absSize.Y / 2)
                VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, true, game, 0)
                task.wait(0.05)
                VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, false, game, 0)
            end)
        end
    end
end

local function pressKey(keyCode)
    pcall(function()
        VirtualInputManager:SendKeyEvent(true, keyCode, false, game)
        task.wait(0.02)
        VirtualInputManager:SendKeyEvent(false, keyCode, false, game)
    end)
end

