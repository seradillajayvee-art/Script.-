local function monitorCharacter(char, player)
    local humanoid = char:WaitForChild("Humanoid", 5)
    if not humanoid then return end
    table.insert(connections, humanoid.AnimationPlayed:Connect(function(animTrack)
        local animId = string.match(animTrack.Animation.AnimationId or "", "%d+$")
        if not animId then return end
        local localHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        local enemyHrp = char:FindFirstChild("HumanoidRootPart")
        if not localHrp or not enemyHrp then return end
        local dist = (localHrp.Position - enemyHrp.Position).Magnitude

        if config.FaceTargetEnabled and (targetAttackIds[animId] or criticalAttackIds[animId]) then
            task.spawn(function()
                if config.FaceTargetDelayMs > 0 then
                    task.wait(config.FaceTargetDelayMs / 1000)
                end
                if localHrp and enemyHrp and localHrp.Parent and enemyHrp.Parent then
                    localHrp.CFrame = CFrame.new(localHrp.Position, Vector3.new(enemyHrp.Position.X, localHrp.Position.Y, enemyHrp.Position.Z))
                end
            end)
        end

        local critStyle, critDelay = nil, nil
        for style, info in pairs(criticalAttackIds) do
            if info.Id == animId then
                critStyle, critDelay = style, info.Delay
                break
            end
        end

        if critStyle and config.CritParryEnabled and dist <= config.CritDistance then
            if tick() < rActiveEndTime then return end
            if tick() - lastCritParryTime >= 0.3 then
                lastCritParryTime = tick()
                pressCritParryKey(critDelay)
            end
            return
        end

        if targetAttackIds[animId] then
            local isMySkillReady = (tick() - lastMySkillUseTick >= totalCooldown)

            if config.CustomKeyEnabled and isMySkillReady and dist <= config.CustomKeyDistance and (tick() - lastCustomKeyTime >= config.CustomKeyCooldown) then
                lastCustomKeyTime = tick()
                pressCustomKey()
            end

            if config.Enabled and dist <= config.Distance and (tick() - lastParryTime >= config.Cooldown) then
                if tick() >= rActiveEndTime then
                    lastParryTime = tick()
                    pressParryKey()
                end
            end
        end
    end))
end

