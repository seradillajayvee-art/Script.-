local function createESP(player)
    if player == LocalPlayer then return end
    local espData = { Billboard = Instance.new("BillboardGui"), TextLabel = Instance.new("TextLabel") }
    espData.Billboard.Size = UDim2.new(0, 200, 0, 50)
    espData.Billboard.StudsOffset = Vector3.new(0, 3, 0)
    espData.Billboard.AlwaysOnTop = true
    espData.TextLabel.Size = UDim2.new(1, 0, 1, 0)
    espData.TextLabel.BackgroundTransparency = 1
    espData.TextLabel.TextColor3 = Theme.Accent
    espData.TextLabel.TextStrokeTransparency = 0
    espData.TextLabel.TextSize = 14
    espData.TextLabel.Font = Enum.Font.GothamBold
    espData.TextLabel.Parent = espData.Billboard
    espData.Billboard.Parent = CoreGui
    espObjects[player] = espData

    table.insert(connections, RunService.RenderStepped:Connect(function()
        if not config.ESPEnabled or not player.Character then
            espData.Billboard.Enabled = false
            return
        end
        local character = player.Character
        local head = character:FindFirstChild("Head")
        local enemyHrp = character:FindFirstChild("HumanoidRootPart")
        local localChar = LocalPlayer.Character
        local localHrp = localChar and localChar:FindFirstChild("HumanoidRootPart")

        if head and enemyHrp and localHrp then
            local distance = (localHrp.Position - enemyHrp.Position).Magnitude
            if distance <= config.ESPDistance then
                if espData.Billboard.Adornee ~= head then espData.Billboard.Adornee = head end
                espData.Billboard.Enabled = true
                local hp, maxHp = getHealthInfo(character)
                espData.TextLabel.Text = string.format("%s [%d Studs]\nâ¤ HP: %d/%d", player.Name, math.floor(distance), hp, maxHp)
            else
                espData.Billboard.Enabled = false
            end
        else
            espData.Billboard.Enabled = false
        end
    end))
end

