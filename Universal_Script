local function dodgeChatAlreadyUsed(index)
	for _, used in ipairs(dodgeChatRecent) do
		if used == index then return true end
	end
	return false
end

local function pickDodgeChatLine()
	local available = {}
	for i = 1, #DODGE_CHAT_LINES do
		if not dodgeChatAlreadyUsed(i) then table.insert(available, i) end
	end
	if #available == 0 then
		dodgeChatRecent = {}
		for i = 1, #DODGE_CHAT_LINES do table.insert(available, i) end
	end
	local index = available[math.random(1, #available)]
	table.insert(dodgeChatRecent, index)
	if #dodgeChatRecent > math.min(5, #DODGE_CHAT_LINES - 1) then
		table.remove(dodgeChatRecent, 1)
	end
	return DODGE_CHAT_LINES[index]
end

local function sendChatLine(text)
	local sent = false
	pcall(function()
		local TCS = game:GetService("TextChatService")
		if TCS.ChatVersion == Enum.ChatVersion.TextChatService then
			local channels = TCS:FindFirstChild("TextChannels")
			local ch = channels and (channels:FindFirstChild("RBXGeneral") or channels:FindFirstChildWhichIsA("TextChannel"))
			if ch and ch.Parent then
				ch:SendAsync(tostring(text))
				sent = true
			end
		end
	end)
	if sent then return true end

	pcall(function()
		local RS = game:GetService("ReplicatedStorage")
		local events = RS:FindFirstChild("DefaultChatSystemChatEvents")
		local say = events and events:FindFirstChild("SayMessageRequest")
		if say then say:FireServer(text, "All"); sent = true end
	end)
	return sent
end

local function maybeDodgeChat()
	if not Settings.DodgeChatEnabled then return end
	local every = math.max(5, math.floor(tonumber(Settings.DodgeChatEvery) or 5))
	if Settings.DodgeCount < every or Settings.DodgeCount % every ~= 0 then return end
	local now = os.clock()
	if now - dodgeChatLastAt < math.max(0, tonumber(Settings.DodgeChatCooldown) or 2.5) then return end
	local text = pickDodgeChatLine()
	if sendChatLine(text) then
		dodgeChatLastAt = now
	end
end

