local SIZE_MIN, SIZE_MAX = 0.60, 1.40 -- same range as the MENU SIZE stepper
local sizeDragging, sizeStartX, sizeStartValue = false, 0, Settings.MenuScale
local function refreshSizeButton()
	sizeBtn.Text = string.format("SIZE %d%%", math.floor(Settings.MenuScale * 100 + 0.5))
end
sizeBtn.Active = true
sizeBtn.AutoButtonColor = false
sizeBtn.InputBegan:Connect(function(input)
	if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
	sizeDragging = true
	sizeStartX = input.Position.X
	sizeStartValue = Settings.MenuScale
	sizeBtn.BackgroundColor3 = theme().b
	U.play("click")
	input.Changed:Connect(function()
		if input.UserInputState == Enum.UserInputState.End then
			sizeDragging = false
