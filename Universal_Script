function U.fitScale(w, h, extra)
	local cam = workspace.CurrentCamera
	local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
	-- the viewport can be 0/1 pixels right at startup: use a sane default instead
	if vp.X < 200 or vp.Y < 200 then vp = Vector2.new(1280, 720) end
	local base = math.min(1, (vp.X - 20) / w, (vp.Y - 20) / h)
	local limit = math.min((vp.X - 8) / w, (vp.Y - 8) / h)
	return math.max(math.min(math.max(base * (extra or 1), 0.3), limit), 0.25)
end

local function clampGuiToViewport(frame, margin)
	U.clampGui(frame, margin)
end

