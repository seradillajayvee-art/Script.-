local function hookTool(tool)
	if not tool:IsA("Tool") or tool:GetAttribute("JV_Hooked") then return end
	tool:SetAttribute("JV_Hooked", true)
	bind(tool.Activated, function()
		lastOwnAction = os.clock()
		local target = U.getEnemyInsideRadius()
		if target then U.lockCameraToTarget(target) end
	end)
end

function U.hookCharacterTools(char)
	for _, obj in ipairs(char:GetChildren()) do hookTool(obj) end
	bind(char.ChildAdded, hookTool)
end

function U.hookDamage()
	if damageConnection then damageConnection:Disconnect(); damageConnection = nil end
	if not humanoid then return end
	lastHealth = humanoid.Health
	damageConnection = humanoid.HealthChanged:Connect(function(newHealth)
		-- Alternate Ultra Instinct trigger: crossing from above 50% HP to 50% or below.
		-- It deliberately checks UltraActive == false, so it cannot retrigger while Ultra is ON.
		if Settings.UltraHalfHPTrigger and Settings.Enabled and not Settings.UltraActive
			and not halfHPTriggered and humanoid.MaxHealth > 0
			and lastHealth and lastHealth > humanoid.MaxHealth * 0.5
			and newHealth <= humanoid.MaxHealth * 0.5 and newHealth > 0 then
			halfHPTriggered = true
			task.defer(function()
				if Settings.Enabled and not Settings.UltraActive and humanoid and humanoid.Health > 0 then
					setUltra(true)
				end
			end)
		end

		if lastHealth and newHealth < lastHealth - 0.5
			and Settings.Enabled and Settings.AutoDodge and Settings.UltraActive then
			local st = humanoid:GetState()
			local fallDamage = (st == Enum.HumanoidStateType.Freefall or st == Enum.HumanoidStateType.Landed)
			if not fallDamage then
				-- damage from anything (even unseen sources): dodge again right away
				local enemyInside = U.getEnemyInsideRadius()
				if enemyInside then U.lockCameraToTarget(enemyInside) end
				senseCooldown = 0
				task.defer(dodge, enemyInside)
			end
		end
		lastHealth = newHealth
	end)
end

-- remember when YOU used an ability (so our own hitboxes don't trigger a dodge)
local MOVE_KEYS = {
	[Enum.KeyCode.W] = true, [Enum.KeyCode.A] = true, [Enum.KeyCode.S] = true, [Enum.KeyCode.D] = true,
	[Enum.KeyCode.Space] = true, [Enum.KeyCode.Up] = true, [Enum.KeyCode.Down] = true,
	[Enum.KeyCode.Left] = true, [Enum.KeyCode.Right] = true, [Enum.KeyCode.Thumbstick1] = true,
	[Enum.KeyCode.LeftShift] = true, [Enum.KeyCode.RightShift] = true,
}
bind(UIS.InputBegan, function(input, processed)
	if processed then return end
	local t = input.UserInputType
	if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.MouseButton2 then
		lastOwnAction = os.clock()
	elseif t == Enum.UserInputType.Keyboard and not MOVE_KEYS[input.KeyCode] then
		lastOwnAction = os.clock()
	end
end)

--==================================================
-- CUSTOM MOVEMENT (Arczis walk/run animation adapter)
--==================================================
local Arczis = {Id = "rbxassetid://117414822036545", Fade = 0.16}
do
	local track, hum, conn
	function Arczis.Stop()
		if track then pcall(function() track:Stop(Arczis.Fade) end) end
	end
	function Arczis.Disconnect()
		if conn then conn:Disconnect(); conn = nil end
		if track then
			pcall(function() track:Stop(0) end)
			pcall(function() track:Destroy() end)
			track = nil
		end
	end
	function Arczis.Setup(char)
		Arczis.Disconnect()
		if not Settings.CustomMovement then return end
		hum = char:WaitForChild("Humanoid", 8)
		if not hum then return end
		local animator = hum:FindFirstChildOfClass("Animator")
		if not animator then animator = new("Animator", nil, hum) end
		local anim = Instance.new("Animation")
		anim.AnimationId = Arczis.Id
		local ok, t = pcall(function() return animator:LoadAnimation(anim) end)
		if not ok or not t then
			-- Invalid/unavailable custom animation: leave Roblox's normal movement animation alone.
			Settings.CustomMovement = false
			Arczis.Disconnect()
			return
		end
		t.Priority = Enum.AnimationPriority.Movement
		t.Looped = true
		track = t
		conn = RunService.RenderStepped:Connect(function()
			if not hum or not hum.Parent or not track then return end
			if not Settings.CustomMovement then
				if track.IsPlaying then Arczis.Stop() end
				return
			end
			local st = hum:GetState()
			local airborne = st == Enum.HumanoidStateType.Jumping or st == Enum.HumanoidStateType.Freefall
				or st == Enum.HumanoidStateType.Climbing or st == Enum.HumanoidStateType.Swimming
				or st == Enum.HumanoidStateType.Seated or st == Enum.HumanoidStateType.Dead
			local moving = hum.MoveDirection.Magnitude * hum.WalkSpeed > 0.05
			if moving and not airborne then
				if not track.IsPlaying then track:Play(Arczis.Fade, 1, 1) end
			elseif track.IsPlaying then
				Arczis.Stop()
			end
		end)
	end
end

