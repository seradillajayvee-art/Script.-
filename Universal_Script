		end
	end)
end)
bind(UIS.InputChanged, function(input)
	if not sizeDragging then return end
	if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then return end
	local delta = input.Position.X - sizeStartX
	Settings.MenuScale = math.clamp(sizeStartValue + delta / 420, SIZE_MIN, SIZE_MAX)
	refreshSizeButton()
	applyScale()
end)
