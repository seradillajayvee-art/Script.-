-- Probe the sources once and keep the first one that loads
task.spawn(function()
	if IS_STUDIO then return end
	local CP = game:GetService("ContentProvider")
	for _, src in ipairs(PIXEL_SRC_LIST) do
		local probe = Instance.new("Sound")
		probe.SoundId = src
		local ok = false
		pcall(function()
			CP:PreloadAsync({probe}, function(_, status)
				if status == Enum.AssetFetchStatus.Success then ok = true end
			end)
		end)
		probe:Destroy()
		if ok then PIXEL_SRC = src; break end
	end
end)

function U.play(key)
	if not Settings.UISounds then return end
	local def = PIXEL_SOUNDS[key]
	if not def then return end
	for i, speed in ipairs(def.notes) do
		if i == 1 then
			pcall(pixelBlip, speed)
		else
			task.delay((i - 1) * def.step, function() pcall(pixelBlip, speed) end)
		end
	end
end

-- Keeps a frame fully on-screen. Uses AbsolutePosition/AbsoluteSize, so anchor points,
-- scale-based positions and UIScale are all handled by Roblox instead of guessed.
function U.clampGui(frame, margin)
	if not frame or not frame.Parent then return end
	local cam = workspace.CurrentCamera
	local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
	if vp.X < 200 or vp.Y < 200 then return end
	margin = margin or 8
	local absPos, absSize = frame.AbsolutePosition, frame.AbsoluteSize
	local x = math.clamp(absPos.X, margin, math.max(margin, vp.X - absSize.X - margin))
	local y = math.clamp(absPos.Y, margin, math.max(margin, vp.Y - absSize.Y - margin))
	if math.abs(x - absPos.X) > 0.5 or math.abs(y - absPos.Y) > 0.5 then
		local pos = frame.Position
		frame.Position = UDim2.new(pos.X.Scale, pos.X.Offset + (x - absPos.X),
			pos.Y.Scale, pos.Y.Offset + (y - absPos.Y))
	end
end

-- Draggable (mobile friendly). Optional bounds callback keeps the frame on-screen.
function U.draggable(frame, handle, canDrag)
	handle = handle or frame
	local st = {moved = false}
	local dragging, dragStart, startPos = false, nil, nil
	handle.InputBegan:Connect(function(input)
		if handle:GetAttribute("DragEnabled") == false then return end
		if canDrag and not canDrag() then return end
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			st.moved = false
			dragStart = input.Position
			startPos = frame.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then dragging = false end
			end)
		end
	end)
	bind(UIS.InputChanged, function(input)
		if not dragging then return end
		if input.UserInputType ~= Enum.UserInputType.MouseMovement
			and input.UserInputType ~= Enum.UserInputType.Touch then return end
		local delta = input.Position - dragStart
		if delta.Magnitude > 6 then st.moved = true end
		local nextPos = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X,
			startPos.Y.Scale, startPos.Y.Offset + delta.Y)
		frame.Position = nextPos
		if frame:GetAttribute("JV_ClampToViewport") then U.clampGui(frame, 6) end
	end)
	return st
end

