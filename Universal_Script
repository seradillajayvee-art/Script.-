local PIXEL_FONT = Enum.Font.Arcade -- pixelated font
local PIXEL_TEXT_BOOST = 1.2        -- pixel fonts render small, so scale text up a bit

local conns = {}
local function bind(signal, fn)
	local c = signal:Connect(fn)
	table.insert(conns, c)
	return c
end

local function new(class, props, parent)
	local o = Instance.new(class)
	-- tag our own effect parts so the threat sense never reacts to them
	if o:IsA("BasePart") then o:SetAttribute("JV_FX", true) end
	if props then
		for k, v in pairs(props) do
			-- Studio Lite / reduced clients may not expose every optional UI property.
			-- Never let one unsupported property abort the entire menu.
			pcall(function() o[k] = v end)
		end
	end
	-- PIXEL FONT on every text element (menu, security screen, ESP)
	if o:IsA("TextLabel") or o:IsA("TextButton") or o:IsA("TextBox") then
		pcall(function() o.Font = PIXEL_FONT end)
		pcall(function() o.TextSize = math.floor(o.TextSize * PIXEL_TEXT_BOOST + 0.5) end)
	end
	if parent then
		if o:IsA("GuiObject") and not (props and props.LayoutOrder) then
			pcall(function()
				local n = (parent:GetAttribute("_n") or 0) + 1
				parent:SetAttribute("_n", n)
				o.LayoutOrder = n
			end)
		end
		pcall(function() o.Parent = parent end)
	end
	return o
end

