local function resolveLocalAsset(fileName)
	if IS_STUDIO then return nil end
	if not Settings.DeltaClientSupport or not fileName or fileName == "" then return nil end

	local candidates = {
		function() return type(getcustomasset) == "function" and getcustomasset(fileName) or nil end,
		function() return type(getsynasset) == "function" and getsynasset(fileName) or nil end,
	}
	for _, getter in ipairs(candidates) do
		local ok, id = pcall(getter)
		if ok and type(id) == "string" and id ~= "" then
			return id
		end
	end
	return nil
end

local function resolveAudioId(enabled, fileName, assetId)
	if not enabled then return nil end

	local localId = resolveLocalAsset(fileName)
	if localId then return localId end

	assetId = tostring(assetId or "")
	if assetId ~= "" then
		if assetId:match("^rbxassetid://") then return assetId end
		return "rbxassetid://" .. assetId
	end
	return nil
end

local function makeUltraAudio(name, enabled, fileName, assetId, volume)
	local id = resolveAudioId(enabled, fileName, assetId)
	if not id then return nil end

	local s = Instance.new("Sound")
	s.Name = name
	s.SoundId = id
	s.Volume = math.clamp(tonumber(volume) or 0.85, 0, 10)
	s.Parent = SoundService
	table.insert(sounds, s)

	pcall(function()
		game:GetService("ContentProvider"):PreloadAsync({s})
	end)
	return s
end

