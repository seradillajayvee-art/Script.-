local menuOpen, animating = false, false
local STYLES = {
	Back = Enum.EasingStyle.Back, Quint = Enum.EasingStyle.Quint,
	Elastic = Enum.EasingStyle.Elastic, Linear = Enum.EasingStyle.Linear,
}

function U.openMenu()
	if menuOpen or animating or not unlocked then return end
	animating, menuOpen = true, true
	minimized.Visible = false
	local ts = U.targetScale()
	mainScale.Scale = ts
	main.Visible = true
	-- Never let the unlock/open animation start from an off-screen saved position.
	clampGuiToViewport(main, 8)
	local basePos = main.Position
	mainScale.Scale = ts * 0.85
	main.Position = basePos + UDim2.fromOffset(0, 26)
	U.play(openSound)
	local style = STYLES[Settings.IntroAnimation] or Enum.EasingStyle.Back
	local d = math.clamp(Settings.AnimationSpeed, 0.2, 0.9)
	U.tw(mainScale, d, {Scale = ts}, style)
	U.tw(main, d, {Position = basePos}, style)
	task.delay(d, function()
		clampGuiToViewport(main, 8)
		animating = false
	end)
end

local function closeMenu()
	if not menuOpen or animating then return end
	animating, menuOpen = true, false
	local ts = U.targetScale()
	local basePos = main.Position
	U.play("close")
	U.tw(mainScale, 0.2, {Scale = ts * 0.85}, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
	U.tw(main, 0.2, {Position = basePos + UDim2.fromOffset(0, 26)}, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
	task.delay(0.22, function()
		main.Visible = false
		main.Position = basePos
		mainScale.Scale = U.targetScale()
		minimized.Visible = true
		animating = false
	end)
end

minimizeBtn.Activated:Connect(closeMenu)
closeBtn.Activated:Connect(closeMenu)
minimized.Activated:Connect(function()
	if minDrag.moved then return end
	U.openMenu()
end)

bind(UIS.InputBegan, function(input, processed)
	if processed or not unlocked then return end
	if input.KeyCode == Enum.KeyCode.RightShift then
		if menuOpen then closeMenu() else U.openMenu() end
	end
end)

applyScale = function()
	if not animating then
		if menuOpen then mainScale.Scale = U.targetScale() end
	end
	secScale.Scale = U.fitScale(420, 310)
	task.defer(function()
		clampGuiToViewport(main, 6)
		clampGuiToViewport(minimized, 6)
	end)
end

function U.hookViewport()
	local cam = workspace.CurrentCamera
	if cam then bind(cam:GetPropertyChangedSignal("ViewportSize"), applyScale) end
end
U.hookViewport()
bind(workspace:GetPropertyChangedSignal("CurrentCamera"), function() U.hookViewport(); applyScale() end)
task.delay(0.5, function() pcall(applyScale) end)
task.delay(2, function() pcall(applyScale) end)

-- Click feedback on every button inside the main window
local function addClickFX(b)
	if not b:IsA("TextButton") or b:GetAttribute("FX") then return end
	b:SetAttribute("FX", true)
	local s = new("UIScale", {Name = "ClickScale", Scale = 1}, b)
	local solid = b.BackgroundTransparency < 1
	local hover = false
	b.Activated:Connect(function()
		s.Scale = 0.95
		U.tw(s, 0.2, {Scale = (hover and solid) and 1.02 or 1}, Enum.EasingStyle.Back)
	end)
	if solid then -- subtle hover grow on PC
		b.MouseEnter:Connect(function() hover = true; U.tw(s, 0.12, {Scale = 1.02}) end)
		b.MouseLeave:Connect(function() hover = false; U.tw(s, 0.12, {Scale = 1}) end)
	end
end
for _, o in ipairs(main:GetDescendants()) do addClickFX(o) end
main.DescendantAdded:Connect(addClickFX)

