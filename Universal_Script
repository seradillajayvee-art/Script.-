local unlocking, shaking = false, false
local function tryUnlock()
	if unlocking or shaking then return end
	U.play(clickSound)

	if string.upper((passBox.Text:gsub("%s+", ""))) == string.upper(expectedPassword()) then
		unlocking = true
		secStatus.Text = "ACCESS GRANTED - LOADING..."
		secStatus.TextColor3 = Color3.fromRGB(175, 255, 195)
		U.play("success")
		U.tw(loadBar, 0.9, {Size = UDim2.new(1, 0, 1, 0)}, Enum.EasingStyle.Quad)
		task.wait(1)
		U.tw(secScale, 0.25, {Scale = secScale.Scale * 0.85}, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
		task.wait(0.25)
		security.Visible = false
		unlocked = true
		U.showPage("Home")
		-- Re-fit and clamp after the security screen disappears, before the menu animation.
		applyScale()
		clampGuiToViewport(main, 8)
		U.openMenu()
	else
		U.play("error")
		secStatus.Text = "ACCESS DENIED - INVALID KEY"
		secStatus.TextColor3 = Color3.fromRGB(255, 120, 130)
		shaking = true
		local old = security.Position
		U.tw(security, 0.07, {Position = old + UDim2.fromOffset(8, 0)}, Enum.EasingStyle.Linear)
		task.wait(0.07)
		U.tw(security, 0.07, {Position = old - UDim2.fromOffset(8, 0)}, Enum.EasingStyle.Linear)
		task.wait(0.07)
		U.tw(security, 0.07, {Position = old}, Enum.EasingStyle.Linear)
		task.wait(0.07)
		shaking = false
	end
end
unlockBtn.Activated:Connect(tryUnlock)
passBox.FocusLost:Connect(function(enterPressed)
	if enterPressed then tryUnlock() end
end)

