function U.cancelCameraLock()
	cameraLocked = false
	cameraTarget = nil
end

pcall(function() RunService:BindToRenderStep("JAYVEE_CameraLock", Enum.RenderPriority.Camera.Value + 1, function()
	local target = cameraTarget or followTarget
	if not (cameraLocked and target) then
		if bodyLocked then
			bodyLocked = false
			if humanoid then humanoid.AutoRotate = true end
		end
		return
	end
	local cam = workspace.CurrentCamera
	local targetRoot, targetHum = U.getRoot(target), U.getHum(target)
	if not cam or not targetRoot or not targetHum or targetHum.Health <= 0 then
		U.cancelCameraLock()
		return
	end
	if root and (targetRoot.Position - root.Position).Magnitude > math.max(Settings.Radius, Settings.ThreatRange) * 2.5 then
		U.cancelCameraLock()
		return
	end
	local point = targetRoot.Position + Vector3.new(0, 2, 0)
	cam.CFrame = cam.CFrame:Lerp(CFrame.lookAt(cam.CFrame.Position, point), 0.4)
	if root and humanoid and humanoid.Health > 0 then
		local moving = humanoid.MoveDirection.Magnitude > 0.12
		if moving then
			-- Keep the camera locked, but let the mobile joystick control the character.
			bodyLocked = false
			humanoid.AutoRotate = true
			return
		end
		bodyLocked = true
		humanoid.AutoRotate = false
		local flat = Vector3.new(targetRoot.Position.X, root.Position.Y, targetRoot.Position.Z)
		if (flat - root.Position).Magnitude > 0.1 then
			root.CFrame = CFrame.lookAt(root.Position, flat)
		end
	end
end) end)

