-- Track every humanoid model (players + NPCs, even inside folders)
local targetModels = {}
local function trackHumanoid(h)
	if h:IsA("Humanoid") then
		local m = h.Parent
		if m and m:IsA("Model") then targetModels[m] = true end
	end
end
for _, d in ipairs(workspace:GetDescendants()) do trackHumanoid(d) end
bind(workspace.DescendantAdded, function(d) task.defer(trackHumanoid, d) end)

function U.eachTarget(fn)
	for m in pairs(targetModels) do
		if not m.Parent or not m:IsDescendantOf(workspace) then
			targetModels[m] = nil
		elseif m ~= character then
			fn(m)
		end
	end
end

function U.isValidTarget(model)
	if not model or model == character then return false end
	local hum, tr = U.getHum(model), U.getRoot(model)
	return hum ~= nil and tr ~= nil and hum.Health > 0
		and Players:GetPlayerFromCharacter(model) ~= player
end

function U.getEnemyInsideRadius()
	if not root then return nil, math.huge end
	local nearest, best = nil, math.huge
	U.eachTarget(function(model)
		if not U.isValidTarget(model) then return end
		local d = (U.getRoot(model).Position - root.Position).Magnitude
		if d <= Settings.Radius and d < best then
			best, nearest = d, model
		end
	end)
	return nearest, best
end

function U.getAllNearbyTargets()
	local list = {}
	if not root then return list end
	U.eachTarget(function(model)
		if U.isValidTarget(model)
			and (U.getRoot(model).Position - root.Position).Magnitude <= Settings.Radius then
			table.insert(list, model)
		end
	end)
	return list
end

