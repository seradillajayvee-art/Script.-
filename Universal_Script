-- SMART SEARCH: exact text + aliases + token matching + small typo tolerance.
local SEARCH_ALIASES = {
	ui = {"menu", "interface", "gui"},
	cam = {"camera", "view", "lock"},
	tp = {"teleport", "teleportation"},
	tele = {"teleport", "teleportation"},
	dodge = {"evade", "dash", "roll"},
	settings = {"config", "options", "settings"},
	player = {"character", "movement", "player"},
	ultra = {"ultra instinct", "ui", "aura"},
	sound = {"audio", "music", "sfx"},
	anim = {"animation", "animations", "moveset", "movesets"},
}

local function normalizeSearch(v)
	v = string.lower(tostring(v or ""))
	v = v:gsub("[%p%c]", " "):gsub("%s+", " ")
	return v:match("^%s*(.-)%s*$") or ""
end

local function editDistance(a, b)
	if a == b then return 0 end
	if #a == 0 then return #b end
	if #b == 0 then return #a end
	local prev = {}
	for j = 0, #b do prev[j] = j end
	for i = 1, #a do
		local cur = {[0] = i}
		for j = 1, #b do
			local cost = (a:sub(i,i) == b:sub(j,j)) and 0 or 1
			cur[j] = math.min(prev[j] + 1, cur[j-1] + 1, prev[j-1] + cost)
		end
		prev = cur
	end
	return prev[#b]
end

local function smartSearchScore(query, hay)
	query, hay = normalizeSearch(query), normalizeSearch(hay)
	if query == "" then return 1 end
	if hay == query then return 1000 end
	if string.find(hay, query, 1, true) then return 900 end
	local score, matched = 0, 0
	for token in query:gmatch("%S+") do
		local best = 0
		if string.find(hay, token, 1, true) then
			best = 200
		else
			for word in hay:gmatch("%S+") do
				if word:sub(1, #token) == token then best = math.max(best, 150) end
				if #token >= 4 and #word >= 4 and editDistance(token, word) <= 1 then best = math.max(best, 120) end
			end
		end
		if best > 0 then matched += 1; score += best end
	end
	return matched == 0 and 0 or (score + matched * 25)
end

local function searchHaystack(pageName, child, aliasText)
	local parts = {pageName, child.Name}
	for _, d in ipairs(child:GetDescendants()) do
		if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
			-- strip RichText tags so a query like "color" does not match every stepper row
			parts[#parts + 1] = (tostring(d.Text or ""):gsub("<[^>]+>", ""))
		end
	end
	return table.concat(parts, " ") .. aliasText
end

-- noJump = true: just re-filter the tab you are on (used when you tap a tab)
local function applyMenuSearch(noJump)
	local q = normalizeSearch(searchBox.Text)
	searchClear.Visible = searchBox.Text ~= ""

	local aliasText = ""
	for token in q:gmatch("%S+") do
		local words = SEARCH_ALIASES[token]
		if words then aliasText ..= " " .. table.concat(words, " ") end
	end

	local hits, bestOf = {}, {}
	local bestPage, bestScore, total = nil, 0, 0
	for pageName, page in pairs(pages) do
		for _, child in ipairs(page:GetChildren()) do
			if child:IsA("GuiObject") then
				local score = (q == "") and 1 or smartSearchScore(q, searchHaystack(pageName, child, aliasText))
				child.Visible = score > 0
				if score > 0 then
					total += 1
					hits[pageName] = (hits[pageName] or 0) + 1
					bestOf[pageName] = math.max(bestOf[pageName] or 0, score)
					if score > bestScore then bestScore, bestPage = score, pageName end
				end
			end
		end
	end

	-- only leave the current tab when it has no match, or another tab is an exact phrase match
	if q ~= "" and not noJump and bestPage and bestPage ~= currentPage then
		local here = bestOf[currentPage] or 0
		if here == 0 or (bestScore >= 900 and here < 900) then
			U.showPage(bestPage)
		end
	end

	local empty = (q ~= "") and ((hits[currentPage] or 0) == 0)
	searchEmpty.Visible = empty
	if empty then
		searchEmpty.Text = (total > 0) and "NO MATCHES ON THIS TAB\nCheck the other tabs"
			or "NO RESULTS\nTry another keyword"
	end
	content.CanvasPosition = Vector2.new(0, 0)
end

