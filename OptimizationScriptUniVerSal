layoutWindow = function(center)
    local vp = viewport()
    shell.Size = UDim2.fromOffset(math.min(470, vp.X - 20), math.min(310, vp.Y - 20))
    if center then
        shell.Position = UDim2.fromOffset((vp.X - shell.Size.X.Offset) / 2, (vp.Y - shell.Size.Y.Offset) / 2)
    end
    clampFrame(shell)
end

local isOpen = false
local openToken = 0
local function setOpen(v)
    if v == isOpen then return end
    isOpen = v
    openToken = openToken + 1
    local my = openToken
    if v then
        layoutWindow(false)
        shell.Visible = true
        local p = shell.Position
        shell.Position = UDim2.fromOffset(p.X.Offset, p.Y.Offset + 18)
        tween(shell, TI(0.3, Enum.EasingStyle.Quint), { Position = p })
        tween(canvas, TI(0.25), { GroupTransparency = 0 })
        tween(shellStroke, TI(0.25), { Transparency = 0 })
        playSound("Open")
    else
        tween(canvas, TI(0.2), { GroupTransparency = 1 })
        tween(shellStroke, TI(0.2), { Transparency = 1 })
        playSound("Close")
        task.delay(0.22, function()
            if openToken == my and running then shell.Visible = false end
        end)
    end
end

