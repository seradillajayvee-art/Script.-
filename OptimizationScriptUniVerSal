----------------------------------------------------------------
-- DRAG (clamped to screen, tap detection)
----------------------------------------------------------------
local function makeDraggable(handle, target, onTap)
    local dragging, moved = false, false
    local dragStart, startX, startY
    connect(handle.InputBegan, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging, moved = true, false
            dragStart = input.Position
            startX, startY = target.Position.X.Offset, target.Position.Y.Offset
            local ch
            ch = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    if ch then ch:Disconnect() end
                    if not moved and onTap then onTap() end
                end
            end)
        end
    end)
    connect(UIS.InputChanged, function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            local d = input.Position - dragStart
            if d.Magnitude > 6 then moved = true end
            if moved then
                target.Position = clampedPos(target, startX + d.X, startY + d.Y)
            end
        end
    end)
end

----------------------------------------------------------------
-- OPTIMIZER (Anti Lag / Fast / Ultra Fast)
----------------------------------------------------------------
local opt = { anti = false, fast = false, ultra = false }
local backup = setmetatable({}, { __mode = "k" })
local generation = 0
local descConn
local origQuality
local fpsCapChanged = false

local function setProp(inst, prop, value)
    local ok, cur = pcall(function() return inst[prop] end)
    if not ok then return end
    backup[inst] = backup[inst] or {}
    if backup[inst][prop] == nil then backup[inst][prop] = cur end
    pcall(function() inst[prop] = value end)
end

local function restoreAll()
    for inst, props in pairs(backup) do
        for prop, value in pairs(props) do
            pcall(function() inst[prop] = value end)
        end
    end
    table.clear(backup)
end

local function optFlags()
    return {
        anti = opt.anti or opt.fast or opt.ultra,
        fast = opt.fast or opt.ultra,
        ultra = opt.ultra,
    }
end

local function isOwnCharacter(inst)
    local char = lp.Character
    return char ~= nil and inst:IsDescendantOf(char)
end

local function applyInstance(inst, f)
    if f.anti then
        if inst:IsA("ParticleEmitter") or inst:IsA("Trail") or inst:IsA("Beam")
            or inst:IsA("Smoke") or inst:IsA("Fire") or inst:IsA("Sparkles") then
            setProp(inst, "Enabled", false)
        elseif inst:IsA("BlurEffect") or inst:IsA("SunRaysEffect")
            or inst:IsA("ColorCorrectionEffect") or inst:IsA("BloomEffect")
            or inst:IsA("DepthOfFieldEffect") then
            setProp(inst, "Enabled", false)
        elseif inst:IsA("Explosion") then
            setProp(inst, "Visible", false)
        end
    end
    if f.fast and inst:IsA("BasePart") then
        setProp(inst, "CastShadow", false)
        if not isOwnCharacter(inst) then
            setProp(inst, "Material", Enum.Material.SmoothPlastic)
            setProp(inst, "Reflectance", 0)
        end
        if inst:IsA("MeshPart") then
            setProp(inst, "RenderFidelity", Enum.RenderFidelity.Performance)
        end
    end
    if f.ultra then
        if (inst:IsA("Decal") or inst:IsA("Texture")) and not isOwnCharacter(inst) then
            setProp(inst, "Transparency", 1)
        elseif inst:IsA("Atmosphere") then
            setProp(inst, "Density", 0)
            setProp(inst, "Haze", 0)
            setProp(inst, "Glare", 0)
        elseif inst:IsA("Clouds") then
            setProp(inst, "Enabled", false)
        end
    end
end

local function applyGlobal(f)
    if f.anti then
        setProp(Lighting, "GlobalShadows", false)
        setProp(Lighting, "ShadowSoftness", 0)
    end
    if f.fast then
        setProp(Lighting, "EnvironmentDiffuseScale", 0)
        setProp(Lighting, "EnvironmentSpecularScale", 0)
        pcall(function()
            local t = Workspace.Terrain
            setProp(t, "WaterWaveSize", 0)
            setProp(t, "WaterWaveSpeed", 0)
            setProp(t, "WaterReflectance", 0)
            setProp(t, "WaterTransparency", 1)
        end)
    end
    if f.ultra then
        pcall(function()
            origQuality = settings().Rendering.QualityLevel
            settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
        end)
        pcall(function() setProp(Workspace.Terrain, "Decoration", false) end)
        if setfpscap then
            pcall(setfpscap, 999)
            fpsCapChanged = true
        end
    end
end

local function refreshOptimizer()
    generation = generation + 1
    local myGen = generation

    if descConn then descConn:Disconnect() descConn = nil end
    restoreAll()
    if origQuality then
        pcall(function() settings().Rendering.QualityLevel = origQuality end)
        origQuality = nil
    end
    if fpsCapChanged and setfpscap then
        pcall(setfpscap, 60)
        fpsCapChanged = false
    end

    local f = optFlags()
    if not (f.anti or f.fast or f.ultra) then return end

    applyGlobal(f)

    descConn = game.DescendantAdded:Connect(function(inst)
        task.defer(function()
            if running then applyInstance(inst, optFlags()) end
        end)
    end)

    task.spawn(function()
        local count = 0
        local function scan(root)
            for _, inst in ipairs(root:GetDescendants()) do
                if generation ~= myGen or not running then return end
                applyInstance(inst, f)
                count = count + 1
                if count % 250 == 0 then task.wait() end
            end
        end
        scan(Workspace)
        scan(Lighting)
    end)
end

