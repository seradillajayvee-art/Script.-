local minBtn = smallButton("-", -56, Color3.fromRGB(70, 70, 80))
local closeBtn = smallButton("X", -28, Color3.fromRGB(200, 60, 60))

local body = Instance.new("Frame")
body.Size = UDim2.new(1, 0, 1, -36)
body.Position = UDim2.fromOffset(0, 36)
body.BackgroundTransparency = 1
body.Parent = main

local layout = Instance.new("UIListLayout", body)
layout.Padding = UDim.new(0, 8)
layout.HorizontalAlignment = Enum.HorizontalAlignment.Center

local ON = Color3.fromRGB(46, 160, 90)
local OFF = Color3.fromRGB(60, 60, 70)

local buttons = {}
local function makeToggle(label, key)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, -20, 0, 36)
    b.BackgroundColor3 = OFF
    b.Text = label .. ": OFF"
    b.TextColor3 = Color3.new(1, 1, 1)
    b.Font = Enum.Font.GothamSemibold
    b.TextSize = 14
    b.BorderSizePixel = 0
    b.Parent = body
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 8)

    buttons[key] = { btn = b, label = label }

    b.MouseButton1Click:Connect(function()
        state[key] = not state[key]
        b.Text = label .. (state[key] and ": ON" or ": OFF")
        b.BackgroundColor3 = state[key] and ON or OFF
        refresh()
    end)
end

makeToggle("Anti Lag", "anti")
makeToggle("Fast Mode", "fast")
makeToggle("Super Fast Mode", "super")

-- Minimize
local minimized = false
minBtn.MouseButton1Click:Connect(function()
    minimized = not minimized
    body.Visible = not minimized
    main.Size = minimized and UDim2.fromOffset(210, 36) or UDim2.fromOffset(210, 190)
end)

-- Close (restores everything)
closeBtn.MouseButton1Click:Connect(function()
    state.anti, state.fast, state.super = false, false, false
    refresh()
    gui:Destroy()
end)

-- Dragging (mouse + touch)
do
    local dragging, dragStart, startPos
    main.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = main.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            main.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)
end
