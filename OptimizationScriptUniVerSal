local function viewport()
    local a = gui.AbsoluteSize
    if a.X <= 0 or a.Y <= 0 then
        local cam = Workspace.CurrentCamera
        return cam and cam.ViewportSize or Vector2.new(800, 400)
    end
    return a
end

local function clampedPos(frame, x, y)
    local vp = viewport()
    local s = Vector2.new(frame.Size.X.Offset, frame.Size.Y.Offset)
    return UDim2.fromOffset(
        math.clamp(x, 0, math.max(0, vp.X - s.X)),
        math.clamp(y, 0, math.max(0, vp.Y - s.Y))
    )
end
local function clampFrame(frame)
    frame.Position = clampedPos(frame, frame.Position.X.Offset, frame.Position.Y.Offset)
end

