connect(gui:GetPropertyChangedSignal("AbsoluteSize"), function()
    layoutWindow(false)
    clampFrame(icon)
    clampFrame(overlay)
end)

-- safety net: icon & overlay can never stay off-screen
task.spawn(function()
    while running do
        clampFrame(icon)
        clampFrame(overlay)
        task.wait(1)
    end
end)

----------------------------------------------------------------
-- UNLOAD
----------------------------------------------------------------
local function unload()
    if not running then return end
    running = false
    opt.anti, opt.fast, opt.ultra = false, false, false
    pcall(refreshOptimizer)
    pcall(clearESP)
    pcall(clearSky)
    for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
    pcall(function() gui:Destroy() end)
    pcall(function() espFolder:Destroy() end)
    env.FastFlagsUnload = nil
end
env.FastFlagsUnload = unload

----------------------------------------------------------------
-- START
----------------------------------------------------------------
do
    local vp = viewport()
    icon.Position = UDim2.fromOffset(14, vp.Y * 0.35)
    clampFrame(icon)
    overlay.Position = UDim2.fromOffset((vp.X - 168) / 2, 14)
    clampFrame(overlay)
end
selectTab("Home", true)
layoutWindow(true)
task.wait(0.1)
setOpen(true)
notify("<font color=\"" .. rgbStr(Theme.Accent) .. "\">" .. CONFIG.HubName .. "</font> loaded")
