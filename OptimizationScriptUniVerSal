local skyState = { active = "Off" }
local skyDome, skyRenderConn, skyFogBackup

local SKY_PRESETS = {
    Gray      = { color = Color3.fromRGB(150, 150, 150), fog = Color3.fromRGB(150, 150, 150) },
    Black     = { color = Color3.fromRGB(0, 0, 0),       fog = Color3.fromRGB(0, 0, 0) },
    -- Stylized recreation (not Mojang's actual textures) - flat Minecraft-like overworld blue
    Minecraft = { color = Color3.fromRGB(125, 180, 255), fog = Color3.fromRGB(190, 220, 255) },
}

local function clearSky()
    if skyRenderConn then skyRenderConn:Disconnect() skyRenderConn = nil end
    if skyDome then pcall(function() skyDome:Destroy() end) skyDome = nil end
    if skyFogBackup then
        pcall(function()
            Lighting.FogColor = skyFogBackup.FogColor
        end)
        skyFogBackup = nil
    end
end

local function applySky(name)
    clearSky()
    skyState.active = name
    local preset = SKY_PRESETS[name]
    if not preset then return end

    skyFogBackup = { FogColor = Lighting.FogColor }
    Lighting.FogColor = preset.fog

    local dome = new("Part", {
        Name = "FF_SkyDome", Shape = Enum.PartType.Ball, Anchored = true, CanCollide = false,
        CanQuery = false, CanTouch = false, CastShadow = false, Locked = true, Massless = true,
        Material = Enum.Material.SmoothPlastic, Color = preset.color,
    })
    new("SpecialMesh", { MeshType = Enum.MeshType.Sphere, Scale = Vector3.new(-1, -1, -1) * 4000 }, dome)
    dome.Parent = Workspace
    skyDome = dome

    skyRenderConn = connect(RunService.RenderStepped, function()
        local cam = Workspace.CurrentCamera
        if cam and skyDome then
            skyDome.CFrame = cam.CFrame
        end
    end)
end

