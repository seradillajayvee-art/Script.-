local ESP = {
    Enabled = false, Names = true, Distance = true, Health = true,
    Chams = true, TeamCheck = false, Color = Color3.fromRGB(255, 70, 70),
}
local espFolder = Instance.new("Folder")
espFolder.Name = "FF_ESP"
local okp = pcall(function() espFolder.Parent = CoreGui end)
if not okp or not espFolder.Parent then espFolder.Parent = parentGui end

local espObjects = {}

local function removeESP(plr)
    local o = espObjects[plr]
    if o then
        pcall(function() o.hl:Destroy() end)
        pcall(function() o.bb:Destroy() end)
        espObjects[plr] = nil
    end
end
local function clearESP()
    for plr in pairs(espObjects) do removeESP(plr) end
end

local function buildESP(plr, char)
    removeESP(plr)
    local head = char:FindFirstChild("Head") or char:FindFirstChildWhichIsA("BasePart")
    if not head then return end
    local hl = new("Highlight", {
        Adornee = char, FillColor = ESP.Color, OutlineColor = Color3.new(1, 1, 1),
        FillTransparency = 0.6, OutlineTransparency = 0,
        DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
    }, espFolder)
    local bb = new("BillboardGui", {
        Adornee = head, Size = UDim2.fromOffset(170, 44), StudsOffset = Vector3.new(0, 2.8, 0),
        AlwaysOnTop = true,
    }, espFolder)
    local label = lbl(bb, {
        Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center,
        Font = Enum.Font.GothamBold, TextSize = 13, TextColor3 = ESP.Color,
        TextStrokeTransparency = 0.4, RichText = false,
    })
    espObjects[plr] = { hl = hl, bb = bb, label = label, char = char }
end

task.spawn(function()
    local wasOn = false
    while running do
        if ESP.Enabled then
            wasOn = true
            local myChar = lp.Character
            local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= lp then
                    local char = plr.Character
                    local hum = char and char:FindFirstChildOfClass("Humanoid")
                    local skip = (not char) or (not hum) or hum.Health <= 0
                        or (ESP.TeamCheck and lp.Team ~= nil and plr.Team == lp.Team)
                    if skip then
                        removeESP(plr)
                    else
                        local o = espObjects[plr]
                        if (not o) or o.char ~= char then
                            buildESP(plr, char)
                            o = espObjects[plr]
                        end
                        if o then
                            o.hl.Enabled = ESP.Chams
                            o.hl.FillColor = ESP.Color
                            o.label.TextColor3 = ESP.Color
                            o.bb.Enabled = ESP.Names or ESP.Distance or ESP.Health
                            local lines = {}
                            if ESP.Names then table.insert(lines, plr.DisplayName) end
                            local second = {}
                            local root = char:FindFirstChild("HumanoidRootPart")
                            if ESP.Distance and myRoot and root then
                                table.insert(second, math.floor((myRoot.Position - root.Position).Magnitude) .. "m")
                            end
                            if ESP.Health then
                                table.insert(second, "HP " .. math.floor(hum.Health))
                            end
                            if #second > 0 then table.insert(lines, table.concat(second, " | ")) end
                            o.label.Text = table.concat(lines, "\n")
                        end
                    end
                end
            end
        elseif wasOn then
            wasOn = false
            clearESP()
        end
        task.wait(0.1)
    end
end)
connect(Players.PlayerRemoving, function(plr) removeESP(plr) end)

