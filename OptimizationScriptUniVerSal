local tabButtons, tabPages = {}, {}
local currentTab
local function selectTab(name, silent)
    currentTab = name
    for n, b in pairs(tabButtons) do
        local on = (n == name)
        tween(b, TI(0.2), {
            BackgroundColor3 = on and Theme.Accent or Theme.Item,
