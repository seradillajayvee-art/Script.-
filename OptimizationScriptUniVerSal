        Position = UDim2.fromOffset(12, desc and 7 or 0), Size = UDim2.new(1, -74, 0, desc and 18 or h),
        Text = text, Font = Enum.Font.GothamSemibold, TextSize = 14,
    })
    if desc then
        lbl(row, {
            Position = UDim2.fromOffset(12, 26), Size = UDim2.new(1, -74, 0, 24), Text = desc,
            TextColor3 = Theme.Sub, TextSize = 11, TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top,
        })
    end
    local track = new("Frame", {
        AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0),
        Size = UDim2.fromOffset(42, 22), BackgroundColor3 = Theme.Off,
    }, row)
    corner(track, FULL)
    local knob = new("Frame", {
        AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 3, 0.5, 0),
        Size = UDim2.fromOffset(16, 16), BackgroundColor3 = Color3.new(1, 1, 1),
    }, track)
    corner(knob, FULL)

    local state = false
    local obj = {}
    local function render(animate)
        local info = TI(animate and 0.18 or 0)
        tween(knob, info, { Position = state and UDim2.new(1, -19, 0.5, 0) or UDim2.new(0, 3, 0.5, 0) })
        tween(track, info, { BackgroundColor3 = state and Theme.Accent or Theme.Off })
    end
    function obj.Set(v, silent)
        state = v and true or false
        render(true)
        if not silent and cb then cb(state) end
    end
    function obj.Get() return state end
    onAccent(function() render(false) end)

    connect(row.MouseEnter, function() tween(row, TI(0.12), { BackgroundColor3 = Color3.fromRGB(40, 40, 55) }) end)
    connect(row.MouseLeave, function() tween(row, TI(0.12), { BackgroundColor3 = Theme.Item }) end)
    connect(row.MouseButton1Click, function()
        playSound("Toggle")
        obj.Set(not state)
    end)
    obj.Set(default, true)
    return obj
end

local function sliderRow(page, text, min, max, default, fmt, cb)
    local row = new("Frame", {
        Size = UDim2.new(1, 0, 0, 54), BackgroundColor3 = Theme.Item, LayoutOrder = ord(),
    }, page)
    corner(row, UDim.new(0, 8))
    lbl(row, {
        Position = UDim2.fromOffset(12, 6), Size = UDim2.new(0.6, 0, 0, 18), Text = text,
        Font = Enum.Font.GothamSemibold, TextSize = 13,
    })
    local valLbl = lbl(row, {
        Position = UDim2.new(0.6, 0, 0, 6), Size = UDim2.new(0.4, -12, 0, 18),
        TextXAlignment = Enum.TextXAlignment.Right, TextColor3 = Theme.Sub, TextSize = 12,
    })
    local track = new("Frame", {
        Position = UDim2.new(0, 12, 0, 36), Size = UDim2.new(1, -24, 0, 6), BackgroundColor3 = Theme.Off,
    }, row)
    corner(track, FULL)
    local fill = new("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = Theme.Accent }, track)
    corner(fill, FULL)
    local knob = new("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0, 0.5),
        Size = UDim2.fromOffset(16, 16), BackgroundColor3 = Color3.new(1, 1, 1),
    }, track)
    corner(knob, FULL)
    onAccent(function() fill.BackgroundColor3 = Theme.Accent end)

    local function setAlpha(a)
        a = math.clamp(a, 0, 1)
        fill.Size = UDim2.fromScale(a, 1)
        knob.Position = UDim2.fromScale(a, 0.5)
        local value = min + (max - min) * a
        valLbl.Text = fmt and fmt(value) or tostring(math.floor(value * 100) / 100)
        return value
    end
    setAlpha((default - min) / (max - min))

    local hit = new("TextButton", {
        Position = UDim2.fromOffset(0, 24), Size = UDim2.new(1, 0, 0, 30),
        BackgroundTransparency = 1, Text = "", AutoButtonColor = false,
    }, row)
    local dragging = false
    local function fromX(x)
        local a = (x - track.AbsolutePosition.X) / math.max(1, track.AbsoluteSize.X)
        local v = setAlpha(a)
        if cb then cb(v) end
    end
    connect(hit.InputBegan, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            page.ScrollingEnabled = false
            fromX(input.Position.X)
        end
    end)
    connect(UIS.InputChanged, function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            fromX(input.Position.X)
        end
    end)
    connect(UIS.InputEnded, function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch) then
            dragging = false
            page.ScrollingEnabled = true
        end
    end)
end

