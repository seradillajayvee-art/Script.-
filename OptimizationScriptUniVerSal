--[[
    Anti Lag / Fast Mode / Super Fast Mode
    Universal LocalScript - Delta Executor compatible
    Toggles are cumulative:
      Anti Lag   = remove effects/particles/shadows
      Fast Mode  = Anti Lag + smooth materials, no part shadows
      Super Fast = Fast + hide decals/textures, low quality, no water/fog stuff
    Turning a toggle OFF restores original values.
]]

local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local UIS = game:GetService("UserInputService")
local CoreGui = game:GetService("CoreGui")
local Workspace = game:GetService("Workspace")

local lp = Players.LocalPlayer

-- Prevent duplicate GUI
local GUI_NAME = "AntiLagDeltaUI"
local function getParent()
    local ok, p = pcall(function()
        return (gethui and gethui()) or CoreGui
    end)
    if ok and p then return p end
    return lp:WaitForChild("PlayerGui")
end
local parentGui = getParent()
local old = parentGui:FindFirstChild(GUI_NAME)
if old then old:Destroy() end

----------------------------------------------------------------
-- STATE + BACKUP
----------------------------------------------------------------
local state = { anti = false, fast = false, super = false }
local backup = setmetatable({}, { __mode = "k" })
local generation = 0
local conn

local function setProp(inst, prop, value)
    local ok, cur = pcall(function() return inst[prop] end)
    if not ok then return end
    backup[inst] = backup[inst] or {}
    if backup[inst][prop] == nil then
        backup[inst][prop] = cur
    end
    pcall(function() inst[prop] = value end)
end

local function restoreAll()
    for inst, props in pairs(backup) do
        for prop, value in pairs(props) do
            pcall(function() inst[prop] = value end)
        end
    end
    table.clear(backup)
end

local function flags()
    return {
        anti = state.anti or state.fast or state.super,
        fast = state.fast or state.super,
        super = state.super,
    }
end

local function isOwnCharacter(inst)
    local char = lp.Character
    return char and inst:IsDescendantOf(char)
end

----------------------------------------------------------------
-- APPLY TO A SINGLE INSTANCE
----------------------------------------------------------------
local function applyInstance(inst, f)
    if f.anti then
        if inst:IsA("ParticleEmitter") or inst:IsA("Trail") or inst:IsA("Beam")
            or inst:IsA("Smoke") or inst:IsA("Fire") or inst:IsA("Sparkles") then
            setProp(inst, "Enabled", false)
        elseif inst:IsA("BlurEffect") or inst:IsA("SunRaysEffect")
            or inst:IsA("ColorCorrectionEffect") or inst:IsA("BloomEffect")
            or inst:IsA("DepthOfFieldEffect") then
            setProp(inst, "Enabled", false)
        elseif inst:IsA("Explosion") then
            setProp(inst, "Visible", false)
        end
    end

    if f.fast and inst:IsA("BasePart") then
        setProp(inst, "CastShadow", false)
        if not isOwnCharacter(inst) then
            setProp(inst, "Material", Enum.Material.SmoothPlastic)
            setProp(inst, "Reflectance", 0)
        end
        if inst:IsA("MeshPart") then
            setProp(inst, "RenderFidelity", Enum.RenderFidelity.Performance)
        end
    end

    if f.super then
        if (inst:IsA("Decal") or inst:IsA("Texture")) and not isOwnCharacter(inst) then
            setProp(inst, "Transparency", 1)
        elseif inst:IsA("Atmosphere") then
            setProp(inst, "Density", 0)
            setProp(inst, "Haze", 0)
            setProp(inst, "Glare", 0)
        elseif inst:IsA("Clouds") then
            setProp(inst, "Enabled", false)
        end
    end
end

----------------------------------------------------------------
-- APPLY GLOBAL SETTINGS
----------------------------------------------------------------
local function applyGlobal(f)
    if f.anti then
        setProp(Lighting, "GlobalShadows", false)
        setProp(Lighting, "ShadowSoftness", 0)
    end
    if f.fast then
        setProp(Lighting, "EnvironmentDiffuseScale", 0)
        setProp(Lighting, "EnvironmentSpecularScale", 0)
        pcall(function()
            local t = Workspace.Terrain
            setProp(t, "WaterWaveSize", 0)
            setProp(t, "WaterWaveSpeed", 0)
            setProp(t, "WaterReflectance", 0)
            setProp(t, "WaterTransparency", 1)
        end)
    end
    if f.super then
        pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Level01 end)
        pcall(function() Workspace.Terrain.Decoration = false end)
        if setfpscap then pcall(setfpscap, 999) end
    end
end

----------------------------------------------------------------
-- REFRESH (restore -> reapply based on toggles)
----------------------------------------------------------------
local function refresh()
    generation += 1
    local myGen = generation

    if conn then conn:Disconnect() conn = nil end
    restoreAll()

    local f = flags()
    if not (f.anti or f.fast or f.super) then return end

    applyGlobal(f)

    -- new objects that spawn later
    conn = game.DescendantAdded:Connect(function(inst)
        task.defer(function()
            applyInstance(inst, flags())
        end)
    end)

    -- existing objects (batched so it won't freeze)
    task.spawn(function()
        local count = 0
        local function scan(root)
            for _, inst in ipairs(root:GetDescendants()) do
                if generation ~= myGen then return end
                applyInstance(inst, f)
                count += 1
                if count % 250 == 0 then task.wait() end
            end
        end
        scan(Workspace)
        scan(Lighting)
    end)
end

