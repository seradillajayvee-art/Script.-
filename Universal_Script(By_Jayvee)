	b.MouseButton1Click:Connect(function() onClick(b) end)
	if not danger then addRefresh(function() b.BackgroundColor3 = accent() end) end
end

local function adjust(key, step, mn, mx)
	return function(dir) Settings[key] = round2(math.clamp(Settings[key] + step * dir, mn, mx)) end
end

