	bind(RunService.Heartbeat, function(dt)
		if humanoid and humanoid.MoveDirection.Magnitude > 0.12 and following then
			following = false
			followToken += 1
		end
		updateRing()

		redAcc += dt
		if redAcc >= 0.1 then
			redAcc = 0
			pcall(updateRed)
		end

		local ok, err = pcall(senseStep)
		if not ok then warn("[JAYVEE] Sense error:", err) end

		espAcc += dt
		if espAcc >= 0.15 then
			espAcc = 0
			local ok2, err2 = pcall(updateESP)
			if not ok2 then warn("[JAYVEE] ESP error:", err2) end
		end

		statAcc += dt
		if statAcc >= 0.4 then
			statAcc = 0
			if main.Visible then refresh() end
		end
	end)
end

