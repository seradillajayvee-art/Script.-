--==================== DODGE ====================
local ACT = {Low = {0.22, 0.12}, Normal = {0.16, 0.08}, High = {0.12, 0.04}, Max = {0.08, 0.02}}

local function dodgeDestination(targetRoot, threat)
	local origin = root.Position
	local ignore = {character, ring}
	if targetRoot and targetRoot.Parent then ignore[#ignore + 1] = targetRoot.Parent end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = ignore
	params.RespectCanCollide = true

	local function clip(dest)
		dest = Vector3.new(dest.X, origin.Y, dest.Z)
		local dir = dest - origin
		if dir.Magnitude > 0.1 then
			local hit = workspace:Raycast(origin, dir, params)
			if hit then
				local back = hit.Position - dir.Unit * 2
				if (back - origin):Dot(dir) < 0 then return origin end
				return Vector3.new(back.X, origin.Y, back.Z)
			end
		end
		return dest
	end

	if threat then
		local d = Vector3.new(threat.dir.X, 0, threat.dir.Z)
		if d.Magnitude <= 0.05 then d = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z) end
		if d.Magnitude <= 0.05 then d = Vector3.new(0, 0, -1) end
		d = d.Unit
		local dist = threat.dist or 8
		if threat.away then return clip(origin + d * dist) end
		local perp = Vector3.new(-d.Z, 0, d.X)
		local a, b = clip(origin + perp * dist), clip(origin - perp * dist)
		local la, lb = (a - origin).Magnitude, (b - origin).Magnitude
		if la >= dist - 0.2 and lb >= dist - 0.2 then return (math.random(1, 2) == 1) and a or b end
		return (la >= lb) and a or b
	end

	local dest
	if targetRoot then
		local tp = targetRoot.Position
		local look = Vector3.new(targetRoot.CFrame.LookVector.X, 0, targetRoot.CFrame.LookVector.Z)
		look = look.Magnitude > 0.05 and look.Unit or Vector3.new(0, 0, -1)
		local right = Vector3.new(-look.Z, 0, look.X)
		local dist = math.max(Settings.FollowDistance, 3.5)
		if Settings.DodgeAnimation == "Backstep" then
			local away = Vector3.new(origin.X - tp.X, 0, origin.Z - tp.Z)
			away = away.Magnitude > 0.05 and away.Unit or -look
			dest = origin + away * 8
		elseif Settings.DodgeAnimation == "Blink" then
			dest = tp - look * dist
		else
			local side = ((origin - tp):Dot(right) >= 0) and -1 or 1
			dest = tp + right * side * dist - look * (dist * 0.4)
		end
	else
		local side = math.random(1, 2) == 1 and 1 or -1
		dest = origin + root.CFrame.RightVector * side * 8
	end
	return clip(dest)
end

local function runDodge(target, threat)
	if dodging then return end
	if not Settings.Enabled or not Settings.AutoDodge or not Settings.UltraActive then return end
	if not humanoid or humanoid.Health <= 0 or not root or not root.Parent then return end
	if math.random(1, 100) > Settings.DodgeChance then return end

	dodging = true
	followToken += 1
	following = false

	if not (target and validEnemy(target)) then
		local _, n = enemiesInRadius()
		target = n
	end
	local tr = target and getRoot(target)

	pcall(function() dodgeSounds[math.random(1, #dodgeSounds)]:Play() end)
	flashFX()
	Settings.DodgeCount += 1
	showPopup()
	if tr then lockCamera(target, 1.2) end

	local act = ACT[Settings.DodgeSpeed] or ACT.High
	local startPos = root.Position
	local dest = dodgeDestination(tr, threat)
	local startCF = root.CFrame
	local endCF
	if tr then
		local face = Vector3.new(tr.Position.X, dest.Y, tr.Position.Z)
		if (face - dest).Magnitude > 0.1 then endCF = CFrame.lookAt(dest, face) end
	end
	endCF = endCF or (CFrame.new(dest) * startCF.Rotation)

	afterimage(0.45)
	local ghosts, start = 0, os.clock()
	while true do
		local a = math.clamp((os.clock() - start) / act[1], 0, 1)
		local e = 1 - (1 - a) ^ 3
		if root and root.Parent then
			root.CFrame = startCF:Lerp(endCF, e)
			root.AssemblyLinearVelocity = Vector3.zero
		end
		if ghosts < 2 and a >= (ghosts + 1) / 3 then
			ghosts += 1
			afterimage(0.35)
		end
		if a >= 1 then break end
		RunService.RenderStepped:Wait()
	end
	if target then startFollow(target) end
	task.delay(act[2], function() dodging = false end)
end

local function dodge(target, threat)
	local ok, err = pcall(runDodge, target, threat)
	if not ok then
		warn("[JAYVEE] Dodge error:", err)
		dodging = false
	end
end

--==================== SENSE: melee / contact / animation ====================
local ATTACK_WORDS = {"attack", "punch", "kick", "swing", "slash", "strike", "stab", "bite", "claw", "smash",
	"combo", "melee", "skill", "slam", "shoot", "fire", "cast", "beam", "blast", "ultimate", "ability",
	"spell", "throw", "charge", "special", "m1", "m2"}
local MOVE_WORDS = {"idle", "walk", "run", "jump", "fall", "climb", "swim", "sit", "emote", "dance", "wave", "point", "cheer", "laugh"}
local function hasWord(str, list)
	for _, w in ipairs(list) do
		if str:find(w, 1, true) then return true end
	end
	return false
end

local function attackAnim(model)
	local hum = getHum(model)
	if not hum then return false end
	local animator = hum:FindFirstChildOfClass("Animator") or model:FindFirstChildWhichIsA("Animator", true)
	if not animator then return false end
	local ok, tracks = pcall(function() return animator:GetPlayingAnimationTracks() end)
	if not ok or not tracks then return false end
	for _, t in ipairs(tracks) do
		local n = string.lower(t.Name .. " " .. (t.Animation and t.Animation.Name or ""))
		local isMove = hasWord(n, MOVE_WORDS)
		if hasWord(n, ATTACK_WORDS) then return true end
		if not t.Looped and t.Priority.Value >= Enum.AnimationPriority.Action.Value and not isMove then return true end
	end
	return false
end

local function closingAttack(model)
	local tr = getRoot(model)
	if not tr or not root then return false end
	local toMe = root.Position - tr.Position
	local dist = toMe.Magnitude
	if dist < 0.1 then return true end
	local closing = tr.AssemblyLinearVelocity:Dot(toMe.Unit)
	if closing > 8 then return true end
	if dist <= Settings.ContactDistance + 3 and tr.CFrame.LookVector:Dot(toMe.Unit) > 0.6 and closing > 3 then return true end
	return false
end

--==================== SENSE: projectiles / hitboxes / explosions ====================
local overlap = OverlapParams.new()
overlap.FilterType = Enum.RaycastFilterType.Exclude
overlap.MaxParts = 800
local nextScan, nextRanged = 0, 0

local function ignorePart(p)
	local c = ignoreCache[p]
	if c ~= nil then return c end
	local r = false
	if p:GetAttribute("JV_FX") or p:IsA("Terrain") or p:FindFirstAncestor("UI_Afterimage") then
		r = true
	else
		local par = p.Parent
		if par and ((par:IsA("Model") and getHum(par)) or par:IsA("Accoutrement")) then r = true end
	end
	ignoreCache[p] = r
	return r
end

local function onExplosion(ex)
	if not Settings.DodgeExplosions or not Settings.UltraActive or not root or not ex.Parent then return end
	local away = root.Position - ex.Position
	local d = away.Magnitude
	if d <= ex.BlastRadius + 6 then
		if d < 0.1 then away = root.CFrame.RightVector end
		pendingThreat = {
			away = true, dir = Vector3.new(away.X, 0, away.Z),
			dist = math.clamp(ex.BlastRadius - d + 7, 7, 45), time = os.clock(),
		}
	end
end

bind(workspace.DescendantAdded, function(d)
	if d:IsA("BasePart") then
		bornAt[d] = os.clock()
	elseif d:IsA("Explosion") then
		task.defer(onExplosion, d)
	elseif d:IsA("Humanoid") then
