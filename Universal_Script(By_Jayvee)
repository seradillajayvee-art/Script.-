			math.cos(angle) * Settings.Radius, -2.65, math.sin(angle) * Settings.Radius)
		p.Size = Vector3.new(0.18, 0.05, len)
		p.CFrame = CFrame.new(pos) * CFrame.Angles(0, -angle, 0)
		p.Color = col
		p.Transparency = 0.15
