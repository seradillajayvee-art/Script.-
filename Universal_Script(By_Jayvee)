local walkTrack, walkConn
local function setupWalk(char)
	if walkConn then walkConn:Disconnect(); walkConn = nil end
	if walkTrack then pcall(function() walkTrack:Stop(0); walkTrack:Destroy() end); walkTrack = nil end
	local hum = char:WaitForChild("Humanoid", 8)
	if not hum then return end
	local animator = hum:FindFirstChildOfClass("Animator") or new("Animator", nil, hum)
	local anim = Instance.new("Animation")
	anim.AnimationId = "rbxassetid://117414822036545"
	local ok, t = pcall(function() return animator:LoadAnimation(anim) end)
	if not ok or not t then return end
	t.Priority = Enum.AnimationPriority.Movement
	t.Looped = true
	walkTrack = t
	walkConn = RunService.RenderStepped:Connect(function()
		if not hum.Parent or not walkTrack then return end
		if not Settings.CustomMovement then
			if walkTrack.IsPlaying then walkTrack:Stop(0.16) end
			return
		end
		local st = hum:GetState()
		local air = st == Enum.HumanoidStateType.Jumping or st == Enum.HumanoidStateType.Freefall
			or st == Enum.HumanoidStateType.Climbing or st == Enum.HumanoidStateType.Swimming
			or st == Enum.HumanoidStateType.Seated or st == Enum.HumanoidStateType.Dead
		local moving = hum.MoveDirection.Magnitude * hum.WalkSpeed > 0.05
		if moving and not air then
			if not walkTrack.IsPlaying then walkTrack:Play(0.16, 1, 1) end
		elseif walkTrack.IsPlaying then
			walkTrack:Stop(0.16)
		end
	end)
end

