	Settings.UltraActive = false
	following = false
	followToken += 1
	for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
	conns = {}
	if damageConn then damageConn:Disconnect(); damageConn = nil end
	if walkConn then walkConn:Disconnect(); walkConn = nil end
	if walkTrack then pcall(function() walkTrack:Stop(0) end) end
	pcall(function() RunService:UnbindFromRenderStep("JV_Cam") end)
	if humanoid then pcall(function() humanoid.AutoRotate = true end) end
	clearAura()
	for m, h in pairs(redMarks) do h:Destroy(); redMarks[m] = nil end
	for m in pairs(espEntries) do espDestroy(m) end
	for _, s in ipairs(dodgeSounds) do s:Destroy() end
	espFolder:Destroy()
	ring:Destroy()
	gui:Destroy()
	if shared.JV_Destroy == unloadFn then shared.JV_Destroy = nil end
end
