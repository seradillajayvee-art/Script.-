local function startFollow(target)
	if not Settings.FollowAfterDodge or not target then return end
	local targetRoot, targetHum = getRoot(target), getHum(target)
	if not targetRoot or not targetHum then return end

	following = true
	followTarget = target
	followToken += 1
	local token = followToken

	task.spawn(function()
		local start = os.clock()
		while following and token == followToken
			and os.clock() - start < Settings.FollowDuration do
			if not root or not root.Parent then break end
			if not targetRoot.Parent or targetHum.Health <= 0 then break end

			local offset
			if Settings.FollowMode == "Side" then
				offset = targetRoot.CFrame.RightVector * Settings.FollowDistance
			else
				offset = -targetRoot.CFrame.LookVector * Settings.FollowDistance
			end
			local desired = targetRoot.Position + offset
			local flat = Vector3.new(desired.X, root.Position.Y, desired.Z)
			root.CFrame = root.CFrame:Lerp(
				CFrame.lookAt(flat, Vector3.new(targetRoot.Position.X, flat.Y, targetRoot.Position.Z)),
				Settings.FollowSpeed)
			task.wait()
		end
		if token == followToken then
			following = false
			followTarget = nil
			if Settings.StopEffect then stopEffect() end
		end
	end)
end

--==================================================
-- DODGE CORE
--==================================================
local ACTIVITY = {
	Low = {dur = 0.22, lock = 0.12},
	Normal = {dur = 0.16, lock = 0.08},
	High = {dur = 0.12, lock = 0.04},
	Max = {dur = 0.08, lock = 0.02},
}

local function dodgeDestination(targetRoot)
	local origin = root.Position
	local dest
	if targetRoot then
		local tp = targetRoot.Position
		local look = Vector3.new(targetRoot.CFrame.LookVector.X, 0, targetRoot.CFrame.LookVector.Z)
		look = look.Magnitude > 0.05 and look.Unit or Vector3.new(0, 0, -1)
		local right = Vector3.new(-look.Z, 0, look.X)
		local dist = math.max(Settings.FollowDistance, 3.5)
		local mode = Settings.DodgeAnimation
		if mode == "Backstep" then
			local away = Vector3.new(origin.X - tp.X, 0, origin.Z - tp.Z)
			away = away.Magnitude > 0.05 and away.Unit or -look
			dest = origin + away * 8
		elseif mode == "Blink" then
			dest = tp - look * dist
		else
			local side = ((origin - tp):Dot(right) >= 0) and -1 or 1
			dest = tp + right * side * dist - look * (dist * 0.4)
		end
	else
		local side = math.random(1, 2) == 1 and 1 or -1
		dest = origin + root.CFrame.RightVector * side * 8
	end
	dest = Vector3.new(dest.X, origin.Y, dest.Z)

	local ignore = {character}
	if targetRoot and targetRoot.Parent then table.insert(ignore, targetRoot.Parent) end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = ignore
	local dir = dest - origin
	if dir.Magnitude > 0.1 then
		local hit = workspace:Raycast(origin, dir, params)
		if hit then dest = hit.Position - dir.Unit * 2 end
	end
	return dest
end

-- Where to dash when the threat is NOT a humanoid (projectile / explosion / hitbox / unknown)
local function threatDestination(threat)
	local origin = root.Position
	local dest
	if threat.kind == "explosion" and threat.pos then
		local away = Vector3.new(origin.X - threat.pos.X, 0, origin.Z - threat.pos.Z)
		away = away.Magnitude > 0.05 and away.Unit or -root.CFrame.LookVector
		dest = origin + away * 14
	elseif threat.kind == "projectile" and threat.dir then
		-- sidestep perpendicular to the projectile's path, away from its line
		local d = Vector3.new(threat.dir.X, 0, threat.dir.Z)
		if d.Magnitude < 0.05 then
			dest = origin + root.CFrame.RightVector * (math.random(1, 2) == 1 and 9 or -9)
		else
			d = d.Unit
			local perp = Vector3.new(-d.Z, 0, d.X)
			local side = ((origin - (threat.closest or origin)):Dot(perp) >= 0) and 1 or -1
			dest = origin + perp * side * 9
		end
	elseif threat.pos then
		local away = Vector3.new(origin.X - threat.pos.X, 0, origin.Z - threat.pos.Z)
		away = away.Magnitude > 0.05 and away.Unit or root.CFrame.RightVector
		dest = origin + away * 9
	else
		dest = origin + root.CFrame.RightVector * (math.random(1, 2) == 1 and 9 or -9)
	end
	dest = Vector3.new(dest.X, origin.Y, dest.Z)

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = {character, fxFolder}
	local dir = dest - origin
	if dir.Magnitude > 0.1 then
		local hit = workspace:Raycast(origin, dir, params)
		if hit then dest = hit.Position - dir.Unit * 2 end
	end
	return dest
end

local function runDodge(target, threat)
	if dodging then return end
	if not Settings.Enabled or not Settings.AutoDodge or not Settings.UltraActive then return end
	if not humanoid or humanoid.Health <= 0 or not root or not root.Parent then return end
	if math.random(1, 100) > Settings.DodgeChance then return end

	dodging = true
	followToken += 1
	following = false

	target = (target and isValidTarget(target)) and target or getEnemyInsideRadius()
	local targetRoot = target and getRoot(target)

	playRandomDodgeSound()
	flash()
	Settings.DodgeCount += 1
	refreshStats()
	showDodgeIndicator()
	if targetRoot then lockCameraToTarget(target) end

	local act = ACTIVITY[Settings.DodgeActivity] or ACTIVITY.High
	local startPos = root.Position
	local destination = (threat and threatDestination(threat)) or dodgeDestination(targetRoot)
	local startCF = root.CFrame
	local endCF
	if targetRoot then
		local faceFlat = Vector3.new(targetRoot.Position.X, destination.Y, targetRoot.Position.Z)
		if (faceFlat - destination).Magnitude > 0.1 then
			endCF = CFrame.lookAt(destination, faceFlat)
		end
	end
	endCF = endCF or (CFrame.new(destination) * startCF.Rotation)

	createAfterimage(0.45)
	smokePuff(startPos)

	local ghosts = 0
	local start = os.clock()
	while true do
		local a = math.clamp((os.clock() - start) / act.dur, 0, 1)
		local e = 1 - (1 - a) ^ 3
		if root and root.Parent then
			root.CFrame = startCF:Lerp(endCF, e)
			root.AssemblyLinearVelocity = Vector3.zero
		end
		if ghosts < 2 and a >= (ghosts + 1) / 3 then
			ghosts += 1
			createAfterimage(0.35)
		end
		if a >= 1 then break end
		RunService.RenderStepped:Wait()
	end

	createTrail(startPos + Vector3.new(0, 1, 0), destination + Vector3.new(0, 1, 0))
	smokePuff(destination)

	if target then startFollow(target) end

	task.delay(act.lock, function() dodging = false end)
end

local function dodge(target, threat)
	local ok, err = pcall(runDodge, target, threat)
	if not ok then
		warn("[JAYVEE] Dodge error:", err)
		dodging = false
	end
end

--==================================================
-- ULTRA INSTINCT SENSE (attack / damage / contact)
--==================================================
local trackedTargetHealth = setmetatable({}, {__mode = "k"})
local trackedTargetStamp = setmetatable({}, {__mode = "k"})

local function detectEnemyHit(target)
	local hum = getHum(target)
	if not hum then return false end
	local old = trackedTargetHealth[target]
	trackedTargetHealth[target] = hum.Health
	if old and hum.Health < old then
		if os.clock() - (trackedTargetStamp[target] or 0) > 0.12 then
			trackedTargetStamp[target] = os.clock()
			return true
		end
	end
	return false
end

local function detectAnyEnemyHit(nearby)
	local found
	for _, m in ipairs(nearby) do
		if detectEnemyHit(m) and not found then found = m end
	end
	return found
end

local ATTACK_WORDS = {"attack", "punch", "kick", "swing", "slash", "hit", "strike", "stab", "bite", "claw", "smash", "combo", "melee", "skill", "slam", "shoot", "fire"}
local MOVE_WORDS = {"idle", "walk", "run", "jump", "fall", "climb", "swim", "sit", "emote", "dance", "wave", "point", "cheer", "laugh"}

local function hasWord(str, list)
	for _, w in ipairs(list) do
		if str:find(w, 1, true) then return true end
	end
	return false
end

local function enemyLooksLikeAttacking(model)
	local hum = getHum(model)
	if not hum then return false end

	local animator = hum:FindFirstChildOfClass("Animator") or model:FindFirstChildWhichIsA("Animator", true)
	local ok, tracks = pcall(function()
		if animator then return animator:GetPlayingAnimationTracks() end
		return {}
	end)
	if ok and tracks then
		for _, track in ipairs(tracks) do
			local a = track.Animation
			local n = string.lower(track.Name .. " " .. (a and a.Name or ""))
			if hasWord(n, ATTACK_WORDS) then return true end
			if not track.Looped and track.Priority.Value >= Enum.AnimationPriority.Action.Value
				and not hasWord(n, MOVE_WORDS) then
				return true
			end
		end
	end

	local tr = getRoot(model)
	if tr and root then
		local toPlayer = root.Position - tr.Position
		local dist = toPlayer.Magnitude
		if dist > 0.1 then
			local closing = tr.AssemblyLinearVelocity:Dot(toPlayer.Unit)
			if closing > 8 then return true end
			if dist <= Settings.ContactTriggerDistance + 3 then
				local facing = tr.CFrame.LookVector:Dot(toPlayer.Unit)
				if facing > 0.6 and closing > 3 then return true end
			end
		end
	end
	return false
end

--==================================================
-- THREAT SCANNER: dodge EVERYTHING
-- projectiles / skills / beams, area hitboxes, explosions
--==================================================
local THREAT_WORDS = {
	"hitbox", "hurtbox", "damage", "projectile", "bullet", "fireball", "beam", "blast", "laser",
	"missile", "rocket", "explosion", "shockwave", "slash", "kunai", "shuriken", "arrow", "bomb",
	"kamehameha", "hadoken", "cero", "rasengan", "chidori", "spear", "knife", "skill", "attack", "aoe",
}
local overlap = OverlapParams.new()
overlap.FilterType = Enum.RaycastFilterType.Exclude
overlap.MaxParts = 250

local partTrack = setmetatable({}, {__mode = "k"})
local spawnTime = setmetatable({}, {__mode = "k"})
local nameCache = setmetatable({}, {__mode = "k"})
local effectCache = setmetatable({}, {__mode = "k"})
local lastScan = 0
local pendingThreat = nil

local function nameTag(part)
	local c = nameCache[part]
	if c ~= nil then return c end
	local r = false
	local n = string.lower(part.Name)
	local pn = part.Parent and string.lower(part.Parent.Name) or ""
	if hasWord(n, THREAT_WORDS) or hasWord(pn, THREAT_WORDS) then
		r = true
	elseif part:GetAttribute("Damage") ~= nil or part:FindFirstChild("Damage") or part:FindFirstChild("damage") then
		r = true
	end
	nameCache[part] = r
	return r
end

local function threatLike(part)
	if nameTag(part) then return true end
	local c = effectCache[part]
	if c ~= nil then return c end
	local r = part:FindFirstChildWhichIsA("Trail") ~= nil
		or part:FindFirstChildWhichIsA("ParticleEmitter") ~= nil
		or part:FindFirstChildWhichIsA("Fire") ~= nil
		or part:FindFirstChildWhichIsA("Beam") ~= nil
		or (part.Material == Enum.Material.Neon and part.Size.Magnitude < 25)
	effectCache[part] = r
	return r
end

-- limbs of players/NPCs are handled by the humanoid logic above
local function isHumanoidLimb(part)
	local model = part.Parent
	if not model or not model:IsA("Model") then return false end
	if not model:FindFirstChildOfClass("Humanoid") then return false end
	return not nameTag(part)
end

bind(workspace.DescendantAdded, function(d)
	if d:IsA("BasePart") then
		spawnTime[d] = os.clock()
	elseif d:IsA("Explosion") then
		task.defer(function()
			if not Settings.DodgeExplosions or not root or not root.Parent then return end
			local ok, pos, radius = pcall(function() return d.Position, d.BlastRadius end)
			if not ok or not pos then return end
			if (pos - root.Position).Magnitude <= (radius or 4) + 6 then
				pendingThreat = {kind = "explosion", pos = pos, t = os.clock()}
			end
		end)
	end
end)

local function scanThreats(now)
	if not Settings.DodgeProjectiles and not Settings.DodgeHitboxes then return nil end
	if now - lastScan < 0.04 then return nil end
	lastScan = now
	overlap.FilterDescendantsInstances = {character, ringFolder, fxFolder}
	local rp = root.Position

	local best, bestT = nil, math.huge
	if Settings.DodgeProjectiles then
		local range = math.max(Settings.Radius * 1.5, 20)
		local ok, parts = pcall(workspace.GetPartBoundsInRadius, workspace, rp, range, overlap)
		if ok and parts then
			for _, part in ipairs(parts) do
				if not isHumanoidLimb(part) then
					local pos = part.Position
					local vel = Vector3.zero
					local tr = partTrack[part]
					if part.Anchored then
						if tr then
							local dt = now - tr.t
							if dt > 0.02 and dt < 0.5 then vel = (pos - tr.pos) / dt end
						end
					else
						vel = part.AssemblyLinearVelocity
					end
					if tr then tr.pos, tr.t = pos, now else partTrack[part] = {pos = pos, t = now} end

					local speed = vel.Magnitude
					if speed >= Settings.ProjectileMinSpeed
						and (part.Size.Magnitude < 60 or threatLike(part)) then
						local rel = pos - rp
						local tca = -rel:Dot(vel) / (speed * speed) -- time of closest approach
						if tca > 0 and tca < 0.5 and tca < bestT then
							local closest = pos + vel * tca
							local reach = 4 + part.Size.Magnitude * 0.35
							if (closest - rp).Magnitude <= reach then
								best = {kind = "projectile", pos = pos, dir = vel.Unit, closest = closest}
								bestT = tca
							end
						end
					end
				end
			end
		end
	end
	if best then return best end

	if Settings.DodgeHitboxes then
		local ok, touching = pcall(workspace.GetPartBoundsInBox, workspace, root.CFrame, Vector3.new(6, 7, 6), overlap)
		if ok and touching then
			for _, part in ipairs(touching) do
				if not part.CanCollide and part.CanTouch and not isHumanoidLimb(part) then
					local born = spawnTime[part]
					local fresh = born and (now - born) < 2.5
					if fresh or nameTag(part) then
						return {kind = "hitbox", pos = part.Position}
					end
				end
			end
		end
	end
	return nil
end

local function senseStep()
	if not Settings.Enabled or not Settings.AutoDodge or not Settings.UltraActive then return end
	if dodging or not root or not root.Parent then return end
	if not humanoid or humanoid.Health <= 0 then return end
	local now = os.clock()
	if now < senseCooldown then return end

	local nearby = getAllNearbyTargets()
	local hitTarget = (#nearby > 0) and detectAnyEnemyHit(nearby) or nil
	local contact, attack, attacker = false, false, nil
	for _, model in ipairs(nearby) do
		local tr = getRoot(model)
		if tr then
			local d = (tr.Position - root.Position).Magnitude
			-- contact is ignored while following (follow keeps you close on purpose)
			if d <= Settings.ContactTriggerDistance and not following then
				contact = true
				attacker = attacker or model
			end
			if enemyLooksLikeAttacking(model) then
				attack = true
				attacker = model
			end
		end
	end

	-- non-humanoid threats: explosions, projectiles / skills, hitboxes
	local threat
	if pendingThreat then
		if now - pendingThreat.t < 0.4 then threat = pendingThreat end
		pendingThreat = nil
	end
	threat = threat or scanThreats(now)

	if not (hitTarget or contact or attack or threat) then return end

	local chosen = hitTarget or attacker or getEnemyInsideRadius() or nearby[1]
	local w = Settings.PerfectDodgeWindow
	local mult = attack and 0.5 or contact and 0.75 or 1.2
	if threat then mult = math.min(mult, 0.45) end
	senseCooldown = now + w * mult
	if chosen then lockCameraToTarget(chosen) end
	dodge(chosen, threat)
end

