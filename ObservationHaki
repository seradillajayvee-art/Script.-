-- fast start, smooth stop; total distance = distance
local function slide(root, humanoid, worldDir, distance, duration, onStep)
    local speed = distance / duration
    local startTime = os.clock()

    local conn
    conn = RunService.Heartbeat:Connect(function()
        local t = os.clock() - startTime
        if t >= duration or humanoid.Health <= 0 or not root.Parent then
            conn:Disconnect()
            return
        end

        local u = t / duration
        local mult = 6 * u * (1 - u) -- smooth bell curve, total distance stays the same
        local v = root.AssemblyLinearVelocity
        root.AssemblyLinearVelocity = Vector3.new(worldDir.X * speed * mult, v.Y, worldDir.Z * speed * mult)

        if onStep then
            onStep(t)
        end
    end)
end

---------------------------------------------------------------------
-- BODY POSES (no animation, just bends the joints)
-- Pitch: degrees around the body's X axis.
--   + = top tips BACK (and the bottom swings FORWARD: knees up, arms forward)
--   - = top tips FORWARD (bow / fold)
---------------------------------------------------------------------

-- Axes are in CHARACTER space: X = right, Y = up, Z = back (forward is -Z)
local X_AXIS = Vector3.new(1, 0, 0)
local Y_AXIS = Vector3.new(0, 1, 0)
local Z_AXIS = Vector3.new(0, 0, 1)
local NO_OFFSET = Vector3.new(0, 0, 0)

local function getRootPart(character)
    local hum = character:FindFirstChildOfClass("Humanoid")
    return character:FindFirstChild("HumanoidRootPart") or (hum and hum.RootPart) or character.PrimaryPart
end

-- body joints only (not hat / tool welds)
local function isBodyJoint(j)
    if not j.Part0 or not j.Part1 then return false end
    for _, part in ipairs({j.Part0, j.Part1}) do
        if part:FindFirstAncestorOfClass("Accessory") or part:FindFirstAncestorOfClass("Tool") then
            return false
        end
    end
    return true
end

local function sideOf(joint, root)
    local n = string.lower(joint.Part1.Name .. joint.Name)
    if n:find("left") then return "L" end
    if n:find("right") then return "R" end
    -- unknown names: use which side of the body the part sits on
    local rel = root.CFrame:PointToObjectSpace(joint.Part1.Position)
    return (rel.X < 0) and "L" or "R"
end

-- Finds the important joints of ANY humanoid rig (R6, R15, custom) by looking at
-- the names of the parts each joint connects. Result keys:
--   root, waist, neck, shoulderL/R, elbowL/R, hipL/R, kneeL/R   (missing ones are nil)
local function rigJoints(character)
    local rig = {}
    local root = getRootPart(character)

    for _, d in ipairs(character:GetDescendants()) do
        if d:IsA("JointInstance") and isBodyJoint(d) then
            local n = string.lower((d.Part1.Name:gsub("[%s_]", "")))
            local role = nil

            if root and d.Part0 == root and not rig.root then
                rig.root = d
            elseif n:find("head") then
                role = "neck"
            elseif n:find("uppertorso") or n:find("chest") or n:find("spine") then
                role = "waist"
            elseif n:find("lowerarm") or n:find("forearm") then
                role = "elbow"
            elseif n:find("arm") and not n:find("hand") then
                role = "shoulder"
            elseif n:find("hand") or n:find("wrist") then
                role = "wrist"
            elseif n:find("lowerleg") or n:find("calf") or n:find("shin") then
                role = "knee"
            elseif n:find("leg") or n:find("thigh") then
                role = "hip"
            elseif n:find("foot") or n:find("ankle") then
                role = "ankle"
            end

            if role then
                local key = role
                if role ~= "neck" and role ~= "waist" then
                    key = role .. sideOf(d, root or d.Part0)
                end
                if not rig[key] then
                    rig[key] = d
                end
            end
        end
    end

    return rig
end

local function newPose(character)
    return {root = getRootPart(character)}
end

-- axis / offset are in CHARACTER space; they are converted to the joint's own space,
-- so this works even if a rig's parts are rotated differently.
local function addTilt(list, joint, axis, degrees, offset)
    if not joint or not joint.Part0 then return end

    local axisLocal = axis
    local offsetLocal = offset or NO_OFFSET

    local root = list.root
    if root then
        local rc = root.CFrame
        local pc = joint.Part0.CFrame
        axisLocal = pc:VectorToObjectSpace(rc:VectorToWorldSpace(axis))
        offsetLocal = pc:VectorToObjectSpace(rc:VectorToWorldSpace(offsetLocal))
    end

    if axisLocal.Magnitude < 0.01 then return end

    table.insert(list, {
        joint = joint,
        axis = axisLocal.Unit,
        angle = math.rad(degrees),
        offset = offsetLocal
    })
end

-- Pitch: degrees around the body's X axis.
--   + = top tips BACK (and the bottom swings FORWARD: knees up, arms forward)
--   - = top tips FORWARD (bow / fold)
local function addPitch(list, joint, degrees, offset)
    addTilt(list, joint, X_AXIS, degrees, offset)
end

-- scale of the character (1 = normal size). Hulk makes it bigger.
local function charScale(model)
    local ok, s = pcall(function()
        return model:GetScale()
    end)
    if ok and type(s) == "number" then
        return s
    end
    return 1
end

-- original joint position is saved on the joint so it can always be restored
-- (saved again if the body was resized, so the Hulk size never breaks it)
local function baseC0(joint)
    local sc = charScale(joint:FindFirstAncestorOfClass("Model") or joint)
    local saved = joint:GetAttribute("AIDodgeC0")
    local savedScale = joint:GetAttribute("AIDodgeScale")

    if typeof(saved) ~= "CFrame" or type(savedScale) ~= "number" or math.abs(savedScale - sc) > 0.001 then
        saved = joint.C0
        joint:SetAttribute("AIDodgeC0", saved)
        joint:SetAttribute("AIDodgeScale", sc)
    end

    return saved
end

local activePoses = {}
local poseCounter = 0

-- plays a pose: eases in, holds, springs back with a little overshoot.
-- The joints are written EVERY frame, after the game's own scripts, so games that
-- reset the joints can't cancel the pose.
local function playPose(entries, tIn, hold, tOut)
    poseCounter = poseCounter + 1
    local name = "AIDodgePose" .. poseCounter
    local total = tIn + hold + tOut
    local startTime = os.clock()

    local bases = {}
    for i, e in ipairs(entries) do
        bases[i] = baseC0(e.joint)
    end

    local finished = false
    local function finish()
        if finished then return end
        finished = true
        activePoses[name] = nil
        pcall(function()
            RunService:UnbindFromRenderStep(name)
        end)
        for i, e in ipairs(entries) do
            if e.joint.Parent then
                e.joint.C0 = bases[i]
            end
        end
    end

    -- smooth in (fast start, soft landing), a tiny settle while holding, smooth out
    local function weight(t)
        if t < tIn then
            return TweenService:GetValue(t / tIn, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
        elseif t < tIn + hold then
            local k = (t - tIn) / hold
            return 1 + 0.04 * math.sin(math.pi * k)
        end
        local k = (t - tIn - hold) / tOut
        return 1 - TweenService:GetValue(k, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
    end

    activePoses[name] = true
    RunService:BindToRenderStep(name, Enum.RenderPriority.Last.Value, function()
        local t = os.clock() - startTime
        if t >= total or (BlockWhenDown and Downed) then
            finish()
            return
        end

        local a = weight(t)
        for i, e in ipairs(entries) do
            if e.joint.Parent then
                local b = bases[i]
                local rotOnly = b - b.Position
                e.joint.C0 = CFrame.new(b.Position + e.offset * a)
                    * CFrame.fromAxisAngle(e.axis, e.angle * a)
                    * rotOnly
            end
        end
    end)

    task.wait(total + 0.05)
    finish() -- safety, in case rendering was paused
end

-- SIDE LEAN: localDir = direction to lean toward (local space, X = right, Z = back)
local function leanPose(character, localDir)
    local rig = rigJoints(character)
    local list = newPose(character)

    local axis = Y_AXIS:Cross(localDir)
    if axis.Magnitude < 0.01 then return list end
    axis = axis.Unit

    if rig.waist then
        addTilt(list, rig.root, axis, LeanAngle * 0.3)
        addTilt(list, rig.waist, axis, LeanAngle * 0.7)
    else
        addTilt(list, rig.root, axis, LeanAngle * 0.7)
    end

    return list
end

-- HAWK BACK DODGE: arms hang down, body bends way back from the waist, head keeps looking forward
local function hawkPose(character)
    local rig = rigJoints(character)
    local list = newPose(character)

    local function both(prefix, degrees)
        addPitch(list, rig[prefix .. "L"], degrees)
        addPitch(list, rig[prefix .. "R"], degrees)
    end

    if rig.waist then
        -- split spine (R15 style): hips take a little, the waist does most of the bend
        local rootA = HawkAngle * 0.25
        addPitch(list, rig.root, rootA)
        addPitch(list, rig.waist, HawkAngle * 0.75)
        addPitch(list, rig.neck, -HawkAngle * 0.6)       -- head comes forward, eyes stay on the enemy
        both("hip", -rootA)                              -- legs stay straight
    else
        -- single torso (R6 style): the whole torso tips back, hips get pushed forward
        local half = (rig.root and rig.root.Part1.Size.Y / 2) or 1
        local a = math.rad(HawkAngle)
        addPitch(list, rig.root, HawkAngle, Vector3.new(0, -half * (1 - math.cos(a)), 0))
        addPitch(list, rig.neck, -HawkAngle * 0.5)
        both("hip", -HawkAngle)
    end

    both("shoulder", -HawkAngle)                         -- arms drop and hang
    return list
end

-- DUCK DODGE: knees bent, hips sink back, chest folds forward, guard up
local function duckPose(character)
    local rig = rigJoints(character)
    local list = newPose(character)

    local function both(prefix, degrees)
        addPitch(list, rig[prefix .. "L"], degrees)
        addPitch(list, rig[prefix .. "R"], degrees)
    end

    local hip = rig.hipL or rig.hipR
    local knee = rig.kneeL or rig.kneeR
    local half = (rig.root and rig.root.Part1.Size.Y / 2) or 1

    if hip and knee then
        -- legs with knees (R15 style): thighs forward, shins straight, hips sink down and back
        local thigh = hip.Part1.Size.Y * 0.85            -- hip-to-knee is a bit shorter than the part
        local a = math.rad(DuckKnee)
        local rootPitch = rig.waist and 0 or -DuckBend * 0.8

        addPitch(list, rig.root, rootPitch, Vector3.new(0, -thigh * (1 - math.cos(a)), thigh * math.sin(a)))
        both("hip", DuckKnee - rootPitch)
        both("knee", -DuckKnee)
        addPitch(list, rig.waist, -DuckBend)             -- fold forward (nakayuko)
        addPitch(list, rig.neck, DuckBend * 0.7)         -- head comes up, eyes on the enemy
        both("shoulder", DuckBend + 20)                  -- guard
        both("elbow", 85)

    elseif hip then
        -- one-piece legs (R6 style): torso sinks and folds, legs swing forward
        local torsoDeg = DuckBend * 0.8
        local legDeg = 30
        local legLen = hip.Part1.Size.Y
        local torso = math.rad(torsoDeg)
        local legA = math.rad(legDeg)
        local offY = -(half + legLen) + half * math.cos(torso) + legLen * math.cos(legA)
        local offZ = -half * math.sin(torso) + legLen * math.sin(legA)

        addPitch(list, rig.root, -torsoDeg, Vector3.new(0, offY, offZ))
        addPitch(list, rig.neck, torsoDeg * 0.7)
        both("hip", torsoDeg + legDeg)
        both("shoulder", torsoDeg + 20)

    else
        -- unknown rig (no legs found): at least fold and sink the whole body
        addPitch(list, rig.root, -DuckBend * 0.6, Vector3.new(0, -half * 0.4, 0))
        addPitch(list, rig.waist, -DuckBend * 0.5)
        addPitch(list, rig.neck, DuckBend * 0.5)
        both("shoulder", DuckBend)
    end

    return list
end

local function restoreJoints()
    for name in pairs(activePoses) do
        pcall(function()
            RunService:UnbindFromRenderStep(name)
        end)
        activePoses[name] = nil
    end

    local character = Player.Character
    if not character then return end
    local sc = charScale(character)
    for _, d in ipairs(character:GetDescendants()) do
        if d:IsA("Motor6D") then
            local saved = d:GetAttribute("AIDodgeC0")
            local savedScale = d:GetAttribute("AIDodgeScale")
            if typeof(saved) == "CFrame" then
                if type(savedScale) == "number" and math.abs(savedScale - sc) <= 0.001 then
                    d.C0 = saved
                else
                    d:SetAttribute("AIDodgeC0", nil) -- the body was resized: this saved joint is out of date
                end
            end
        end
    end
end

---------------------------------------------------------------------
-- NO-HIT FRAMES: your hitbox is turned off while you dash / dodge.
-- Client-side: it only stops hits that are detected on YOUR side (Touched on your
-- parts, checks done by your own client). Hits that the game's server decides
-- can't be changed from here.
---------------------------------------------------------------------

local iframeCount = 0
local iframeSaved = {}

local function iframesOn(character)
    iframeCount = iframeCount + 1
    if iframeCount > 1 then return end

    iframeSaved = {}
    for _, d in ipairs(character:GetDescendants()) do
        if d:IsA("BasePart") then
            iframeSaved[d] = {d.CanTouch, d.CanQuery}
            d.CanTouch = false
            d.CanQuery = false
        end
    end
end

local function iframesRestore()
    for part, v in pairs(iframeSaved) do
        if part.Parent then
            part.CanTouch = v[1]
            part.CanQuery = v[2]
        end
    end
    iframeSaved = {}
end

local function iframesOff()
    iframeCount = math.max(0, iframeCount - 1)
    if iframeCount == 0 then
        iframesRestore()
    end
end

local function iframesReset()
    iframeCount = 0
    iframesRestore()
end

local function startIFrames(character, seconds)
    if not IFrames or not character then return end
    iframesOn(character)
    task.delay(seconds, iframesOff)
end

local function dashMove(character, humanoid, root, worldDir)
    local feet = getFeet(character, humanoid, root)
    startIFrames(character, (DashTime + IFrameExtra) * IFrameMul)

    pcall(mirage, character)
    pcall(groundBurst, feet, 7)
    pcall(smoke, feet, 14)
    pcall(ribbon, root, DashTime)
    pcall(fovPulse)
    pcall(screenFx)

    local last = 0
    local count = 0
    slide(root, humanoid, worldDir, DashDistance * DashMul, DashTime, function(t)
        if t - last >= 0.025 then
            last = t
            count = count + 1
            pcall(trailGhost, character, count % 2 == 0)
        end
    end)
end

-- kind: "side" (lean), "back" (hawk), "duck"
-- returns how long the pose lasts (used for the cooldown)
local function dodgeMove(character, humanoid, root, worldDir, localDir, kind)
    local feet = getFeet(character, humanoid, root)

    pcall(mirage, character)
    pcall(groundBurst, feet, kind == "duck" and 3 or 4)
    pcall(smoke, feet, 8)
    pcall(fovPulse)
    pcall(screenFx)

    local entries = {}
    local tIn, hold, tOut

    if kind == "back" then
        local ok, result = pcall(hawkPose, character)
        entries = ok and result or {}
        if not ok then
            notify("Hawk error: " .. tostring(result):sub(1, 100))
        end
        tIn, hold, tOut = 0.1, 0.3, 0.3
        slide(root, humanoid, worldDir, DodgeShift * 1.7, 0.14)
    elseif kind == "duck" then
        local ok, result = pcall(duckPose, character)
        entries = ok and result or {}
        if not ok then
            notify("Duck error: " .. tostring(result):sub(1, 100))
        end
        tIn, hold, tOut = 0.12, 0.6, 0.3

        -- camera dips with you so the duck feels real
        pcall(function()
            local camBase = humanoid.CameraOffset
            TweenService:Create(humanoid, TweenInfo.new(tIn), {
                CameraOffset = camBase + Vector3.new(0, -0.6, 0)
            }):Play()
            task.delay(tIn + hold, function()
                TweenService:Create(humanoid, TweenInfo.new(tOut), {CameraOffset = camBase}):Play()
            end)
        end)
    else
        local ok, result = pcall(leanPose, character, localDir)
        entries = ok and result or {}
        tIn, hold, tOut = 0.09, 0.19, 0.3
        slide(root, humanoid, worldDir, DodgeShift, 0.12)
    end

    startIFrames(character, (tIn + hold + IFrameExtra) * IFrameMul)

    if #entries == 0 then
        if not warnedPose then
            warnedPose = true
            notify("Pose failed: no body joints found (custom rig?)")
        end
    elseif kind == "duck" and #entries < 6 then
        notify("Duck: only " .. #entries .. " joints found - this rig may look wrong")
    end

    if #entries > 0 then
        task.spawn(function()
            local okPose, errPose = pcall(playPose, entries, tIn, hold, tOut)
            if not okPose then
                warn("[AI Dodge] pose: " .. tostring(errPose))
            end
        end)
    end

    task.delay(tIn, function()
        pcall(trailGhost, character, true)
    end)

    return tIn + hold + tOut
end

-- direction is in LOCAL space: X = right, Z = backward (forward is -Z)
-- kind: "side" (default), "back" (hawk), "duck"  (back/duck only apply in DODGE mode, duck always ducks)
-- forcedMove: "DASH" or "DODGE" (RANDOM mode uses this); nil = use the current MODE
-- manual buttons in RANDOM mode pick dash or dodge by coin flip
local function moveLabel(move, kind)
    if kind == "duck" then return "DUCK" end
    if move == "DASH" then return "DASH" end
    if kind == "back" then return "HAWK" end
    return "LEAN"
end

local function perform(direction, kind, forcedMove)
    if Busy then return end

    local humanoid, root = getCharacter()
    if not humanoid or not root then return end

    -- ragdolled / knocked down / stunned: no dodging
    if BlockWhenDown and Downed then
        downToast()
        return
    end

    kind = kind or "side"

    local move = forcedMove or Mode
    if move == "RANDOM" then
        move = (math.random(1, 2) == 1) and "DASH" or "DODGE"
    end

    local localDir = Vector3.new(0, 0, -1)
    local worldDir = Vector3.new(0, 0, 0)

    if kind ~= "duck" then
        local flatLocal = Vector3.new(direction.X, 0, direction.Z)
        if flatLocal.Magnitude < 0.01 then return end
        localDir = flatLocal.Unit

        worldDir = root.CFrame:VectorToWorldSpace(localDir)
        worldDir = Vector3.new(worldDir.X, 0, worldDir.Z)
        if worldDir.Magnitude < 0.01 then return end
        worldDir = worldDir.Unit
    end

    local character = Player.Character
    local label = moveLabel(move, kind)
    local cooldown

    Busy = true
    local ok, err = pcall(function()
        if move == "DASH" and kind ~= "duck" then
            cooldown = DashCooldown * CooldownMul
            dashMove(character, humanoid, root, worldDir)
        else
            cooldown = DodgeCooldown * CooldownMul
            local length = dodgeMove(character, humanoid, root, worldDir, localDir, kind)
            cooldown = math.max(cooldown, length or 0)
        end
    end)

    if ok then
        Stats.total = Stats.total + 1
        Stats[label] = (Stats[label] or 0) + 1
        lastMove = label
        sfx(label == "DASH" and "dash" or "dodge", 0.8, 0.92 + math.random() * 0.16)
        if uiHooks.onMove then
            pcall(uiHooks.onMove, label)
        end
    else
        warn("[AI Dodge] " .. tostring(err))
    end
    cooldown = cooldown or 0.5

    task.delay(cooldown, function()
        Busy = false
    end)
end

