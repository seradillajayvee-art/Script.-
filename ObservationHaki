local fovBase = nil
local fovActive = 0

local function fovPulse(extra)
    local kick = extra or FovKick
    if kick <= 0 then return end
    local cam = workspace.CurrentCamera
    if not cam then return end

    -- remember the real FOV once, so overlapping pulses can't make it drift
    if fovActive == 0 then
        fovBase = cam.FieldOfView
    end
    fovActive = fovActive + 1
    local base = fovBase

    TweenService:Create(cam, TweenInfo.new(0.07, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        FieldOfView = base + kick
    }):Play()

    task.delay(0.07, function()
        TweenService:Create(cam, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            FieldOfView = base
        }):Play()
    end)
    task.delay(0.4, function()
        fovActive = math.max(0, fovActive - 1)
    end)
end

