-- fast start, smooth stop; total distance = distance
local function slide(root, humanoid, worldDir, distance, duration, onStep)
    local speed = distance / duration
    local startTime = os.clock()

    local conn
    conn = RunService.Heartbeat:Connect(function()
        local t = os.clock() - startTime
        if t >= duration or humanoid.Health <= 0 or not root.Parent then
            conn:Disconnect()
            return
        end

        local mult = 2 * (1 - t / duration)
        local v = root.AssemblyLinearVelocity
        root.AssemblyLinearVelocity = Vector3.new(worldDir.X * speed * mult, v.Y, worldDir.Z * speed * mult)

        if onStep then
            onStep(t)
        end
    end)
end

-- joints used for the lean (no animation, just tilts the body)
local function getLeanJoints(character)
    local joints = {}
    local lower = character:FindFirstChild("LowerTorso")
    local upper = character:FindFirstChild("UpperTorso")

    if lower and upper then -- R15
        local rootJoint = lower:FindFirstChild("Root")
        local waist = upper:FindFirstChild("Waist")
        if rootJoint then
            table.insert(joints, {joint = rootJoint, share = 0.3})
        end
        if waist then
            table.insert(joints, {joint = waist, share = 0.7})
        end
    else -- R6
        local hrp = character:FindFirstChild("HumanoidRootPart")
        local rootJoint = hrp and hrp:FindFirstChild("RootJoint")
        if rootJoint then
            table.insert(joints, {joint = rootJoint, share = 0.7})
        end
    end

    return joints
end

-- original joint position is saved on the joint so it can always be restored
local function baseC0(joint)
    local saved = joint:GetAttribute("AIDodgeC0")
    if typeof(saved) ~= "CFrame" then
        saved = joint.C0
        joint:SetAttribute("AIDodgeC0", saved)
    end
    return saved
end

local function rotatedC0(c0, axis, angle)
    local rotOnly = c0 - c0.Position
    return CFrame.new(c0.Position) * CFrame.fromAxisAngle(axis, angle) * rotOnly
end

-- localDir = direction to lean toward (local space, X = right, Z = back)
local function leanBody(character, localDir)
    local joints = getLeanJoints(character)
    if #joints == 0 then return end

    local axis = Vector3.new(0, 1, 0):Cross(localDir)
    if axis.Magnitude < 0.01 then return end
    axis = axis.Unit

    for _, j in ipairs(joints) do
        local target = rotatedC0(baseC0(j.joint), axis, math.rad(LeanAngle * j.share))
        TweenService:Create(j.joint, TweenInfo.new(0.09, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            C0 = target
        }):Play()
    end

    task.wait(0.19)

    -- springs back with a little overshoot (the "lean lean" feel)
    for _, j in ipairs(joints) do
        if j.joint.Parent then
            TweenService:Create(j.joint, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                C0 = baseC0(j.joint)
            }):Play()
        end
    end
end

local function restoreJoints()
    local character = Player.Character
    if not character then return end
    for _, j in ipairs(getLeanJoints(character)) do
        local saved = j.joint:GetAttribute("AIDodgeC0")
        if typeof(saved) == "CFrame" then
            j.joint.C0 = saved
        end
    end
end

local function dashMove(character, humanoid, root, worldDir)
    local feet = getFeet(character, humanoid, root)

    pcall(mirage, character)
    pcall(groundBurst, feet, 7)
    pcall(smoke, feet, 14)
    pcall(ribbon, root, DashTime)
    pcall(fovPulse)
    pcall(screenFx)

    local last = 0
    local count = 0
    slide(root, humanoid, worldDir, DashDistance, DashTime, function(t)
        if t - last >= 0.025 then
            last = t
            count = count + 1
            pcall(trailGhost, character, count % 2 == 0)
        end
    end)
end

local function dodgeMove(character, humanoid, root, worldDir, localDir)
    local feet = getFeet(character, humanoid, root)

    pcall(mirage, character)
    pcall(groundBurst, feet, 4)
    pcall(smoke, feet, 8)
    pcall(fovPulse)
    pcall(screenFx)

    slide(root, humanoid, worldDir, DodgeShift, 0.12)

    task.spawn(function()
        pcall(leanBody, character, localDir)
    end)

    task.delay(0.09, function()
        pcall(trailGhost, character, true)
    end)
end

-- direction is in LOCAL space: X = right, Z = backward (forward is -Z)
local function perform(direction)
    if Busy then return end

    local humanoid, root = getCharacter()
    if not humanoid or not root then return end

    local flatLocal = Vector3.new(direction.X, 0, direction.Z)
    if flatLocal.Magnitude < 0.01 then return end
    local localDir = flatLocal.Unit

    local worldDir = root.CFrame:VectorToWorldSpace(localDir)
    worldDir = Vector3.new(worldDir.X, 0, worldDir.Z)
    if worldDir.Magnitude < 0.01 then return end
    worldDir = worldDir.Unit

    local character = Player.Character
    local cooldown

    Busy = true
    local ok, err = pcall(function()
        if Mode == "DASH" then
            cooldown = DashCooldown
            dashMove(character, humanoid, root, worldDir)
        else
            cooldown = DodgeCooldown
            dodgeMove(character, humanoid, root, worldDir, localDir)
        end
    end)

    if not ok then
        warn("[AI Dodge] " .. tostring(err))
    end
    cooldown = cooldown or 0.5

    task.delay(cooldown, function()
        Busy = false
    end)
end

