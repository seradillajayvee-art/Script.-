-- KNOCKDOWN / RAGDOLL MONITOR: auto dodge stays OFF while you can't move properly
---------------------------------------------------------------------

local downNames = {}
for _, n in ipairs({"ragdoll", "ragdolled", "isragdoll", "inragdoll", "stunned", "stun", "isstunned",
    "knockeddown", "knocked", "knockdown", "downed", "dazed", "frozen", "paralyzed", "grabbed",
    "bound", "immobilized"}) do
    downNames[n] = true
end

local function truthy(v)
    return v == true or (type(v) == "number" and v ~= 0)
end

-- cheap checks (every frame)
local function fastDownCheck(humanoid)
    local state = humanoid:GetState()
    if state == Enum.HumanoidStateType.Ragdoll or state == Enum.HumanoidStateType.Physics then
        return "RAGDOLL"
    end
    if state == Enum.HumanoidStateType.FallingDown then return "KNOCKED DOWN" end
    if state == Enum.HumanoidStateType.GettingUp then return "GETTING UP" end
    if state == Enum.HumanoidStateType.PlatformStanding or humanoid.PlatformStand then return "STUNNED" end
    if state == Enum.HumanoidStateType.Seated or humanoid.Sit then return "SEATED" end
    if humanoid.WalkSpeed <= 0.5 then return "FROZEN" end
    return nil
end

-- heavier checks (10 times a second): flags the game puts on you, disabled joints, ragdoll constraints
local function slowDownCheck(character, humanoid)
    for _, holder in ipairs({character, humanoid, Player}) do
        local ok, attrs = pcall(function()
            return holder:GetAttributes()
        end)
        if ok then
            for name, v in pairs(attrs) do
                if downNames[string.lower(name)] and truthy(v) then
                    return string.upper(name)
                end
            end
        end
    end

    for _, holder in ipairs({character, humanoid}) do
        for _, c in ipairs(holder:GetChildren()) do
            if (c:IsA("BoolValue") or c:IsA("IntValue") or c:IsA("NumberValue"))
                and downNames[string.lower(c.Name)] and truthy(c.Value) then
                return string.upper(c.Name)
            end
        end
    end

    local sockets = 0
    for _, d in ipairs(character:GetDescendants()) do
        if d:IsA("Motor6D") then
            if d.Enabled == false and not d:FindFirstAncestorOfClass("Accessory") then
                return "RAGDOLL"
            end
        elseif d:IsA("BallSocketConstraint") and d.Enabled then
            sockets = sockets + 1
        end
    end
    if sockets >= 2 then return "RAGDOLL" end

    return nil
end

local lastSlowCheck = 0
local slowReason = nil

track(RunService.Heartbeat:Connect(function()
    local character = Player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local reason = nil

    if humanoid and humanoid.Health > 0 then
        reason = fastDownCheck(humanoid)
        if not reason then
            local now = os.clock()
            if now - lastSlowCheck > 0.1 then
                lastSlowCheck = now
                slowReason = slowDownCheck(character, humanoid)
            end
            reason = slowReason
        end
    else
        slowReason = nil
    end

    if reason then
        local started = not Downed
        Downed = true
        DownReason = reason
        if started then
            if BlockWhenDown then
                pcall(restoreJoints) -- cancels a dodge pose that is still playing
                pcall(iframesReset)  -- hits can land again
                downToast()
            end
            if uiHooks.onDowned then
                pcall(uiHooks.onDowned, true, reason)
            end
        end
    elseif Downed then
        Downed = false
        DownReason = ""
        if uiHooks.onDowned then
            pcall(uiHooks.onDowned, false, "")
        end
    end
end))

