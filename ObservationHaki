local function toggleRow(label, getter, setter, desc, keywords)
    local f = card(desc and 44 or 36, label, keywords)
    labels(f, label, desc, 56)

    local rail = new("Frame", {
        Size = UDim2.fromOffset(40, 20), Position = UDim2.new(1, -50, 0.5, -10),
        BackgroundColor3 = OFFC, BorderSizePixel = 0,
    }, f)
    corner(rail, 10)
    local knob = new("Frame", {
        Size = UDim2.fromOffset(16, 16), Position = UDim2.fromOffset(2, 2),
        BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0,
    }, rail)
    corner(knob, 8)
    local hit = new("TextButton", {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", ZIndex = 5}, f)

    local function refresh(instant)
        local on = getter() and true or false
        local pos = on and UDim2.fromOffset(22, 2) or UDim2.fromOffset(2, 2)
        local col = on and accent() or OFFC
        if instant then
            knob.Position = pos
            rail.BackgroundColor3 = col
        else
            tween(knob, 0.18, {Position = pos}, Enum.EasingStyle.Back)
            tween(rail, 0.18, {BackgroundColor3 = col})
        end
    end

    hit.MouseButton1Click:Connect(function()
        local newValue = not getter()
        setter(newValue)
        sfx(newValue and "on" or "off")
        refresh(false)
    end)

    table.insert(refreshers, function()
        refresh(false)
    end)
    refresh(true)
    return f
end

local function stepperRow(label, getter, setter, minV, maxV, step, fmt, desc, keywords)
    local f = card(desc and 44 or 36, label, keywords)
    labels(f, label, desc, 112)

    local function small(text, x)
        local b = new("TextButton", {
            Size = UDim2.fromOffset(24, 24), Position = UDim2.new(1, x, 0.5, -12), BackgroundColor3 = PANEL2,
            Text = text, Font = Enum.Font.GothamBold, TextSize = 14, TextColor3 = TEXT, AutoButtonColor = false,
        }, f)
        corner(b, 6)
        pressFx(b)
        return b
    end

    local minus = small("-", -112)
    local plus = small("+", -34)
    local value = new("TextLabel", {
        BackgroundTransparency = 1, Position = UDim2.new(1, -86, 0.5, -12), Size = UDim2.fromOffset(50, 24),
        Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = TEXT, Text = "",
    }, f)

    local function refresh()
        local v = getter()
        value.Text = fmt and fmt(v) or tostring(v)
    end

    local function change(dir)
        local v = math.clamp(round2(getter() + dir * val(step)), val(minV), val(maxV))
        setter(v)
        refresh()
    end

    minus.MouseButton1Click:Connect(function()
        change(-1)
    end)
    plus.MouseButton1Click:Connect(function()
        change(1)
    end)

    table.insert(refreshers, refresh)
    refresh()
    return f
end

local function cycleRow(label, options, getter, setter, desc, keywords)
