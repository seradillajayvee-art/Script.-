-- Damage boost (best effort): multiplies damage-like numbers the game keeps on your
-- character / humanoid / player. Real damage is decided by the game's SERVER, so this
-- only does something if the game reads one of these values. Returns how many were changed.
local function setDamage(character, on)
    if on then
        hulk.attrs = {}

        local holders = {character, Player}
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            table.insert(holders, humanoid)
        end

        for _, holder in ipairs(holders) do
            for _, name in ipairs(HulkDamageAttributes) do
                local v = holder:GetAttribute(name)
                if type(v) == "number" then
                    table.insert(hulk.attrs, {holder, name, v})
                    holder:SetAttribute(name, v * HulkDamage)
                end
            end
        end
        return #hulk.attrs
    end

    for _, a in ipairs(hulk.attrs) do
        pcall(function()
            a[1]:SetAttribute(a[2], a[3])
        end)
    end
    hulk.attrs = {}
    return 0
end

