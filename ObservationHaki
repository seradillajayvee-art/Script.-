-- AI DODGE - DELTA MOBILE (Shadow edition: black & gray)
-- MODE: DASH (quick slip-step) / DODGE (body poses, no animation) / RANDOM (reads the attack, picks dash or dodge)
--   DODGE: LEFT / RIGHT = side lean
--          BACK         = HAWK back dodge (Hajime no Ippo, Takamura style: arms down, bend way back)
--          DUCK         = real duck (knees bent, body folded forward)
-- Auto dodge only reacts to enemies INSIDE the range circle

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UIS = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local Lighting = game:GetService("Lighting")
local StarterGui = game:GetService("StarterGui")

local Player = Players.LocalPlayer

local function notify(text)
    print("[AI Dodge] " .. text)
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = "AI Dodge",
            Text = text,
            Duration = 6
        })
    end)
end

local function main()

-- SETTINGS (tweak these)
local Range = 10              -- auto dodge only triggers inside this circle (studs)
local RangeMin = 4
local RangeMax = 30
local RangeStep = 2
local DashDistance = 5        -- how far the dash goes (studs)
local DashTime = 0.12         -- how long the dash lasts (seconds)
local DashCooldown = 0.45
local LeanAngle = 35          -- degrees the body leans sideways in DODGE mode
local DodgeShift = 1.5        -- tiny slide during the lean (studs)
local DodgeCooldown = 0.4
local ApproachSpeed = 3       -- enemy must move toward you at least this fast (or be very close)
local FovKick = 8             -- camera FOV pulse (0 = off)
local ScreenFX = true         -- quick grayscale flash + blur (set false if it lags)
local HideUi = false          -- false = normal PlayerGui (always visible). true = hidden executor UI (gethui/CoreGui)

-- NEW: hawk back dodge + duck dodge
local HawkAngle = 55          -- how far you bend BACK in the hawk dodge (degrees, bigger = deeper)
local DuckBend = 50           -- how far the body folds forward when ducking (degrees)
local DuckKnee = 55           -- how deep the knees bend when ducking (degrees)
local AutoStyle = "MIX"       -- DODGE mode auto: "MIX", "SIDE", "BACK" (hawk), "DUCK"

-- NEW: RANDOM mode (punch = dodge, heavy / bullet = dash or dodge)
local HeavyTime = 0.75        -- enemy attack animation this long (seconds) or longer = HEAVY, shorter = PUNCH
local ChargeSpeed = 30        -- enemy rushing at you faster than this (studs/s) counts as HEAVY
local HeavyDashChance = 0.6   -- heavy attack: chance to DASH (otherwise dodge)
local HeavyDelay = 0.12       -- heavy attack: wait a bit before reacting so you dodge closer to the hit
local BulletDashChance = 0.6  -- bullet: chance to DASH (otherwise dodge: lean or duck)
local BulletSpeed = 35        -- part must fly at least this fast (studs/s) to count as a bullet
local BulletReact = 0.45      -- react when the bullet would hit in less than this many seconds
local BulletMiss = 4.5        -- only dodge bullets that would pass within this many studs of you
local BulletMaxSize = 12      -- ignore fast parts bigger than this (not bullets)
local RequireAttackAnim = false -- true = RANDOM only reacts when it SEES an attack animation / bullet

-- COLORS (black & gray only)
local BLACK = Color3.fromRGB(10, 10, 10)
local DARK = Color3.fromRGB(45, 45, 45)
local GRAY = Color3.fromRGB(120, 120, 120)
local LIGHT = Color3.fromRGB(185, 185, 185)

local Enabled = false
local Busy = false
local Pending = false      -- waiting to react to a heavy attack
local Mode = "DASH"           -- "DASH" or "DODGE"
local ShowCircle = true

local function getCharacter()
    local character = Player.Character
    if not character then return end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart")

    if humanoid and root and humanoid.Health > 0 then
        return humanoid, root
    end
end

local function feetOffset(humanoid, root)
    if humanoid.RigType == Enum.HumanoidRigType.R6 then
        return 3
    end
    return humanoid.HipHeight + root.Size.Y / 2
end

local function getFeet(character, humanoid, root)
    local params = RaycastParams.new()
    params.FilterDescendantsInstances = {character}
    params.FilterType = Enum.RaycastFilterType.Exclude
    local result = workspace:Raycast(root.Position, Vector3.new(0, -8, 0), params)
    if result then
        return result.Position
    end
    return root.Position - Vector3.new(0, feetOffset(humanoid, root), 0)
end

