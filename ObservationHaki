-- body parts only (not accessories, not the root part, not the eyes)
local function bodyParts(character)
    local list = {}
    for _, p in ipairs(character:GetChildren()) do
        if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" and p.Name ~= "AIDodgeEye" then
            table.insert(list, p)
        end
    end
    return list
end

-- camera rumble
local function shake(humanoid, duration, power)
    local base = humanoid.CameraOffset
    local startTime = os.clock()
    while os.clock() - startTime < duration and humanoid.Parent do
        humanoid.CameraOffset = base + Vector3.new((math.random() - 0.5) * power, (math.random() - 0.5) * power, 0)
        task.wait()
    end
    humanoid.CameraOffset = base
end

-- grow / shrink the whole body (with a little overshoot)
local function scaleTo(character, target, duration)
    local start = charScale(character)
    local steps = math.max(1, math.floor(duration / 0.03))

    for i = 1, steps do
        local a = TweenService:GetValue(i / steps, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
        local s = math.max(start + (target - start) * a, 0.2)
        local ok = pcall(function()
            character:ScaleTo(s)
        end)
        if not ok then
            return false
        end
        task.wait(0.03)
    end

    pcall(function()
        character:ScaleTo(target)
    end)
    return true
end

-- skin turns green (and back)
local function paintSkin(character, on, onlyParts)
    local bc = (not onlyParts) and character:FindFirstChildOfClass("BodyColors") or nil

    if on then
        hulk.colors = {}
        for _, p in ipairs(onlyParts or bodyParts(character)) do
            hulk.colors[p] = p.Color
            TweenService:Create(p, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                Color = HulkSkin
            }):Play()
        end

        if bc then
            hulk.bodyColors = {
                bc.HeadColor3, bc.TorsoColor3, bc.LeftArmColor3,
                bc.RightArmColor3, bc.LeftLegColor3, bc.RightLegColor3
            }
            task.delay(0.55, function()
                if hulk.bodyColors and bc.Parent then
                    bc.HeadColor3 = HulkSkin
                    bc.TorsoColor3 = HulkSkin
                    bc.LeftArmColor3 = HulkSkin
                    bc.RightArmColor3 = HulkSkin
                    bc.LeftLegColor3 = HulkSkin
                    bc.RightLegColor3 = HulkSkin
                end
            end)
        end
    else
        local saved = hulk.bodyColors
        if bc and saved then
            bc.HeadColor3 = saved[1]
            bc.TorsoColor3 = saved[2]
            bc.LeftArmColor3 = saved[3]
            bc.RightArmColor3 = saved[4]
            bc.LeftLegColor3 = saved[5]
            bc.RightLegColor3 = saved[6]
        end
        for p, c in pairs(hulk.colors) do
            if p.Parent then
                TweenService:Create(p, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                    Color = c
                }):Play()
            end
        end
        hulk.colors = {}
        hulk.bodyColors = nil
    end
end

-- shirt gets ripped off (so the green skin shows)
local function ripShirt(character, on)
    if not HulkRipShirt then return end

    local shirt = character:FindFirstChildOfClass("Shirt")
    local tshirt = character:FindFirstChildOfClass("ShirtGraphic")

    if on then
        if shirt then
            hulk.shirt = shirt.ShirtTemplate
            shirt.ShirtTemplate = ""
        end
        if tshirt then
            hulk.tshirt = tshirt.Graphic
            tshirt.Graphic = ""
        end
    else
        if shirt and hulk.shirt then
            shirt.ShirtTemplate = hulk.shirt
        end
        if tshirt and hulk.tshirt then
            tshirt.Graphic = hulk.tshirt
        end
        hulk.shirt = nil
        hulk.tshirt = nil
    end
end

-- glowing red eyes (two neon bars welded on the front of the head)
local function removeEyes()
    for _, eye in ipairs(hulk.eyes) do
        pcall(function()
            eye:Destroy()
        end)
    end
    hulk.eyes = {}
end

local function addEyes(character)
    removeEyes()

    local rigH = rigJoints(character)
    local head = character:FindFirstChild("Head") or (rigH.neck and rigH.neck.Part1)
    if not head or not head:IsA("BasePart") then return end

    local s = head.Size.Y
    for _, side in ipairs({-1, 1}) do
        local eye = Instance.new("Part")
        eye.Name = "AIDodgeEye"
        eye.Material = Enum.Material.Neon
        eye.Color = HulkEyes
        eye.Size = Vector3.new(0.22 * s, 0.12 * s, 0.05 * s)
        eye.CanCollide = false
        eye.CanQuery = false
        eye.CanTouch = false
        eye.Massless = true
        eye.CastShadow = false
        eye.CFrame = head.CFrame * CFrame.new(side * 0.24 * s, 0.08 * s, -(head.Size.Z / 2) - 0.1 * s)
        eye.Parent = character

        local weld = Instance.new("WeldConstraint")
        weld.Part0 = head
        weld.Part1 = eye
        weld.Parent = eye

        table.insert(hulk.eyes, eye)
    end

    local light = Instance.new("PointLight")
    light.Color = HulkEyes
    light.Brightness = 2
    light.Range = 8 * s
    light.Parent = hulk.eyes[1]
end

-- green rage smoke around the body
