-- silhouette copy of your body: solid color + outline, shrinks and fades
local function makeGhost(character, bodyColor, outlineColor, life, startTransparency)
    local model = Instance.new("Model")
    model.Name = "AIDodgeGhost"

    for _, part in ipairs(character:GetChildren()) do
        if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" and part.Transparency < 1 then
            local ok, ghost = pcall(function()
                return part:Clone()
            end)
            if ok and ghost then
                -- strip everything except the head mesh (R6 heads need it to stay round)
                for _, child in ipairs(ghost:GetChildren()) do
                    if child:IsA("SpecialMesh") then
                        child.TextureId = ""
                    else
                        child:Destroy()
                    end
                end
                ghost.Anchored = true
                ghost.CanCollide = false
                ghost.CanQuery = false
                ghost.CanTouch = false
                ghost.Massless = true
                ghost.Material = Enum.Material.SmoothPlastic
                ghost.Color = bodyColor
                ghost.Transparency = startTransparency
                if ghost:IsA("MeshPart") then
                    ghost.TextureID = ""
                end
                ghost.CFrame = part.CFrame
                ghost.Parent = model
                TweenService:Create(ghost, TweenInfo.new(life, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
                    Transparency = 1,
                    Size = ghost.Size * 0.6
                }):Play()
            end
        end
    end

    local hl = Instance.new("Highlight")
    hl.Adornee = model
    hl.FillTransparency = 1
    hl.OutlineColor = outlineColor
    hl.OutlineTransparency = 0.1
    hl.DepthMode = Enum.HighlightDepthMode.Occluded
    hl.Parent = model

    model.Parent = workspace
    TweenService:Create(hl, TweenInfo.new(life), {OutlineTransparency = 1}):Play()
    Debris:AddItem(model, life + 0.1)
end

-- the "mirage": a black silhouette left standing where you were
local function mirage(character)
    makeGhost(character, BLACK, LIGHT, 0.8, 0.1)
end

-- trail ghosts alternate black / gray
local function trailGhost(character, alt)
    if alt then
        makeGhost(character, GRAY, BLACK, 0.35, 0.3)
    else
        makeGhost(character, BLACK, GRAY, 0.35, 0.2)
    end
end

-- flat black + gray shockwave on the ground
local function groundBurst(position, radius)
    local layers = {
        {color = BLACK, size = radius, height = 0.08},
        {color = GRAY, size = radius * 0.6, height = 0.14},
    }
    for _, layer in ipairs(layers) do
        local disc = Instance.new("Part")
        disc.Shape = Enum.PartType.Cylinder
        disc.Anchored = true
        disc.CanCollide = false
        disc.CanQuery = false
        disc.CanTouch = false
        disc.Material = Enum.Material.SmoothPlastic
        disc.Color = layer.color
        disc.Transparency = 0.2
        disc.Size = Vector3.new(0.12, 1, 1)
        disc.CFrame = CFrame.new(position + Vector3.new(0, layer.height, 0)) * CFrame.Angles(0, 0, math.pi / 2)
        disc.Parent = workspace
        TweenService:Create(disc, TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Size = Vector3.new(0.12, layer.size * 2, layer.size * 2),
            Transparency = 1
        }):Play()
        Debris:AddItem(disc, 0.5)
    end
end

-- gray / black smoke puff
local function smoke(position, amount)
    local p = Instance.new("Part")
    p.Anchored = true
    p.CanCollide = false
    p.CanQuery = false
    p.CanTouch = false
    p.Transparency = 1
    p.Size = Vector3.new(1, 1, 1)
    p.CFrame = CFrame.new(position)
    p.Parent = workspace

    local e = Instance.new("ParticleEmitter")
    e.Texture = "rbxasset://textures/particles/smoke_main.dds"
    e.Color = ColorSequence.new(GRAY, BLACK)
    e.Size = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 1.5),
        NumberSequenceKeypoint.new(1, 4)
    })
    e.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.35),
        NumberSequenceKeypoint.new(1, 1)
    })
    e.Lifetime = NumberRange.new(0.4, 0.8)
    e.Speed = NumberRange.new(6, 14)
    e.SpreadAngle = Vector2.new(70, 70)
    e.Rotation = NumberRange.new(0, 360)
