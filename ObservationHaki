local function flash(entry)
    local f = entry.frame
    local page = pages[entry.page]
    task.delay(0.3, function()
        if not f.Parent then return end
        pcall(function()
            local s = winScale.Scale
            if s <= 0 then s = 1 end
            local y = (f.AbsolutePosition.Y - page.AbsolutePosition.Y) / s + page.CanvasPosition.Y - 8
            page.CanvasPosition = Vector2.new(0, math.max(0, y))
        end)
        local old = f.BackgroundColor3
        f.BackgroundColor3 = accent()
        tween(f, 0.9, {BackgroundColor3 = old})
    end)
end

local function runSearch(q)
    q = string.lower(q)
    q = q:match("^%s*(.-)%s*$")

    if q == "" then
        if currentTab == "SEARCH" then
            gotoTab(lastRealTab, true)
        end
        return
    end

    local results = pages.SEARCH
    for _, c in ipairs(results:GetChildren()) do
        if c:IsA("TextButton") or c:IsA("TextLabel") then
            c:Destroy()
        end
    end

    local count = 0
    for _, e in ipairs(registry) do
        if string.find(e.keys, q, 1, true) then
            count = count + 1
            if count <= 14 then
                local b = new("TextButton", {
                    Size = UDim2.new(1, 0, 0, 34), BackgroundColor3 = PANEL, Text = "",
                    AutoButtonColor = false, LayoutOrder = count,
                }, results)
                corner(b, 8)
                stroke(b, EDGE, 1)
                pressFx(b)
                new("TextLabel", {
                    BackgroundTransparency = 1, Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -90, 1, 0),
                    Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = TEXT,
                    TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Text = e.label,
                }, b)
                local tag = new("TextLabel", {
                    BackgroundTransparency = 1, Position = UDim2.new(1, -80, 0, 0), Size = UDim2.fromOffset(70, 34),
                    Font = Enum.Font.GothamBold, TextSize = 10, TextXAlignment = Enum.TextXAlignment.Right, Text = e.page,
                }, b)
                bindAccent(tag, "TextColor3")
                b.MouseButton1Click:Connect(function()
                    searchBox.Text = ""
                    gotoTab(e.page)
                    flash(e)
