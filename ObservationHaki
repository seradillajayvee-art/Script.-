-- world-space "away" direction -> local slip direction (sideways + a bit away)
local function slipDirection(root, away, awayWeight)
    local sign = (math.random(1, 2) == 1) and 1 or -1
    local perp = Vector3.new(-away.Z, 0, away.X) * sign
    local dir = (perp + away * awayWeight).Unit
    return root.CFrame:VectorToObjectSpace(dir)
end

-- is the threat roughly in front of you? (away = direction from the threat to you)
local function isInFront(root, away)
    local look = root.CFrame.LookVector
    local flatLook = Vector3.new(look.X, 0, look.Z)
    return flatLook.Magnitude > 0.01 and flatLook.Unit:Dot(-away) > 0.5
end

-- which dodge pose to use (side lean / hawk back / duck), from the AUTO style button
-- hawk + duck only when the attacker is in front of you
local function pickDodgeKind(root, away)
    local style = AutoStyle
    if style == "MIX" then
        local roll = math.random(1, 3)
        if roll == 1 then
            style = "SIDE"
        elseif roll == 2 then
            style = "BACK"
        else
            style = "DUCK"
        end
    end

    if isInFront(root, away) then
        if style == "BACK" then return "back" end
        if style == "DUCK" then return "duck" end
    end
    return "side"
end

-- move = nil -> uses the current MODE
local function performKind(root, away, kind, move, awayWeight)
    if kind == "back" then
        perform(Vector3.new(0, 0, 1), "back", move)
    elseif kind == "duck" then
        perform(Vector3.new(0, 0, -1), "duck", move)
    else
        perform(slipDirection(root, away, awayWeight or 0.35), "side", move)
    end
end

---------------------------------------------------------------------
-- RANDOM MODE: figure out WHAT is coming (punch / heavy / bullet)
---------------------------------------------------------------------

-- attack animation that just started on an enemy (short = punch, long = heavy)
local seenTracks = setmetatable({}, {__mode = "k"})

local function attackAnimation(oHumanoid)
    local animator = oHumanoid:FindFirstChildOfClass("Animator")
    if not animator then return nil end

    local ok, tracks = pcall(function()
        return animator:GetPlayingAnimationTracks()
    end)
    if not ok then return nil end

    for _, track in ipairs(tracks) do
        local p = track.Priority
        if not track.Looped
            and p ~= Enum.AnimationPriority.Core
            and p ~= Enum.AnimationPriority.Idle
            and p ~= Enum.AnimationPriority.Movement
            and track.Length > 0.2
            and track.TimePosition < 0.3
            and not seenTracks[track] then
            seenTracks[track] = true
            if track.Length >= HeavyTime then
                return "heavy"
            end
            return "punch"
        end
    end

    return nil
end

-- nearest enemy inside the circle that is attacking (or charging at you)
local function scanThreat(root)
    local best = nil
    local bestDist = math.huge

    for _, other in ipairs(Players:GetPlayers()) do
        if other ~= Player and other.Character then
            local oHumanoid = other.Character:FindFirstChildOfClass("Humanoid")
            local oRoot = other.Character:FindFirstChild("HumanoidRootPart")

            if oHumanoid and oHumanoid.Health > 0 and oRoot then
                local offset = root.Position - oRoot.Position
                local flat = Vector3.new(offset.X, 0, offset.Z)
                local dist = flat.Magnitude

                if dist < Range and dist > 0.1 and dist < bestDist then
                    local toMe = flat.Unit
                    local closing = oRoot.AssemblyLinearVelocity:Dot(toMe)
                    local facing = oRoot.CFrame.LookVector:Dot(toMe)

                    local kind = nil
                    local fromAnim = false

                    if facing > 0.4 then
                        kind = attackAnimation(oHumanoid)
                        fromAnim = kind ~= nil
                    end

                    -- no animation seen: fall back to "enemy is rushing / right next to you"
                    if not kind and not RequireAttackAnim and facing > 0.5
                        and (closing > ApproachSpeed or dist < Range * 0.5) then
                        kind = (closing > ChargeSpeed) and "heavy" or "punch"
                    end

                    if kind then
                        bestDist = dist
                        best = {kind = kind, away = toMe, anim = fromAnim}
                    end
                end
            end
        end
    end

    return best
end

-- fast small parts flying at you (bullets / projectiles)
local bulletLastPos = setmetatable({}, {__mode = "k"})
local bulletLastTime = setmetatable({}, {__mode = "k"})
local bulletParams = OverlapParams.new()
bulletParams.FilterType = Enum.RaycastFilterType.Exclude
local lastBulletScan = 0

local function scanBullet(character, root)
    local now = os.clock()
    if now - lastBulletScan < 0.05 then return nil end
    lastBulletScan = now

    bulletParams.FilterDescendantsInstances = {character}
    local radius = math.max(Range + 10, 22)

    local ok, parts = pcall(function()
        return workspace:GetPartBoundsInRadius(root.Position, radius, bulletParams)
    end)
    if not ok then return nil end

    local best = nil
    local bestTime = math.huge

    for _, part in ipairs(parts) do
        local pos = part.Position
        local v = part.AssemblyLinearVelocity

        -- anchored / tweened bullets: work out the speed from how far it moved
        if v.Magnitude < BulletSpeed then
            local lastPos = bulletLastPos[part]
            local lastTime = bulletLastTime[part]
            if lastPos and lastTime and now - lastTime > 0.005 then
                v = (pos - lastPos) / (now - lastTime)
            end
        end
        bulletLastPos[part] = pos
        bulletLastTime[part] = now

        local speed = v.Magnitude
        if speed >= BulletSpeed and part.Size.Magnitude <= BulletMaxSize then
            local model = part:FindFirstAncestorOfClass("Model")
            local skip = model and (model.Name == "AIDodgeGhost" or model:FindFirstChildOfClass("Humanoid"))

            if not skip then
                local dir = v / speed
                local toMe = root.Position - pos
                local along = toMe:Dot(dir)

                if along > 0 then
                    local lateral = toMe - dir * along
                    local tti = along / speed

                    if lateral.Magnitude < BulletMiss and tti < BulletReact and tti < bestTime then
                        -- step off the line of fire
                        local away = Vector3.new(lateral.X, 0, lateral.Z)
                        if away.Magnitude < 0.5 then
                            local sign = (math.random(1, 2) == 1) and 1 or -1
                            away = Vector3.new(-dir.Z, 0, dir.X) * sign
                        end
                        if away.Magnitude > 0.01 then
                            bestTime = tti
                            best = {kind = "bullet", away = away.Unit, anim = false}
                        end
                    end
                end
            end
        end
    end

    return best
end

-- RANDOM decision:
--   punch  -> always a dodge (side / hawk back / duck)
--   heavy  -> dash (mostly) or dodge
--   bullet -> step off the line: dash (mostly) or dodge (side lean / duck)
local function react(root, threat)
    if threat.kind == "punch" then
        performKind(root, threat.away, pickDodgeKind(root, threat.away), "DODGE", 0.35)

    elseif threat.kind == "heavy" then
        if math.random() < HeavyDashChance then
            perform(slipDirection(root, threat.away, 0.8), "side", "DASH")
        else
            performKind(root, threat.away, pickDodgeKind(root, threat.away), "DODGE", 0.35)
        end

    else
        local localDir = root.CFrame:VectorToObjectSpace(threat.away)
        if math.random() < BulletDashChance then
            perform(localDir, "side", "DASH")
        elseif math.random(1, 3) == 1 then
            perform(Vector3.new(0, 0, -1), "duck", "DODGE")
        else
            perform(localDir, "side", "DODGE")
        end
    end
end

-- heavy attacks (seen from the animation) get a tiny delay so you dodge closer to the hit
local function reactRandom(root, threat)
    if threat.kind == "heavy" and threat.anim and HeavyDelay > 0 then
        Pending = true
        task.delay(HeavyDelay, function()
            Pending = false
            local _, r = getCharacter()
            if Enabled and r then
                react(r, threat)
            end
        end)
    else
        react(root, threat)
    end
end

local autoLoop = RunService.Heartbeat:Connect(function()
    if not Enabled or Busy or Pending then return end

    local humanoid, root = getCharacter()
    if not humanoid then return end

    -- RANDOM mode: read the threat first
    if Mode == "RANDOM" then
        local threat = scanBullet(Player.Character, root) or scanThreat(root)
        if threat then
            reactRandom(root, threat)
        end
        return
    end

    -- DASH / DODGE mode
    local bestDist = math.huge
    local bestDir = nil

    for _, other in ipairs(Players:GetPlayers()) do
        if other ~= Player and other.Character then
            local oHumanoid = other.Character:FindFirstChildOfClass("Humanoid")
            local oRoot = other.Character:FindFirstChild("HumanoidRootPart")

            if oHumanoid and oHumanoid.Health > 0 and oRoot then
                local offset = root.Position - oRoot.Position
                local flat = Vector3.new(offset.X, 0, offset.Z)
                local dist = flat.Magnitude

                if dist < Range and dist > 0.1 and dist < bestDist then
                    local toMe = flat.Unit
                    local closing = oRoot.AssemblyLinearVelocity:Dot(toMe)
                    local facing = oRoot.CFrame.LookVector:Dot(toMe)

                    if facing > 0.5 and (closing > ApproachSpeed or dist < Range * 0.5) then
                        bestDist = dist
                        bestDir = toMe
                    end
                end
            end
        end
    end

    if bestDir then
        local kind = "side"
        if Mode == "DODGE" then
            kind = pickDodgeKind(root, bestDir)
        end
        performKind(root, bestDir, kind, nil, 0.35)
    end
end)

-- cleanup if the UI is removed (e.g. script re-run)
gui.Destroying:Connect(function()
    autoLoop:Disconnect()
    ringLoop:Disconnect()
    ring:Destroy()
    pcall(restoreJoints)
    pcall(hulkInstantOff)
    pcall(iframesReset)
    hulkRemoving:Disconnect()
end)

notify("Loaded! Tap the AD icon (right side) to hide/show the panel.")

end -- main

local ok, err = xpcall(main, function(e)
    return tostring(e) .. "\n" .. debug.traceback()
end)

if not ok then
    warn("[AI Dodge] ERROR: " .. tostring(err))
    notify("Error: " .. tostring(err):sub(1, 140))
end
