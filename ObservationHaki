---------------------------------------------------------------------
-- AUTO DODGE (enemy detection)
---------------------------------------------------------------------

local lastScan = 0
local lastSide = 1

-- true if nothing solid is in the way of a dash in this direction
local function pathClear(character, root, dir, distance)
    local params = RaycastParams.new()
    params.FilterDescendantsInstances = {character}
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.RespectCanCollide = true
    return workspace:Raycast(root.Position, dir * (distance + 1.5), params) == nil
end

-- closest enemy that is inside the circle AND coming at you (or very close)
local function findThreat(root)
    local best, bestDist = nil, math.huge

    for _, other in ipairs(Players:GetPlayers()) do
        local sameTeam = IgnoreTeammates and Player.Team ~= nil and other.Team == Player.Team

        if other ~= Player and not sameTeam then
            local char = other.Character
            local eHum = char and char:FindFirstChildOfClass("Humanoid")
            local eRoot = char and char:FindFirstChild("HumanoidRootPart")

            if eHum and eRoot and eHum.Health > 0 then
                local offset = root.Position - eRoot.Position
                local flat = Vector3.new(offset.X, 0, offset.Z)
                local dist = flat.Magnitude

                if dist <= Range and dist > 0.01 and math.abs(offset.Y) <= 10 then
                    local v = eRoot.AssemblyLinearVelocity
                    local approach = Vector3.new(v.X, 0, v.Z):Dot(flat.Unit)

                    if (approach >= ApproachSpeed or dist <= VeryClose) and dist < bestDist then
                        best, bestDist = eRoot, dist
                    end
                end
            end
        end
    end

    return best
end

-- sidestep (slightly backward) away from the enemy's line of approach, in WORLD space
local function pickDirection(character, root, eRoot)
    local toEnemy = eRoot.Position - root.Position
    toEnemy = Vector3.new(toEnemy.X, 0, toEnemy.Z)
    if toEnemy.Magnitude < 0.01 then return end
    toEnemy = toEnemy.Unit

    local sideAxis = Vector3.new(-toEnemy.Z, 0, toEnemy.X)

    -- dodge away from the side the enemy is drifting toward; if they come straight, alternate
    local v = eRoot.AssemblyLinearVelocity
    local lateral = v.X * sideAxis.X + v.Z * sideAxis.Z
    local side
    if math.abs(lateral) > 1 then
        side = lateral > 0 and -1 or 1
    else
        lastSide = -lastSide
        side = lastSide
    end

    for _, s in ipairs({side, -side}) do
        local dir = sideAxis * s - toEnemy * BackBias
        if dir.Magnitude > 0.01 then
            dir = dir.Unit
            if pathClear(character, root, dir, DashDistance) then
                return dir
            end
        end
    end
    -- walls on both sides: skip this dodge
end

table.insert(connections, RunService.Heartbeat:Connect(function()
    local humanoid, root = getCharacter()

    -- range circle follows your feet
    if humanoid and root and ShowCircle then
        circle.Transparency = 0.82
        circle.Size = Vector3.new(0.1, Range * 2, Range * 2)
        local down = feetOffset(humanoid, root) - 0.15
        circle.CFrame = CFrame.new(root.Position - Vector3.new(0, down, 0)) * CFrame.Angles(0, 0, math.pi / 2)
    else
        circle.Transparency = 1
    end

    if not Enabled or Busy or not humanoid or not root then return end

    local now = os.clock()
    if now - lastScan < ScanRate then return end
    lastScan = now

    local threat = findThreat(root)
    if not threat then return end

    local dir = pickDirection(Player.Character, root, threat)
    if dir then
        perform(root.CFrame:VectorToObjectSpace(dir))
    end
end))

-- new body after respawn: never stay stuck on cooldown
table.insert(connections, Player.CharacterAdded:Connect(function()
    Busy = false
end))

