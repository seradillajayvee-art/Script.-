local function clearOldUi()
    local places = {}

    if gethui then
        local ok, ui = pcall(gethui)
        if ok and ui then
            table.insert(places, ui)
        end
    end

    pcall(function()
        table.insert(places, game:GetService("CoreGui"))
    end)

    local pg = Player:FindFirstChildOfClass("PlayerGui")
    if pg then
        table.insert(places, pg)
    end

    for _, place in ipairs(places) do
        pcall(function()
            local old = place:FindFirstChild("AIDodgeUI")
            if old then
                old:Destroy()
            end
        end)
    end
end

local function getGuiParents()
    local list = {}

    if HideUi then
        if gethui then
            local ok, ui = pcall(gethui)
            if ok and ui then
                table.insert(list, ui)
            end
        end
        pcall(function()
            table.insert(list, game:GetService("CoreGui"))
        end)
    end

    local pg = Player:FindFirstChildOfClass("PlayerGui") or Player:WaitForChild("PlayerGui", 10)
    if pg then
        table.insert(list, pg)
    end

    return list
end

