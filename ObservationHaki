-- fast start, smooth stop; total distance = distance
local function slide(root, humanoid, worldDir, distance, duration, onStep)
    local speed = distance / duration
    local startTime = os.clock()

    local conn
    conn = RunService.Heartbeat:Connect(function()
        local t = os.clock() - startTime
        if t >= duration or humanoid.Health <= 0 or not root.Parent then
            conn:Disconnect()
            return
        end

        local mult = 2 * (1 - t / duration)
        local v = root.AssemblyLinearVelocity
        root.AssemblyLinearVelocity = Vector3.new(worldDir.X * speed * mult, v.Y, worldDir.Z * speed * mult)

        if onStep then
            onStep(t)
        end
    end)
end

---------------------------------------------------------------------
-- BODY POSES (no animation, just bends the joints)
-- Pitch: degrees around the body's X axis.
--   + = top tips BACK (and the bottom swings FORWARD: knees up, arms forward)
--   - = top tips FORWARD (bow / fold)
---------------------------------------------------------------------

local X_AXIS = Vector3.new(1, 0, 0)
local NO_OFFSET = Vector3.new(0, 0, 0)

-- every Motor6D of the character by name
local function mapJoints(character)
    local map = {}
    for _, d in ipairs(character:GetDescendants()) do
        if d:IsA("Motor6D") and not map[d.Name] then
            map[d.Name] = d
        end
    end
    return map
end

local function isR15(character)
    return character:FindFirstChild("UpperTorso") ~= nil
end

local function addTilt(list, joint, axis, degrees, offset)
    if joint then
        table.insert(list, {
            joint = joint,
            axis = axis,
            angle = math.rad(degrees),
            offset = offset or NO_OFFSET
        })
    end
end

local function addPitch(list, joint, degrees, offset)
    addTilt(list, joint, X_AXIS, degrees, offset)
end

-- original joint position is saved on the joint so it can always be restored
local function baseC0(joint)
    local saved = joint:GetAttribute("AIDodgeC0")
    if typeof(saved) ~= "CFrame" then
        saved = joint.C0
        joint:SetAttribute("AIDodgeC0", saved)
    end
    return saved
end

-- tween into the pose, hold it, then spring back with a little overshoot
local function playPose(entries, tIn, hold, tOut)
    for _, e in ipairs(entries) do
        local base = baseC0(e.joint)
        local rotOnly = base - base.Position
        local target = CFrame.new(base.Position + e.offset) * CFrame.fromAxisAngle(e.axis, e.angle) * rotOnly
        TweenService:Create(e.joint, TweenInfo.new(tIn, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            C0 = target
        }):Play()
    end

    task.wait(tIn + hold)

    for _, e in ipairs(entries) do
        if e.joint.Parent then
            TweenService:Create(e.joint, TweenInfo.new(tOut, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                C0 = baseC0(e.joint)
            }):Play()
        end
    end
end

-- SIDE LEAN: localDir = direction to lean toward (local space, X = right, Z = back)
local function leanPose(character, localDir)
    local j = mapJoints(character)
    local list = {}

    local axis = Vector3.new(0, 1, 0):Cross(localDir)
    if axis.Magnitude < 0.01 then return list end
    axis = axis.Unit

    if isR15(character) then
        addTilt(list, j.Root, axis, LeanAngle * 0.3)
        addTilt(list, j.Waist, axis, LeanAngle * 0.7)
    else
        addTilt(list, j.RootJoint, axis, LeanAngle * 0.7)
    end

    return list
end

-- HAWK BACK DODGE: arms hang down, body bends way back from the waist, head keeps looking forward
local function hawkPose(character)
    local j = mapJoints(character)
    local list = {}

    if isR15(character) then
        local rootA = HawkAngle * 0.25
        local waistA = HawkAngle * 0.75

        addPitch(list, j.Root, rootA)
        addPitch(list, j.Waist, waistA)
        addPitch(list, j.Neck, -HawkAngle * 0.6)       -- head comes forward, eyes stay on the enemy
        addPitch(list, j.LeftHip, -rootA)              -- legs stay straight
        addPitch(list, j.RightHip, -rootA)
        addPitch(list, j.LeftShoulder, -HawkAngle)     -- arms drop and hang
        addPitch(list, j.RightShoulder, -HawkAngle)
    else
        local a = math.rad(HawkAngle)
        -- hips get pushed forward a bit as the torso goes back
        addPitch(list, j.RootJoint, HawkAngle, Vector3.new(0, -(1 - math.cos(a)), 0))
        addPitch(list, j.Neck, -HawkAngle * 0.5)
        addPitch(list, j["Left Hip"], -HawkAngle)
        addPitch(list, j["Right Hip"], -HawkAngle)
        addPitch(list, j["Left Shoulder"], -HawkAngle)
        addPitch(list, j["Right Shoulder"], -HawkAngle)
    end

    return list
end

-- DUCK DODGE: knees bent, hips sink back, chest folds forward, guard up
local function duckPose(character)
    local j = mapJoints(character)
    local list = {}

    if isR15(character) then
        local leg = character:FindFirstChild("LeftUpperLeg")
        local thigh = (leg and leg.Size.Y or 1.2) * 0.85   -- hip-to-knee is a bit shorter than the part
        local a = math.rad(DuckKnee)

        -- sink the hips down and back so the feet stay planted
        addPitch(list, j.Root, 0, Vector3.new(0, -thigh * (1 - math.cos(a)), thigh * math.sin(a)))
        addPitch(list, j.LeftHip, DuckKnee)            -- thighs forward
        addPitch(list, j.RightHip, DuckKnee)
        addPitch(list, j.LeftKnee, -DuckKnee)          -- shins stay straight up
        addPitch(list, j.RightKnee, -DuckKnee)
        addPitch(list, j.Waist, -DuckBend)             -- fold forward (nakayuko)
        addPitch(list, j.Neck, DuckBend * 0.7)         -- head comes up, eyes on the enemy
        addPitch(list, j.LeftShoulder, DuckBend + 20)  -- guard
        addPitch(list, j.RightShoulder, DuckBend + 20)
        addPitch(list, j.LeftElbow, 85)
        addPitch(list, j.RightElbow, 85)
    else
        -- R6 legs are one piece (no knees): torso sinks, legs swing forward
        local torsoDeg = DuckBend * 0.8
        local legDeg = 30
        local torso = math.rad(torsoDeg)
        local legA = math.rad(legDeg)
        local offY = -3 + math.cos(torso) + 2 * math.cos(legA)
        local offZ = -math.sin(torso) + 2 * math.sin(legA)

        addPitch(list, j.RootJoint, -torsoDeg, Vector3.new(0, offY, offZ))
        addPitch(list, j.Neck, torsoDeg * 0.7)
        addPitch(list, j["Left Hip"], torsoDeg + legDeg)
        addPitch(list, j["Right Hip"], torsoDeg + legDeg)
        addPitch(list, j["Left Shoulder"], torsoDeg + 20)
        addPitch(list, j["Right Shoulder"], torsoDeg + 20)
    end

    return list
end

local function restoreJoints()
    local character = Player.Character
    if not character then return end
    for _, d in ipairs(character:GetDescendants()) do
        if d:IsA("Motor6D") then
            local saved = d:GetAttribute("AIDodgeC0")
            if typeof(saved) == "CFrame" then
                d.C0 = saved
            end
        end
    end
end

local function dashMove(character, humanoid, root, worldDir)
    local feet = getFeet(character, humanoid, root)

    pcall(mirage, character)
    pcall(groundBurst, feet, 7)
    pcall(smoke, feet, 14)
    pcall(ribbon, root, DashTime)
    pcall(fovPulse)
    pcall(screenFx)

    local last = 0
    local count = 0
    slide(root, humanoid, worldDir, DashDistance, DashTime, function(t)
        if t - last >= 0.025 then
            last = t
            count = count + 1
            pcall(trailGhost, character, count % 2 == 0)
        end
    end)
end

-- kind: "side" (lean), "back" (hawk), "duck"
-- returns how long the pose lasts (used for the cooldown)
local function dodgeMove(character, humanoid, root, worldDir, localDir, kind)
    local feet = getFeet(character, humanoid, root)

    pcall(mirage, character)
    pcall(groundBurst, feet, kind == "duck" and 3 or 4)
    pcall(smoke, feet, 8)
    pcall(fovPulse)
    pcall(screenFx)

    local entries = {}
    local tIn, hold, tOut

    if kind == "back" then
        local ok, result = pcall(hawkPose, character)
        entries = ok and result or {}
        tIn, hold, tOut = 0.1, 0.3, 0.3
        slide(root, humanoid, worldDir, DodgeShift * 1.7, 0.14)
    elseif kind == "duck" then
        local ok, result = pcall(duckPose, character)
        entries = ok and result or {}
        tIn, hold, tOut = 0.1, 0.45, 0.3

        -- camera dips with you so the duck feels real
        pcall(function()
            local camBase = humanoid.CameraOffset
            TweenService:Create(humanoid, TweenInfo.new(tIn), {
                CameraOffset = camBase + Vector3.new(0, -0.6, 0)
            }):Play()
            task.delay(tIn + hold, function()
                TweenService:Create(humanoid, TweenInfo.new(tOut), {CameraOffset = camBase}):Play()
            end)
        end)
    else
        local ok, result = pcall(leanPose, character, localDir)
        entries = ok and result or {}
        tIn, hold, tOut = 0.09, 0.19, 0.3
        slide(root, humanoid, worldDir, DodgeShift, 0.12)
    end

    if #entries > 0 then
        task.spawn(function()
            pcall(playPose, entries, tIn, hold, tOut)
        end)
    end

    task.delay(tIn, function()
        pcall(trailGhost, character, true)
    end)

    return tIn + hold + tOut
end

-- direction is in LOCAL space: X = right, Z = backward (forward is -Z)
-- kind: "side" (default), "back" (hawk), "duck"  (back/duck only apply in DODGE mode, duck always ducks)
-- forcedMove: "DASH" or "DODGE" (RANDOM mode uses this); nil = use the current MODE
-- manual buttons in RANDOM mode pick dash or dodge by coin flip
local function perform(direction, kind, forcedMove)
    if Busy then return end

    local humanoid, root = getCharacter()
    if not humanoid or not root then return end

    kind = kind or "side"

    local move = forcedMove or Mode
    if move == "RANDOM" then
        move = (math.random(1, 2) == 1) and "DASH" or "DODGE"
    end

    local localDir = Vector3.new(0, 0, -1)
    local worldDir = Vector3.new(0, 0, 0)

    if kind ~= "duck" then
        local flatLocal = Vector3.new(direction.X, 0, direction.Z)
        if flatLocal.Magnitude < 0.01 then return end
        localDir = flatLocal.Unit

        worldDir = root.CFrame:VectorToWorldSpace(localDir)
        worldDir = Vector3.new(worldDir.X, 0, worldDir.Z)
        if worldDir.Magnitude < 0.01 then return end
        worldDir = worldDir.Unit
    end

    local character = Player.Character
    local cooldown

    Busy = true
    local ok, err = pcall(function()
        if move == "DASH" and kind ~= "duck" then
            cooldown = DashCooldown
            dashMove(character, humanoid, root, worldDir)
        else
            cooldown = DodgeCooldown
            local length = dodgeMove(character, humanoid, root, worldDir, localDir, kind)
            cooldown = math.max(cooldown, length or 0)
        end
    end)

    if not ok then
        warn("[AI Dodge] " .. tostring(err))
    end
    cooldown = cooldown or 0.5

    task.delay(cooldown, function()
        Busy = false
    end)
end

