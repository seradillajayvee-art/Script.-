-- camera rumble
local function shake(humanoid, duration, power)
    local base = humanoid.CameraOffset
    local startTime = os.clock()
    while os.clock() - startTime < duration and humanoid.Parent do
        humanoid.CameraOffset = base + Vector3.new((math.random() - 0.5) * power, (math.random() - 0.5) * power, 0)
        task.wait()
    end
    humanoid.CameraOffset = base
end

-- grow / shrink the whole body (with a little overshoot)
local function scaleTo(character, target, duration)
    local start = charScale(character)
    local steps = math.max(1, math.floor(duration / 0.03))

    for i = 1, steps do
        local a = TweenService:GetValue(i / steps, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
        local s = math.max(start + (target - start) * a, 0.2)
        local ok = pcall(function()
            character:ScaleTo(s)
        end)
        if not ok then
            return false
        end
        task.wait(0.03)
    end

    pcall(function()
        character:ScaleTo(target)
    end)
    return true
end

