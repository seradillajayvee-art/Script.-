-- UNLOAD
---------------------------------------------------------------------

local function unload()
    Enabled = false
    for _, c in ipairs(connections) do
        pcall(function()
            c:Disconnect()
        end)
    end
    pcall(restoreJoints)
    pcall(function()
        circle:Destroy()
    end)
    pcall(function()
        gui:Destroy()
    end)
end

_G.AIDodgeUnload = unload

button("UNLOAD", 10, 207, 210, unload)

end -- main

local ok, err = pcall(main)
if ok then
    notify("Loaded. Tap the AD icon to hide / show the panel.")
else
    notify("Failed to start: " .. tostring(err))
end
