-- AI DODGE (compact, Delta mobile) - black & gray
-- DASH = quick slip-step, DODGE = body lean. Only reacts to enemies INSIDE the range circle.
if not game:IsLoaded() then game.Loaded:Wait() end

local Players = game:GetService("Players")
local RS = game:GetService("RunService")
local UIS = game:GetService("UserInputService")
local TS = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local Lighting = game:GetService("Lighting")
local SG = game:GetService("StarterGui")
local P = Players.LocalPlayer

-- SETTINGS (tweak these)
local S = {
    Range = 10, RangeMin = 4, RangeMax = 30, RangeStep = 2,
    DashDist = 5, DashTime = 0.12, DashCD = 0.45,
    Lean = 35, Shift = 1.5, DodgeCD = 0.4,
    Approach = 3,    -- enemy must move toward you this fast (studs/s)...
    Close = 5,       -- ...or be this close
    Back = 0.35,     -- 0 = pure sidestep, higher = also steps away
    Scan = 0.05,
    Teams = true,    -- ignore teammates
    Fov = 8,         -- camera FOV pulse, 0 = off
    FX = true,       -- grayscale flash + blur (set false if it lags)
    HideUi = false,  -- false = PlayerGui (always visible)
}

local BLACK = Color3.fromRGB(10, 10, 10)
local DARK = Color3.fromRGB(45, 45, 45)
local GRAY = Color3.fromRGB(120, 120, 120)
local LIGHT = Color3.fromRGB(185, 185, 185)

local function notify(text)
print("[AI Dodge] " .. text)
pcall(function()
SG:SetCore("SendNotification", {Title = "AI Dodge", Text = text, Duration = 6})
end)
end
local function new(class, props, parent)
local i = Instance.new(class)
for k, v in pairs(props) do
i[k] = v
end
i.Parent = parent
return i
end
local function main()
local on, busy, mode, showCircle = false, false, "DASH", true
local conns = {}
local unload, circle
if _G.AIDodgeUnload then
pcall(_G.AIDodgeUnload)
_G.AIDodgeUnload = nil
end
local function containers()
local list = {}
local pg = P:FindFirstChildOfClass("PlayerGui") or P:WaitForChild("PlayerGui", 10)
local function add(f)
local ok, v = pcall(f)
if ok and v then
list[#list + 1] = v
end
end
if S.HideUi then
add(function() return gethui() end)
add(function() return game:GetService("CoreGui") end)
add(function() return pg end)
else
add(function() return pg end)
add(function() return gethui() end)
add(function() return game:GetService("CoreGui") end)
end
return list
end
local places = containers()
for _, par in ipairs(places) do
pcall(function()
local old = par:FindFirstChild("AIDodgeUI")
if old then
old:Destroy()
end
end)
end
local oldCircle = workspace:FindFirstChild("AIDodgeRange")
if oldCircle then
oldCircle:Destroy()
end
local gui = new("ScreenGui", {
Name = "AIDodgeUI", ResetOnSpawn = false, DisplayOrder = 999,
IgnoreGuiInset = true, ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
})
local parented = false
for _, par in ipairs(places) do
local ok = pcall(function()
gui.Parent = par
end)
if ok and gui.Parent == par then
parented = true
break
end
end
if not parented then
error("could not put the UI on screen")
end
local frame = new("Frame", {
Size = UDim2.fromOffset(230, 252), Position = UDim2.new(0, 15, 0.5, -126),
BackgroundColor3 = BLACK, BorderSizePixel = 0, Active = true,
}, gui)
local icon = new("TextButton", {
Size = UDim2.fromOffset(40, 40), Position = UDim2.new(1, -55, 0.5, -20),
BackgroundColor3 = BLACK, BorderSizePixel = 0, Font = Enum.Font.GothamBold,
TextSize = 14, TextColor3 = LIGHT, Text = "AD",
}, gui)
new("UICorner", {CornerRadius = UDim.new(1, 0)}, icon)
icon.Activated:Connect(function()
frame.Visible = not frame.Visible
end)
local title = new("TextLabel", {
Size = UDim2.new(1, 0, 0, 30), Text = "AI AUTO DODGE", Font = Enum.Font.GothamBold,
TextSize = 16, TextColor3 = LIGHT, BackgroundTransparency = 1, Active = true,
}, frame)
local dragging, dragStart, startPos
title.InputBegan:Connect(function(input)
if input.UserInputType == Enum.UserInputType.MouseButton1
or input.UserInputType == Enum.UserInputType.Touch then
dragging, dragStart, startPos = true, input.Position, frame.Position
input.Changed:Connect(function()
if input.UserInputState == Enum.UserInputState.End then
dragging = false
end
end)
end
end)
conns[#conns + 1] = UIS.InputChanged:Connect(function(input)
if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
or input.UserInputType == Enum.UserInputType.Touch) then
local d = input.Position - dragStart
frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X,
startPos.Y.Scale, startPos.Y.Offset + d.Y)
end
end)
local function button(text, x, y, w, callback)
local b = new("TextButton", {
Text = text, Font = Enum.Font.GothamBold, TextSize = 13,
Size = UDim2.fromOffset(w, 35), Position = UDim2.fromOffset(x, y),
BackgroundColor3 = DARK, TextColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0,
}, frame)
b.Activated:Connect(callback)
return b
end
local toggle, modeBtn, circleBtn
toggle = button("AUTO DODGE: OFF", 10, 35, 210, function()
on = not on
toggle.Text = on and "AUTO DODGE: ON" or "AUTO DODGE: OFF"
toggle.BackgroundColor3 = on and GRAY or DARK
end)
modeBtn = button("MODE: DASH", 10, 78, 210, function()
mode = (mode == "DASH") and "DODGE" or "DASH"
modeBtn.Text = (mode == "DASH") and "MODE: DASH" or "MODE: DODGE (LEAN)"
end)
local rangeLabel = new("TextLabel", {
Size = UDim2.fromOffset(110, 35), Position = UDim2.fromOffset(60, 121),
BackgroundColor3 = Color3.fromRGB(25, 25, 25), BorderSizePixel = 0,
Font = Enum.Font.GothamBold, TextSize = 13, TextColor3 = LIGHT,
Text = "RANGE: " .. S.Range,
}, frame)
button("-", 10, 121, 45, function()
S.Range = math.max(S.RangeMin, S.Range - S.RangeStep)
rangeLabel.Text = "RANGE: " .. S.Range
end)
button("+", 175, 121, 45, function()
S.Range = math.min(S.RangeMax, S.Range + S.RangeStep)
rangeLabel.Text = "RANGE: " .. S.Range
end)
circleBtn = button("CIRCLE: ON", 10, 164, 210, function()
showCircle = not showCircle
circleBtn.Text = showCircle and "CIRCLE: ON" or "CIRCLE: OFF"
circleBtn.BackgroundColor3 = showCircle and GRAY or DARK
end)
circleBtn.BackgroundColor3 = GRAY
button("UNLOAD", 10, 207, 210, function()
if unload then
unload()
else
gui:Destroy()
end
end)
local ok, err = pcall(function()
local function me()
local c = P.Character
local h = c and c:FindFirstChildOfClass("Humanoid")
local r = c and c:FindFirstChild("HumanoidRootPart")
if h and r and h.Health > 0 then
return h, r, c
end
end
local function footOff(hum, root)
if hum.RigType == Enum.HumanoidRigType.R6 then
return 3
end
return hum.HipHeight + root.Size.Y / 2
end
local function rayParams(char)
local rp = RaycastParams.new()
rp.FilterDescendantsInstances = {char}
rp.FilterType = Enum.RaycastFilterType.Exclude
return rp
end
local function feet(char, hum, root)
local r = workspace:Raycast(root.Position, Vector3.new(0, -8, 0), rayParams(char))
if r then
return r.Position
end
return root.Position - Vector3.new(0, footOff(hum, root), 0)
end
local function ghost(char, col, line, life, tr)
local m = Instance.new("Model")
m.Name = "AIDodgeGhost"
for _, p in ipairs(char:GetChildren()) do
if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" and p.Transparency < 1 then
local okc, g = pcall(p.Clone, p)
if okc and g then
for _, c in ipairs(g:GetChildren()) do
if c:IsA("SpecialMesh") then
c.TextureId = ""
else
c:Destroy()
end
end
g.Anchored = true
g.CanCollide = false
g.CanQuery = false
g.CanTouch = false
g.Massless = true
g.Material = Enum.Material.SmoothPlastic
g.Color = col
g.Transparency = tr
if g:IsA("MeshPart") then
g.TextureID = ""
end
g.CFrame = p.CFrame
g.Parent = m
TS:Create(g, TweenInfo.new(life, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
{Transparency = 1, Size = g.Size * 0.6}):Play()
end
end
end
local h = new("Highlight", {
Adornee = m, FillTransparency = 1, OutlineColor = line,
OutlineTransparency = 0.1, DepthMode = Enum.HighlightDepthMode.Occluded,
}, m)
m.Parent = workspace
TS:Create(h, TweenInfo.new(life), {OutlineTransparency = 1}):Play()
Debris:AddItem(m, life + 0.1)
end
local function burst(pos, r)
for _, l in ipairs({{BLACK, r, 0.08}, {GRAY, r * 0.6, 0.14}}) do
local d = new("Part", {
Shape = Enum.PartType.Cylinder, Anchored = true, CanCollide = false,
CanQuery = false, CanTouch = false, Material = Enum.Material.SmoothPlastic,
Color = l[1], Transparency = 0.2, Size = Vector3.new(0.12, 1, 1),
CFrame = CFrame.new(pos + Vector3.new(0, l[3], 0)) * CFrame.Angles(0, 0, math.pi / 2),
}, workspace)
TS:Create(d, TweenInfo.new(0.45, Enum.EasingStyle.Quad),
{Size = Vector3.new(0.12, l[2] * 2, l[2] * 2), Transparency = 1}):Play()
Debris:AddItem(d, 0.5)
end
end
local function smoke(pos, n)
local p = new("Part", {
Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false,
Transparency = 1, Size = Vector3.new(1, 1, 1), CFrame = CFrame.new(pos),
}, workspace)
local e = new("ParticleEmitter", {
Texture = "rbxasset://textures/particles/smoke_main.dds",
Color = ColorSequence.new(GRAY, BLACK), Size = NumberSequence.new(1.5, 4),
Transparency = NumberSequence.new(0.35, 1), Lifetime = NumberRange.new(0.4, 0.8),
Speed = NumberRange.new(6, 14), SpreadAngle = Vector2.new(70, 70),
Rotation = NumberRange.new(0, 360), RotSpeed = NumberRange.new(-60, 60), Rate = 0,
}, p)
e:Emit(n)
Debris:AddItem(p, 1.5)
end
local function ribbon(root, dur)
local a0 = new("Attachment", {Position = Vector3.new(0, 1.2, 0)}, root)
local a1 = new("Attachment", {Position = Vector3.new(0, -1.2, 0)}, root)
local t = new("Trail", {
Attachment0 = a0, Attachment1 = a1, Lifetime = 0.4, MinLength = 0.05,
FaceCamera = true, Color = ColorSequence.new(BLACK, GRAY),
Transparency = NumberSequence.new(0.1, 1),
}, root)
task.delay(dur, function()
t.Enabled = false
Debris:AddItem(t, 0.6)
Debris:AddItem(a0, 0.6)
Debris:AddItem(a1, 0.6)
end)
end
local fovBusy = false
local function fov()
local cam = workspace.CurrentCamera
if S.Fov <= 0 or fovBusy or not cam then
return
end
fovBusy = true
local base = cam.FieldOfView
TS:Create(cam, TweenInfo.new(0.07), {FieldOfView = base + S.Fov}):Play()
task.delay(0.07, function()
TS:Create(cam, TweenInfo.new(0.25), {FieldOfView = base}):Play()
task.delay(0.26, function()
fovBusy = false
end)
end)
end
local function screenFx()
if not S.FX then
return
end
local cc = new("ColorCorrectionEffect", {Saturation = -1, Contrast = 0.4, Brightness = -0.08}, Lighting)
TS:Create(cc, TweenInfo.new(0.35), {Saturation = 0, Contrast = 0, Brightness = 0}):Play()
Debris:AddItem(cc, 0.45)
local b = new("BlurEffect", {Size = 8}, Lighting)
TS:Create(b, TweenInfo.new(0.25), {Size = 0}):Play()
Debris:AddItem(b, 0.35)
end
local function slide(root, hum, dir, dist, dur, step)
local sp, t0 = dist / dur, os.clock()
local conn
conn = RS.Heartbeat:Connect(function()
local t = os.clock() - t0
if t >= dur or hum.Health <= 0 or not root.Parent then
conn:Disconnect()
return
end
local m, v = 2 * (1 - t / dur), root.AssemblyLinearVelocity
root.AssemblyLinearVelocity = Vector3.new(dir.X * sp * m, v.Y, dir.Z * sp * m)
if step then
step(t)
end
end)
end
local function leanJoints(char)
local j = {}
local lo, up = char:FindFirstChild("LowerTorso"), char:FindFirstChild("UpperTorso")
if lo and up then
local r, w = lo:FindFirstChild("Root"), up:FindFirstChild("Waist")
if r then j[#j + 1] = {r, 0.3} end
if w then j[#j + 1] = {w, 0.7} end
else
local h = char:FindFirstChild("HumanoidRootPart")
local r = h and h:FindFirstChild("RootJoint")
if r then j[#j + 1] = {r, 0.7} end
end
return j
end
local function baseC0(j)
local s = j:GetAttribute("AIDodgeC0")
if typeof(s) ~= "CFrame" then
s = j.C0
j:SetAttribute("AIDodgeC0", s)
end
return s
end
local function lean(char, ld)
local js = leanJoints(char)
local axis = Vector3.new(0, 1, 0):Cross(ld)
if #js == 0 or axis.Magnitude < 0.01 then
return
end
axis = axis.Unit
for _, e in ipairs(js) do
local c0 = baseC0(e[1])
local rot = c0 - c0.Position
TS:Create(e[1], TweenInfo.new(0.09, Enum.EasingStyle.Quad), {
C0 = CFrame.new(c0.Position) * CFrame.fromAxisAngle(axis, math.rad(S.Lean * e[2])) * rot,
}):Play()
end
task.wait(0.19)
for _, e in ipairs(js) do
if e[1].Parent then
TS:Create(e[1], TweenInfo.new(0.3, Enum.EasingStyle.Back), {C0 = baseC0(e[1])}):Play()
end
end
end
local function restore()
local c = P.Character
if not c then
return
end
for _, e in ipairs(leanJoints(c)) do
local s = e[1]:GetAttribute("AIDodgeC0")
if typeof(s) == "CFrame" then
e[1].C0 = s
end
end
end
local function perform(ld)
if busy then
return
end
local hum, root, char = me()
if not hum then
return
end
ld = Vector3.new(ld.X, 0, ld.Z)
if ld.Magnitude < 0.01 then
return
end
ld = ld.Unit
local wd = root.CFrame:VectorToWorldSpace(ld)
wd = Vector3.new(wd.X, 0, wd.Z)
if wd.Magnitude < 0.01 then
return
end
wd = wd.Unit
busy = true
local dash = (mode == "DASH")
local okp, errp = pcall(function()
local f = feet(char, hum, root)
pcall(ghost, char, BLACK, LIGHT, 0.8, 0.1)
pcall(burst, f, dash and 7 or 4)
pcall(smoke, f, dash and 14 or 8)
pcall(fov)
pcall(screenFx)
if dash then
pcall(ribbon, root, S.DashTime)
local last, n = 0, 0
slide(root, hum, wd, S.DashDist, S.DashTime, function(t)
if t - last >= 0.025 then
last, n = t, n + 1
local alt = (n % 2 == 0)
pcall(ghost, char, alt and GRAY or BLACK, alt and BLACK or GRAY, 0.35, alt and 0.3 or 0.2)
end
end)
else
slide(root, hum, wd, S.Shift, 0.12)
task.spawn(pcall, lean, char, ld)
task.delay(0.09, function()
pcall(ghost, char, GRAY, BLACK, 0.35, 0.3)
end)
end
end)
if not okp then
warn("[AI Dodge] " .. tostring(errp))
end
task.delay(dash and S.DashCD or S.DodgeCD, function()
busy = false
end)
end
circle = new("Part", {
Name = "AIDodgeRange", Shape = Enum.PartType.Cylinder, Anchored = true,
CanCollide = false, CanQuery = false, CanTouch = false, CastShadow = false,
Material = Enum.Material.SmoothPlastic, Color = GRAY, Transparency = 1,
Size = Vector3.new(0.1, S.Range * 2, S.Range * 2),
}, workspace)
local lastScan, lastSide = 0, 1
local function pathClear(char, root, dir, dist)
local rp = rayParams(char)
rp.RespectCanCollide = true
return workspace:Raycast(root.Position, dir * (dist + 1.5), rp) == nil
end
local function findThreat(root)
local best, bestDist = nil, math.huge
for _, other in ipairs(Players:GetPlayers()) do
local mate = S.Teams and P.Team ~= nil and other.Team == P.Team
if other ~= P and not mate then
local ch = other.Character
local eh = ch and ch:FindFirstChildOfClass("Humanoid")
local er = ch and ch:FindFirstChild("HumanoidRootPart")
if eh and er and eh.Health > 0 then
local off = root.Position - er.Position
local flat = Vector3.new(off.X, 0, off.Z)
local dist = flat.Magnitude
if dist <= S.Range and dist > 0.01 and math.abs(off.Y) <= 10 then
local v = er.AssemblyLinearVelocity
local approach = Vector3.new(v.X, 0, v.Z):Dot(flat.Unit)
if (approach >= S.Approach or dist <= S.Close) and dist < bestDist then
best, bestDist = er, dist
end
end
end
end
end
return best
end
local function pickDir(char, root, er)
local to = er.Position - root.Position
to = Vector3.new(to.X, 0, to.Z)
if to.Magnitude < 0.01 then
return
end
to = to.Unit
local side = Vector3.new(-to.Z, 0, to.X)
local v = er.AssemblyLinearVelocity
local lateral = v.X * side.X + v.Z * side.Z
local s
if math.abs(lateral) > 1 then
s = lateral > 0 and -1 or 1
else
lastSide = -lastSide
s = lastSide
end
for _, sg in ipairs({s, -s}) do
local dir = side * sg - to * S.Back
if dir.Magnitude > 0.01 then
dir = dir.Unit
if pathClear(char, root, dir, S.DashDist) then
return dir
end
end
end
end
conns[#conns + 1] = RS.Heartbeat:Connect(function()
local hum, root, char = me()
if hum and showCircle then
circle.Transparency = 0.82
circle.Size = Vector3.new(0.1, S.Range * 2, S.Range * 2)
circle.CFrame = CFrame.new(root.Position - Vector3.new(0, footOff(hum, root) - 0.15, 0))
* CFrame.Angles(0, 0, math.pi / 2)
else
circle.Transparency = 1
end
if not on or busy or not hum then
return
end
local now = os.clock()
if now - lastScan < S.Scan then
return
end
lastScan = now
local threat = findThreat(root)
if not threat then
return
end
local dir = pickDir(char, root, threat)
if dir then
perform(root.CFrame:VectorToObjectSpace(dir))
end
end)
conns[#conns + 1] = P.CharacterAdded:Connect(function()
busy = false
end)
unload = function()
on = false
for _, c in ipairs(conns) do
pcall(function()
c:Disconnect()
end)
end
pcall(restore)
pcall(function()
circle:Destroy()
end)
pcall(function()
gui:Destroy()
end)
end
_G.AIDodgeUnload = unload
end)
if ok then
notify("Loaded! Tap the AD icon to hide / show the panel.")
else
title.Text = "AI DODGE - ERROR"
notify("Error: " .. tostring(err))
end
end
local okMain, errMain = pcall(main)
if not okMain then
notify("Failed to start: " .. tostring(errMain))
end
