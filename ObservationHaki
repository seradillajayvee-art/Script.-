        Font = Enum.Font.GothamBold, TextSize = 11, TextColor3 = TEXT, AutoButtonColor = false, Text = "",
    }, f)
    corner(b, 6)
    local st = stroke(b, accent(), 1, 0.4)
    bindAccent(st, "Color")
    pressFx(b)

    local function refresh()
        b.Text = tostring(getter())
    end

    b.MouseButton1Click:Connect(function()
        local i = table.find(options, getter()) or 0
        setter(options[i % #options + 1])
        refresh()
    end)

    table.insert(refreshers, refresh)
    refresh()
    return f
end

