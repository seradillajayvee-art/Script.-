-- AI DODGE - DELTA MOBILE (Shadow edition: black & gray)
-- MODE: DASH (quick slip-step) / DODGE (body lean, no animation)
-- Auto dodge only reacts to enemies INSIDE the range circle
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UIS = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local Lighting = game:GetService("Lighting")
local StarterGui = game:GetService("StarterGui")
local Player = Players.LocalPlayer
local function notify(text)
    print("[AI Dodge] " .. text)
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = "AI Dodge",
            Text = text,
            Duration = 6
        })
    end)
end
local function main()
-- SETTINGS (tweak these)
local Range = 10              -- auto dodge only triggers inside this circle (studs)
local RangeMin = 4
local RangeMax = 30
local RangeStep = 2
local DashDistance = 5        -- how far the dash goes (studs)
local DashTime = 0.12         -- how long the dash lasts (seconds)
local DashCooldown = 0.45
local LeanAngle = 35          -- degrees the body leans in DODGE mode
local DodgeShift = 1.5        -- tiny slide during the lean (studs)
local DodgeCooldown = 0.4
local ApproachSpeed = 3       -- enemy must move toward you at least this fast (or be very close)
local FovKick = 8             -- camera FOV pulse (0 = off)
local ScreenFX = true         -- quick grayscale flash + blur (set false if it lags)
local HideUi = false          -- false = normal PlayerGui (always visible). true = hidden executor UI
-- COLORS (black & gray only)
local BLACK = Color3.fromRGB(10, 10, 10)
local DARK = Color3.fromRGB(45, 45, 45)
local GRAY = Color3.fromRGB(120, 120, 120)
local LIGHT = Color3.fromRGB(185, 185, 185)
local Enabled = false
local Busy = false
local Mode = "DASH"           -- "DASH" or "DODGE"
local ShowCircle = true
local function getCharacter()
    local character = Player.Character
    if not character then return end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart")
    if humanoid and root and humanoid.Health > 0 then
        return humanoid, root
    end
end
local function feetOffset(humanoid, root)
    if humanoid.RigType == Enum.HumanoidRigType.R6 then
        return 3
    end
    return humanoid.HipHeight + root.Size.Y / 2
end
local function getFeet(character, humanoid, root)
    local params = RaycastParams.new()
    params.FilterDescendantsInstances = {character}
    params.FilterType = Enum.RaycastFilterType.Exclude
    local result = workspace:Raycast(root.Position, Vector3.new(0, -8, 0), params)
    if result then
        return result.Position
    end
    return root.Position - Vector3.new(0, feetOffset(humanoid, root), 0)
end
-- EFFECTS (black & gray)
local function makeGhost(character, bodyColor, outlineColor, life, startTransparency)
    local model = Instance.new("Model")
    model.Name = "AIDodgeGhost"
    for _, part in ipairs(character:GetChildren()) do
        if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" and part.Transparency < 1 then
            local ok, ghost = pcall(function()
                return part:Clone()
            end)
            if ok and ghost then
                ghost:ClearAllChildren()
                ghost.Anchored = true
                ghost.CanCollide = false
                ghost.CanQuery = false
                ghost.CanTouch = false
                ghost.Massless = true
                ghost.Material = Enum.Material.SmoothPlastic
                ghost.Color = bodyColor
                ghost.Transparency = startTransparency
                if ghost:IsA("MeshPart") then
                    ghost.TextureID = ""
                end
                ghost.CFrame = part.CFrame
                ghost.Parent = model
                TweenService:Create(ghost, TweenInfo.new(life, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
                    Transparency = 1,
                    Size = ghost.Size * 0.6
                }):Play()
            end
        end
    end
    local hl = Instance.new("Highlight")
    hl.Adornee = model
    hl.FillTransparency = 1
    hl.OutlineColor = outlineColor
    hl.OutlineTransparency = 0.1
    hl.DepthMode = Enum.HighlightDepthMode.Occluded
    hl.Parent = model
    model.Parent = workspace
    TweenService:Create(hl, TweenInfo.new(life), {OutlineTransparency = 1}):Play()
    Debris:AddItem(model, life + 0.1)
end
-- the "mirage": a black silhouette left standing where you were
local function mirage(character)
    makeGhost(character, BLACK, LIGHT, 0.8, 0.1)
end
-- trail ghosts alternate black / gray
local function trailGhost(character, alt)
    if alt then
        makeGhost(character, GRAY, BLACK, 0.35, 0.3)
    else
        makeGhost(character, BLACK, GRAY, 0.35, 0.2)
    end
end
-- flat black + gray shockwave on the ground
local function groundBurst(position, radius)
    local layers = {
        {color = BLACK, size = radius, height = 0.08},
        {color = GRAY, size = radius * 0.6, height = 0.14},
    }
    for _, layer in ipairs(layers) do
        local disc = Instance.new("Part")
        disc.Shape = Enum.PartType.Cylinder
        disc.Anchored = true
        disc.CanCollide = false
        disc.CanQuery = false
        disc.CanTouch = false
        disc.Material = Enum.Material.SmoothPlastic
        disc.Color = layer.color
        disc.Transparency = 0.2
        disc.Size = Vector3.new(0.12, 1, 1)
        disc.CFrame = CFrame.new(position + Vector3.new(0, layer.height, 0)) * CFrame.Angles(0, 0, math.pi / 2)
        disc.Parent = workspace
        TweenService:Create(disc, TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Size = Vector3.new(0.12, layer.size * 2, layer.size * 2),
            Transparency = 1
        }):Play()
        Debris:AddItem(disc, 0.5)
    end
end
-- gray / black smoke puff
local function smoke(position, amount)
    local p = Instance.new("Part")
    p.Anchored = true
    p.CanCollide = false
    p.CanQuery = false
    p.CanTouch = false
    p.Transparency = 1
    p.Size = Vector3.new(1, 1, 1)
    p.CFrame = CFrame.new(position)
    p.Parent = workspace
    local e = Instance.new("ParticleEmitter")
    e.Texture = "rbxasset://textures/particles/smoke_main.dds"
    e.Color = ColorSequence.new(GRAY, BLACK)
    e.Size = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 1.5),
        NumberSequenceKeypoint.new(1, 4)
    })
    e.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.35),
        NumberSequenceKeypoint.new(1, 1)
    })
    e.Lifetime = NumberRange.new(0.4, 0.8)
    e.Speed = NumberRange.new(6, 14)
    e.SpreadAngle = Vector2.new(70, 70)
    e.Rotation = NumberRange.new(0, 360)
    e.RotSpeed = NumberRange.new(-60, 60)
    e.Rate = 0
    e.Parent = p
    e:Emit(amount)
    Debris:AddItem(p, 1.5)
end
-- ribbon trail on your body during the dash
local function ribbon(root, duration)
    local a0 = Instance.new("Attachment")
    a0.Position = Vector3.new(0, 1.2, 0)
    a0.Parent = root
    local a1 = Instance.new("Attachment")
    a1.Position = Vector3.new(0, -1.2, 0)
    a1.Parent = root
    local tr = Instance.new("Trail")
    tr.Attachment0 = a0
    tr.Attachment1 = a1
    tr.Lifetime = 0.4
    tr.MinLength = 0.05
    tr.FaceCamera = true
    tr.Color = ColorSequence.new(BLACK, GRAY)
    tr.Transparency = NumberSequence.new(0.1, 1)
    tr.Parent = root
    task.delay(duration, function()
        tr.Enabled = false
        Debris:AddItem(tr, 0.6)
        Debris:AddItem(a0, 0.6)
        Debris:AddItem(a1, 0.6)
    end)
end
local function fovPulse()
    if FovKick <= 0 then return end
    local cam = workspace.CurrentCamera
    if not cam then return end
    local base = cam.FieldOfView
    TweenService:Create(cam, TweenInfo.new(0.07, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        FieldOfView = base + FovKick
    }):Play()
    task.delay(0.07, function()
        TweenService:Create(cam, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            FieldOfView = base
        }):Play()
    end)
end
-- quick grayscale flash + blur
local function screenFx()
    if not ScreenFX then return end
    local cc = Instance.new("ColorCorrectionEffect")
    cc.Name = "AIDodgeCC"
    cc.Saturation = -1
    cc.Contrast = 0.4
    cc.Brightness = -0.08
    cc.Parent = Lighting
    TweenService:Create(cc, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Saturation = 0,
        Contrast = 0,
        Brightness = 0
    }):Play()
    Debris:AddItem(cc, 0.45)
    local blur = Instance.new("BlurEffect")
    blur.Name = "AIDodgeBlur"
    blur.Size = 8
    blur.Parent = Lighting
    TweenService:Create(blur, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Size = 0
    }):Play()
    Debris:AddItem(blur, 0.35)
end
-- MOVEMENT
-- fast start, smooth stop; total distance = distance
local function slide(root, humanoid, worldDir, distance, duration, onStep)
    local speed = distance / duration
    local startTime = os.clock()
    local conn
    conn = RunService.Heartbeat:Connect(function()
        local t = os.clock() - startTime
        if t >= duration or humanoid.Health <= 0 or not root.Parent then
            conn:Disconnect()
            return
        end
        local mult = 2 * (1 - t / duration)
        local v = root.AssemblyLinearVelocity
        root.AssemblyLinearVelocity = Vector3.new(worldDir.X * speed * mult, v.Y, worldDir.Z * speed * mult)
        if onStep then
            onStep(t)
        end
    end)
end
-- joints used for the lean (no animation, just tilts the body)
local function getLeanJoints(character)
    local joints = {}
    local lower = character:FindFirstChild("LowerTorso")
    local upper = character:FindFirstChild("UpperTorso")
    if lower and upper then -- R15
        local rootJoint = lower:FindFirstChild("Root")
        local waist = upper:FindFirstChild("Waist")
        if rootJoint then
            table.insert(joints, {joint = rootJoint, share = 0.3})
        end
        if waist then
            table.insert(joints, {joint = waist, share = 0.7})
        end
    else -- R6
        local hrp = character:FindFirstChild("HumanoidRootPart")
        local rootJoint = hrp and hrp:FindFirstChild("RootJoint")
        if rootJoint then
            table.insert(joints, {joint = rootJoint, share = 0.7})
        end
    end
    return joints
end
-- original joint position is saved on the joint so it can always be restored
local function baseC0(joint)
    local saved = joint:GetAttribute("AIDodgeC0")
    if typeof(saved) ~= "CFrame" then
        saved = joint.C0
        joint:SetAttribute("AIDodgeC0", saved)
    end
    return saved
end
local function rotatedC0(c0, axis, angle)
    local rotOnly = c0 - c0.Position
    return CFrame.new(c0.Position) * CFrame.fromAxisAngle(axis, angle) * rotOnly
end
-- localDir = direction to lean toward (local space, X = right, Z = back)
local function leanBody(character, localDir)
    local joints = getLeanJoints(character)
    if #joints == 0 then return end
    local axis = Vector3.new(0, 1, 0):Cross(localDir)
    if axis.Magnitude < 0.01 then return end
    axis = axis.Unit
    for _, j in ipairs(joints) do
        local target = rotatedC0(baseC0(j.joint), axis, math.rad(LeanAngle * j.share))
        TweenService:Create(j.joint, TweenInfo.new(0.09, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            C0 = target
        }):Play()
    end
    task.wait(0.19)
    -- springs back with a little overshoot (the "lean lean" feel)
    for _, j in ipairs(joints) do
        if j.joint.Parent then
            TweenService:Create(j.joint, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                C0 = baseC0(j.joint)
            }):Play()
        end
    end
end
local function restoreJoints()
    local character = Player.Character
    if not character then return end
    for _, j in ipairs(getLeanJoints(character)) do
        local saved = j.joint:GetAttribute("AIDodgeC0")
        if typeof(saved) == "CFrame" then
            j.joint.C0 = saved
        end
    end
end
local function dashMove(character, humanoid, root, worldDir)
    local feet = getFeet(character, humanoid, root)
    pcall(mirage, character)
    pcall(groundBurst, feet, 7)
    pcall(smoke, feet, 14)
    pcall(ribbon, root, DashTime)
    pcall(fovPulse)
    pcall(screenFx)
    local last = 0
    local count = 0
    slide(root, humanoid, worldDir, DashDistance, DashTime, function(t)
        if t - last >= 0.025 then
            last = t
            count = count + 1
            pcall(trailGhost, character, count % 2 == 0)
        end
    end)
end
local function dodgeMove(character, humanoid, root, worldDir, localDir)
    local feet = getFeet(character, humanoid, root)
    pcall(mirage, character)
    pcall(groundBurst, feet, 4)
    pcall(smoke, feet, 8)
    pcall(fovPulse)
    pcall(screenFx)
    slide(root, humanoid, worldDir, DodgeShift, 0.12)
    task.spawn(function()
        pcall(leanBody, character, localDir)
    end)
    task.delay(0.09, function()
        pcall(trailGhost, character, true)
    end)
end
-- direction is in LOCAL space: X = right, Z = backward (forward is -Z)
local function perform(direction)
    if Busy then return end
    local humanoid, root = getCharacter()
    if not humanoid or not root then return end
    local flatLocal = Vector3.new(direction.X, 0, direction.Z)
    if flatLocal.Magnitude < 0.01 then return end
    local localDir = flatLocal.Unit
    local worldDir = root.CFrame:VectorToWorldSpace(localDir)
    worldDir = Vector3.new(worldDir.X, 0, worldDir.Z)
    if worldDir.Magnitude < 0.01 then return end
    worldDir = worldDir.Unit
    local character = Player.Character
    local cooldown
    Busy = true
    local ok, err = pcall(function()
        if Mode == "DASH" then
            cooldown = DashCooldown
            dashMove(character, humanoid, root, worldDir)
        else
            cooldown = DodgeCooldown
            dodgeMove(character, humanoid, root, worldDir, localDir)
        end
    end)
    if not ok then
        warn("[AI Dodge] " .. tostring(err))
    end
    cooldown = cooldown or 0.5
    task.delay(cooldown, function()
        Busy = false
    end)
end
-- UI
local function clearOldUi()
    local places = {}
    if gethui then
        local ok, ui = pcall(gethui)
        if ok and ui then
            table.insert(places, ui)
        end
    end
    pcall(function()
        table.insert(places, game:GetService("CoreGui"))
    end)
    local pg = Player:FindFirstChildOfClass("PlayerGui")
    if pg then
        table.insert(places, pg)
    end
    for _, place in ipairs(places) do
        pcall(function()
            local old = place:FindFirstChild("AIDodgeUI")
            if old then
                old:Destroy()
            end
        end)
    end
end
local function getGuiParents()
    local list = {}
    if HideUi then
        if gethui then
            local ok, ui = pcall(gethui)
            if ok and ui then
                table.insert(list, ui)
            end
        end
        pcall(function()
            table.insert(list, game:GetService("CoreGui"))
        end)
    end
    local pg = Player:FindFirstChildOfClass("PlayerGui") or Player:WaitForChild("PlayerGui", 10)
    if pg then
        table.insert(list, pg)
    end
    return list
end
