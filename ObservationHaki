local function gotoTab(name, silent)
    local page = pages[name]
    if not page then return end

    local changed = (currentTab ~= name) or not page.Visible
    for n, p in pairs(pages) do
        p.Visible = (n == name)
    end
    if changed then
        page.Position = UDim2.fromOffset(0, 14)
        tween(page, 0.25, {Position = UDim2.fromOffset(0, 0)}, Enum.EasingStyle.Quint)
    end
    currentTab = name

    local idx = table.find(tabOrder, name)
    if idx then
        lastRealTab = name
        indicator.Visible = true
        tween(indicator, 0.25, {Position = UDim2.fromOffset(0, 52 + (idx - 1) * 38 + 6)}, Enum.EasingStyle.Quint)
    else
        indicator.Visible = false
    end

    for n, b in pairs(tabButtons) do
        local on = (n == name)
        tween(b, 0.2, {TextColor3 = on and accent() or SUB, BackgroundTransparency = on and 0.35 or 1})
    end

    if not silent then
        sfx("click")
    end
end

