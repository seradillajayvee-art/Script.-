local GREEN = Color3.fromRGB(80, 200, 60)
local DARK_GREEN = Color3.fromRGB(20, 70, 20)
local Z_AXIS = Vector3.new(0, 0, 1)

local HulkOn = false
local HulkWorking = false
local hulk = {
    char = nil,
    baseScale = 1,
    colors = {},
    bodyColors = nil,
    shirt = nil,
    tshirt = nil,
    eyes = {},
    aura = nil,
    attrs = {},
    mode = "BODY",
    parts = {},
