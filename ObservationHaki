-- ARM / LEG modes: the WHOLE limb (upper arm, forearm, hand / thigh, shin, foot) turns green
-- and gets fat. Every part grows around its joint, so the limb stays attached to the body.
local function collectParts(character, mode)
    local rig = rigJoints(character)
    local root = getRootPart(character)
    local kind = (mode == "ARM") and "arm" or "leg"
    local roles = (mode == "ARM") and {"shoulder", "elbow", "wrist"} or {"hip", "knee", "ankle"}

    local entries = {}
    local parts = {}

    for _, side in ipairs({"L", "R"}) do
        for i, role in ipairs(roles) do
            local joint = rig[role .. side]
            if joint and joint.Part1 then
                local part = joint.Part1

                local atts = {}
                for _, c in ipairs(part:GetChildren()) do
                    if c:IsA("Attachment") then
                        atts[c] = c.Position
                    end
                end

                -- joints that hang off this part (elbow / wrist / ankle / tool grip)
                local children = {}
                for _, d in ipairs(character:GetDescendants()) do
                    if d:IsA("JointInstance") and d.Part0 == part and d ~= joint then
                        table.insert(children, {joint = d, c00 = d.C0})
                    end
                end

                -- the first part of the limb also slides outward so a fat limb doesn't sink into the body
                local spreadDir = nil
                if i == 1 and root and joint.Part0 then
                    local sign = (side == "R") and 1 or -1
                    spreadDir = joint.Part0.CFrame:VectorToObjectSpace(root.CFrame.RightVector * sign)
                end

                table.insert(entries, {
                    part = part, joint = joint, kind = kind, side = side,
                    size0 = part.Size, c10 = joint.C1, c00 = joint.C0,
                    spreadDir = spreadDir, atts = atts, children = children
                })
                table.insert(parts, part)
            end
        end
    end

    return entries, parts
end

-- fat: x and z grow by s. A little longer too (HulkLimbLength: 0 = only fat, 0.2 = a bit bigger overall)
local function limbScale(s)
    return s, 1 + (s - 1) * HulkLimbLength, s
end

-- s = 1 is normal. Scales the part, the point where it joins the body, the joints hanging off it
-- and its attachments, all in the part's own axes (same idea as Model:ScaleTo, but per limb).
local function applyPartScale(entry, s)
    local part = entry.part
    if not part or not part.Parent then return end

    local fx, fy, fz = limbScale(s)
    local size0 = entry.size0
    part.Size = Vector3.new(size0.X * fx, size0.Y * fy, size0.Z * fz)

    local p = entry.c10.Position
    entry.joint.C1 = CFrame.new(p.X * fx, p.Y * fy, p.Z * fz) * (entry.c10 - p)

    if entry.spreadDir then
        local c0 = entry.c00
        local grow = (fx - 1) * size0.X * 0.5
        entry.joint.C0 = CFrame.new(c0.Position + entry.spreadDir * grow) * (c0 - c0.Position)
        entry.joint:SetAttribute("AIDodgeC0", nil) -- dodge poses re-read the new joint position
    end

    for _, c in ipairs(entry.children) do
        if c.joint.Parent then
            local q = c.c00.Position
            c.joint.C0 = CFrame.new(q.X * fx, q.Y * fy, q.Z * fz) * (c.c00 - q)
            c.joint:SetAttribute("AIDodgeC0", nil)
        end
    end

    for att, pos in pairs(entry.atts) do
        if att.Parent then
            att.Position = Vector3.new(pos.X * fx, pos.Y * fy, pos.Z * fz)
        end
    end
end

-- animate the growth (with a little overshoot). Longer legs lift the body so the feet don't sink.
local function growParts(humanoid, entries, fromS, toS, duration)
    local steps = math.max(1, math.floor(duration / 0.03))

    local function apply(s)
        local _, fy = limbScale(s)
        local legs = {}
        for _, e in ipairs(entries) do
            applyPartScale(e, s)
            if e.kind == "leg" then
                legs[e.side] = (legs[e.side] or 0) + e.size0.Y * (fy - 1)
            end
        end

        local extra = 0
        for _, v in pairs(legs) do
            extra = math.max(extra, v)
        end
        if humanoid.Parent and hulk.hipBase then
            humanoid.HipHeight = hulk.hipBase + extra
        end
    end

    for i = 1, steps do
        local a = TweenService:GetValue(i / steps, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
        apply(math.max(fromS + (toS - fromS) * a, 0.2))
        task.wait(0.03)
    end
    apply(toS)
end

-- the pose for ARM (fists up, ready to smash) and LEG (big stomp)
local function hulkPartPose(character, mode)
    local rig = rigJoints(character)
    local list = newPose(character)

    if mode == "ARM" then
        addPitch(list, rig.waist, 12)
        addPitch(list, rig.neck, -10)
        addPitch(list, rig.shoulderL, 150)
        addPitch(list, rig.shoulderR, 150)
    else
        addPitch(list, rig.hipR, 70)
        addPitch(list, rig.kneeR, -50)
        addTilt(list, rig.shoulderR, Z_AXIS, 40)
        addTilt(list, rig.shoulderL, Z_AXIS, -40)
    end

    return list
end

-- put everything back (no animation)
local function restoreLook(character)
    pcall(removeEyes)

    if hulk.aura then
        pcall(function()
            hulk.aura:Destroy()
        end)
        hulk.aura = nil
    end

    pcall(setDamage, nil, false)

    -- HAND / FEET growth
    for _, e in ipairs(hulk.parts) do
        pcall(applyPartScale, e, 1)
    end
    hulk.parts = {}

    if character and hulk.char == character then
        local hum = character:FindFirstChildOfClass("Humanoid")
        if hum and hulk.hipBase then
            hum.HipHeight = hulk.hipBase
        end
        pcall(paintSkin, character, false)
        pcall(ripShirt, character, false)
    end

    hulk.hipBase = nil
    hulk.colors = {}
    hulk.bodyColors = nil
    hulk.shirt = nil
    hulk.tshirt = nil
end

-- used when the script is re-run / UI removed
local function hulkInstantOff()
    local character = Player.Character
    restoreLook(character)
    if character and hulk.char == character and hulk.mode == "BODY" then
        pcall(function()
            character:ScaleTo(hulk.baseScale)
        end)
    end
    hulk.char = nil
    HulkOn = false
end

local function waitForIdle()
    local waited = 0
    while Busy and waited < 1 do
        task.wait(0.05)
        waited = waited + 0.05
    end
end

local function hulkOn()
    local humanoid, root = getCharacter()
    if not humanoid or not root then return end
    local character = Player.Character
    local mode = HulkMode

    if ShadowOn and shadowOff then
        shadowOff() -- one form at a time
    end

    waitForIdle()
    Busy = true

    local ok, err = pcall(function()
        hulk.char = character
        hulk.mode = mode
        hulk.baseScale = charScale(character)
        hulk.hipBase = humanoid.HipHeight
        hulkStatus("Transforming...")

        local feet = getFeet(character, humanoid, root)

        -- 1) charge up: rumble, aura, shockwave
        hulk.aura = makeAura(root)
        sfx("boom", 1, 0.7)
        task.spawn(function()
            pcall(shake, humanoid, 0.8, 0.5)
        end)
        pcall(fovPulse, 14)
        pcall(groundBurst, feet, 6, DARK_GREEN, GREEN)
        task.wait(0.5)

        -- 2) the change
        pcall(greenFlash)
        pcall(groundBurst, feet, 14, DARK_GREEN, GREEN)
        pcall(smoke, feet, 26, GREEN, DARK_GREEN)

        local boosted = 0
        if mode == "BODY" then
            -- whole body: shirt rips, skin turns green, everything grows
            pcall(ripShirt, character, true)
            pcall(paintSkin, character, true)
            local okD, n = pcall(setDamage, character, true)
            boosted = okD and n or 0
            if not scaleTo(character, hulk.baseScale * HulkScale, 0.6) then
                notify("Could not resize this character")
            end
            pcall(addEyes, character)  -- red eyes
            sfx("roar", 1, 0.5)
        else
            -- only the arms (or legs) turn green and get fat
            local entries, parts = collectParts(character, mode)
            if #entries == 0 then
                error("no " .. string.lower(mode) .. " found on this rig")
            end
            hulk.parts = entries
            hulk.partS = HulkPartScale
            pcall(paintSkin, character, true, parts)
            local okD, n = pcall(setDamage, character, true)
            boosted = okD and n or 0
            growParts(humanoid, entries, 1, HulkPartScale, 0.6)
        end

        -- 3) roar (body) / smash (arms) / stomp (legs)
        task.spawn(function()
            pcall(shake, humanoid, 0.6, 0.35)
        end)
        pcall(fovPulse, 10)

        local okPose, entries = pcall(function()
            if mode == "BODY" then
                return hulkPose(character)
            end
            return hulkPartPose(character, mode)
        end)

        if okPose and #entries > 0 then
            if mode == "BODY" then
                playPose(entries, 0.25, 1.1, 0.4)
            else
                playPose(entries, 0.3, 0.12, 0.12)
                sfx("boom", 1, 0.8)
                pcall(groundBurst, feet, 12, DARK_GREEN, GREEN)
                pcall(smoke, feet, 14, GREEN, DARK_GREEN)
                task.spawn(function()
                    pcall(shake, humanoid, 0.4, 0.5)
                end)
                task.wait(0.3)
            end
        else
            task.wait(1)
        end

        if hulk.aura then
            hulk.aura.Rate = 10
        end

        HulkOn = true
        if boosted > 0 then
            hulkStatus("HULK " .. mode .. " ON - damage x" .. HulkDamage)
        else
            hulkStatus("HULK " .. mode .. " ON. Damage stays normal: the game server decides damage.")
        end
    end)

    Busy = false
    if not ok then
        warn("[AI Dodge] hulk: " .. tostring(err))
        pcall(hulkInstantOff)
        hulkStatus("Error: " .. tostring(err):sub(1, 70))
    end
end

local function hulkOff()
    local humanoid, root = getCharacter()
    local character = Player.Character

    waitForIdle()
    Busy = true

    local ok, err = pcall(function()
        hulkStatus("Reverting...")

        if humanoid and root and hulk.char == character then
            local feet = getFeet(character, humanoid, root)

            if hulk.mode == "BODY" then
                restoreLook(character)
                pcall(groundBurst, feet, 8, DARK_GREEN, GREEN)
                pcall(smoke, feet, 18, GREEN, DARK_GREEN)
                scaleTo(character, hulk.baseScale, 0.45)
            else
                pcall(paintSkin, character, false)
                pcall(groundBurst, feet, 8, DARK_GREEN, GREEN)
                pcall(smoke, feet, 18, GREEN, DARK_GREEN)
                growParts(humanoid, hulk.parts, hulk.partS or HulkPartScale, 1, 0.45)
                restoreLook(character)
            end
        else
            restoreLook(nil)
        end

        hulk.char = nil
        HulkOn = false
        hulkStatus("Ready")
    end)

    Busy = false
    if not ok then
        warn("[AI Dodge] hulk: " .. tostring(err))
        pcall(hulkInstantOff)
        hulkStatus("Error: " .. tostring(err):sub(1, 70))
    end
end

local function hulkToggle()
    if HulkWorking then return end
    HulkWorking = true

    if HulkOn then
        hulkOff()
    else
        hulkOn()
    end

    HulkWorking = false
end

-- changed the PART button while hulked: turn back, then transform again in the new mode
local function hulkSwitch()
    if HulkWorking or not HulkOn then return end
    HulkWorking = true

    hulkOff()
    if not HulkOn then
        hulkOn()
    end

    HulkWorking = false
end

-- SIZE +/- while hulked: re-grow to the new size
local function hulkResize()
    if not HulkOn or HulkWorking then return end

    local humanoid = getCharacter()
    local character = Player.Character
    if not humanoid or hulk.char ~= character then return end

    HulkWorking = true
    pcall(function()
        if hulk.mode == "BODY" then
            pcall(removeEyes) -- eyes are re-made after the resize so they stay on the face
            scaleTo(character, hulk.baseScale * HulkScale, 0.4)
            pcall(addEyes, character)
        else
            growParts(humanoid, hulk.parts, hulk.partS or 1, HulkPartScale, 0.4)
            hulk.partS = HulkPartScale
        end
    end)
    HulkWorking = false
end

