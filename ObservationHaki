local ringLoop = RunService.Heartbeat:Connect(function()
    local humanoid, root = getCharacter()
    if not humanoid or not ShowCircle then
        ring.Visible = false
        return
    end
    if ring.Adornee ~= root then
        ring.Adornee = root
    end
    ring.Radius = Range
    ring.InnerRadius = math.max(Range - 0.3, 0)
    ring.CFrame = CFrame.new(0, -(feetOffset(humanoid, root) - 0.1), 0) * CFrame.Angles(math.pi / 2, 0, 0)
    ring.Visible = true
end)
-- AUTO DODGE: only enemies inside the circle count
local autoLoop = RunService.Heartbeat:Connect(function()
    if not Enabled or Busy then return end
    local humanoid, root = getCharacter()
    if not humanoid then return end
    local bestDist = math.huge
    local bestDir = nil
    for _, other in ipairs(Players:GetPlayers()) do
        if other ~= Player and other.Character then
            local oHumanoid = other.Character:FindFirstChildOfClass("Humanoid")
            local oRoot = other.Character:FindFirstChild("HumanoidRootPart")
            if oHumanoid and oHumanoid.Health > 0 and oRoot then
                local offset = root.Position - oRoot.Position
                local flat = Vector3.new(offset.X, 0, offset.Z)
                local dist = flat.Magnitude
                if dist < Range and dist > 0.1 and dist < bestDist then
                    local toMe = flat.Unit
                    local closing = oRoot.AssemblyLinearVelocity:Dot(toMe)
                    local facing = oRoot.CFrame.LookVector:Dot(toMe)
                    if facing > 0.5 and (closing > ApproachSpeed or dist < Range * 0.5) then
                        bestDist = dist
                        bestDir = toMe
                    end
                end
            end
        end
    end
    if bestDir then
        -- slip sideways and a little away from the attacker
        local sign = (math.random(1, 2) == 1) and 1 or -1
        local perp = Vector3.new(-bestDir.Z, 0, bestDir.X) * sign
        local dir = (perp + bestDir * 0.35).Unit
        perform(root.CFrame:VectorToObjectSpace(dir))
    end
end)
