-- HELPERS: team / friend filter, smart dodge, keys, anti-AFK
---------------------------------------------------------------------

local friendCache = {}

-- is this player a valid target for auto dodge?
local function isEnemy(other)
    if not other or other == Player then return false end

    if IgnoreTeam and Player.Team ~= nil and other.Team == Player.Team then
        return false
    end

    if IgnoreFriends then
        local id = other.UserId
        local known = friendCache[id]
        if known == nil then
            friendCache[id] = false
            task.spawn(function()
                local ok, result = pcall(function()
                    return Player:IsFriendsWith(id)
                end)
                friendCache[id] = ok and result == true
            end)
        elseif known then
            return false
        end
    end

    return true
end

-- dodge in the direction you are walking (standing still = back)
local function smartDodge()
    local humanoid, root = getCharacter()
    if not humanoid or not root then return end

    local md = humanoid.MoveDirection
    if md.Magnitude > 0.1 then
        local localDir = root.CFrame:VectorToObjectSpace(md)
        local kind = "side"
        if Mode ~= "DASH" and localDir.Z > 0.7 then
            kind = "back"
        end
        perform(localDir, kind)
    else
        perform(Vector3.new(0, 0, 1), "back")
    end
end

local afkConn = nil
local function setAntiAfk(on)
    if afkConn then
        afkConn:Disconnect()
        afkConn = nil
    end
    if on then
        afkConn = Player.Idled:Connect(function()
            pcall(function()
                local vu = game:GetService("VirtualUser")
                vu:CaptureController()
                vu:ClickButton2(Vector2.new(0, 0))
            end)
        end)
    end
end

-- PC keys: Q smart dodge, E duck, H hulk, X shadow, G hide / show the window
track(UIS.InputBegan:Connect(function(input, processed)
    if processed then return end
    local key = input.KeyCode
    if key == Enum.KeyCode.Q then
        smartDodge()
    elseif key == Enum.KeyCode.E then
        perform(Vector3.new(0, 0, -1), "duck")
    elseif key == Enum.KeyCode.H then
        task.spawn(hulkToggle)
    elseif key == Enum.KeyCode.X then
        task.spawn(shadowToggle)
    elseif key == Enum.KeyCode.G then
        if uiHooks.toggleWindow then
            uiHooks.toggleWindow()
        end
    end
end))

