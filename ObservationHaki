-- ribbon trail on your body during the dash
local function ribbon(root, duration)
    local a0 = Instance.new("Attachment")
    a0.Position = Vector3.new(0, 1.2, 0)
    a0.Parent = root

    local a1 = Instance.new("Attachment")
    a1.Position = Vector3.new(0, -1.2, 0)
    a1.Parent = root

    local tr = Instance.new("Trail")
    tr.Attachment0 = a0
    tr.Attachment1 = a1
    tr.Lifetime = 0.4
    tr.MinLength = 0.05
    tr.FaceCamera = true
    tr.Color = ColorSequence.new(BLACK, GRAY)
    tr.Transparency = NumberSequence.new(0.1, 1)
    tr.Parent = root

    task.delay(duration, function()
        tr.Enabled = false
        Debris:AddItem(tr, 0.6)
        Debris:AddItem(a0, 0.6)
        Debris:AddItem(a1, 0.6)
    end)
end

local function fovPulse(extra)
    local kick = extra or FovKick
    if kick <= 0 then return end
    local cam = workspace.CurrentCamera
    if not cam then return end

    local base = cam.FieldOfView
    TweenService:Create(cam, TweenInfo.new(0.07, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        FieldOfView = base + kick
    }):Play()

    task.delay(0.07, function()
        TweenService:Create(cam, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            FieldOfView = base
        }):Play()
    end)
end

