    {"BlockWhenDown", function() return BlockWhenDown end, function(v) BlockWhenDown = v end},
    {"IgnoreTeam", function() return IgnoreTeam end, function(v) IgnoreTeam = v end},
    {"IgnoreFriends", function() return IgnoreFriends end, function(v) IgnoreFriends = v end},
    {"HulkMode", function() return HulkMode end, function(v) HulkMode = v end},
    {"HulkScale", function() return HulkScale end, function(v) HulkScale = v end},
    {"HulkPartScale", function() return HulkPartScale end, function(v) HulkPartScale = v end},
    {"HulkDamage", function() return HulkDamage end, function(v) HulkDamage = v end},
    {"HulkAuto", function() return HulkAuto end, function(v) HulkAuto = v end},
    {"SoundsOn", function() return SoundsOn end, function(v) SoundsOn = v end},
    {"SoundVolume", function() return SoundVolume end, function(v) SoundVolume = v end},
    {"ScreenFX", function() return ScreenFX end, function(v) ScreenFX = v end},
    {"FovKick", function() return FovKick end, function(v) FovKick = v end},
    {"QuickButton", function() return QuickButton end, function(v) QuickButton = v end},
    {"AntiAfk", function() return AntiAfk end, function(v) AntiAfk = v end},
    {"AccentIndex", function() return AccentIndex end, function(v) AccentIndex = v end},
    {"UiScale", function() return UiScale end, function(v) UiScale = v end},
}

local configDefaults = {}
for _, item in ipairs(configItems) do
    configDefaults[item[1]] = item[2]()
end

local function canUseFiles()
    return type(writefile) == "function" and type(readfile) == "function" and type(isfile) == "function"
end

local function saveConfig(silent)
    if not canUseFiles() then
        if not silent then notify("This executor can't save files") end
        return false
    end

    local data = {}
    for _, item in ipairs(configItems) do
        data[item[1]] = item[2]()
    end

    local ok = pcall(function()
        writefile(ConfigFile, HttpService:JSONEncode(data))
    end)
    if ok and not silent then notify("Settings saved") end
    return ok
end

-- keep loaded values inside their allowed range
local function sanitizeConfig()
    Range = math.clamp(Range, RangeMin, RangeMax)
    HulkScale = math.clamp(HulkScale, HulkScaleMin, HulkScaleMax)
    HulkPartScale = math.clamp(HulkPartScale, HulkPartScaleMin, HulkPartScaleMax)
    HulkDamage = math.clamp(HulkDamage, HulkDamageMin, HulkDamageMax)
    SoundVolume = math.clamp(SoundVolume, 0, 1)
    FovKick = math.clamp(FovKick, 0, 20)
    UiScale = math.clamp(UiScale, 0.7, 1.3)
    AccentIndex = math.clamp(math.floor(AccentIndex), 1, 5)
    if not table.find({"DASH", "DODGE", "RANDOM"}, Mode) then Mode = "DASH" end
    if not table.find({"MIX", "SIDE", "BACK", "DUCK"}, AutoStyle) then AutoStyle = "MIX" end
    if not table.find({"BODY", "ARM", "LEG"}, HulkMode) then HulkMode = "BODY" end
end

local function loadConfig()
    if not canUseFiles() then return false end

    local ok, data = pcall(function()
        if not isfile(ConfigFile) then return nil end
        return HttpService:JSONDecode(readfile(ConfigFile))
    end)
    if not ok or type(data) ~= "table" then return false end

    for _, item in ipairs(configItems) do
        local v = data[item[1]]
        if v ~= nil and type(v) == type(item[2]()) then
            item[3](v)
        end
    end
    sanitizeConfig()
    return true
end

local function resetConfig()
    for _, item in ipairs(configItems) do
        item[3](configDefaults[item[1]])
    end
    setAntiAfk(AntiAfk)
    saveConfig(true)
end

-- auto-save 1.5 s after the last change
local dirtyAt = nil
markDirty = function()
    dirtyAt = os.clock()
end

