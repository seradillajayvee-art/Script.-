local function makeChip(x)
    local chip = Instance.new("TextLabel")
    chip.Position = UDim2.fromOffset(x, 94)
    chip.Size = UDim2.fromOffset(90, 32)
    chip.BackgroundColor3 = Color3.fromRGB(44, 44, 46)
