    tween(closeBtn, FADE_IN, { BackgroundColor3 = BTN_BG })
end
closeBtn.MouseButton1Up:Connect(releaseClose)
closeBtn.MouseLeave:Connect(releaseClose)

switch.Activated:Connect(function()
    enabled = not enabled
    playSound(enabled and "on" or "off")
    tween(switch, SWITCH, { BackgroundColor3 = enabled and GREEN or GRAY })
    tween(knob, SWITCH, { Position = UDim2.fromOffset(enabled and 24 or 2, 2) })
end)

------------------------------------------------------------------
-- MAIN LOOP
------------------------------------------------------------------
local lastScan = 0
RunService.Heartbeat:Connect(function()
    if not enabled then
        setChip("Q", "off")
        setChip("E", "off")
        return
    end

    -- rescan if boxes are missing OR no longer visible (hidden UI counts as gone)
    local stale = not boxes.Q or not boxes.E
        or not boxes.Q.Parent or not boxes.E.Parent
        or not visibleChain(boxes.Q) or not visibleChain(boxes.E)
    if stale and tick() - lastScan > 0.25 then
        lastScan = tick()
        locate()
        wasRed.Q, wasRed.E = false, false
    end

    for letter in pairs(keys) do
        local obj = boxes[letter]
        local red = boxIsRed(obj)
        setChip(letter, obj and (red and "red" or "--") or "none")
        if red and (not wasRed[letter] or tick() - lastPress[letter] > RETRY_DELAY) then
            task.spawn(press, letter, obj)
        end
        wasRed[letter] = red
    end
end)

