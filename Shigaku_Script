local gui = Instance.new("ScreenGui")
gui.Name = "AutoQE"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.DisplayOrder = 999
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.Parent = (gethui and gethui()) or game:GetService("CoreGui")

local sfx = {}
for name, info in pairs(SOUNDS) do
    local s = Instance.new("Sound")
    s.Name = name
    s.SoundId = info.id
    s.Volume = SOUND_VOLUME
    s.PlaybackSpeed = info.speed
    s.Parent = gui
    sfx[name] = s
end

local function playSound(name)
    local s = sfx[name]
    if s then
        pcall(function()
            s.TimePosition = 0
            s:Play()
        end)
    end
end

local function tween(obj, info, goal)
    local t = TweenService:Create(obj, info, goal)
    t:Play()
    return t
end

local function corner(obj, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = radius or UDim.new(1, 0)
    c.Parent = obj
    return c
end

local function viewport()
    local cam = workspace.CurrentCamera
    return cam and cam.ViewportSize or Vector2.new(800, 600)
end

-- CanvasGroup + UIScale so the whole UI fades and scales as one piece
local function newGroup(size)
    local g = Instance.new("CanvasGroup")
    g.AnchorPoint = Vector2.new(0.5, 0.5)
    g.Size = size
    g.BorderSizePixel = 0
    g.GroupTransparency = 1
    g.Visible = false
    g.Parent = gui
    local sc = Instance.new("UIScale")
    sc.Scale = 0.05
    sc.Parent = g
    return g, sc
end

local function popIn(group, sc, fromScale)
    if not group.Visible then
        sc.Scale = fromScale
        group.GroupTransparency = 1
        group.Visible = true
    end
    tween(group, FADE_IN, { GroupTransparency = 0 })
    tween(sc, POP_IN, { Scale = 1 })
end

local function popOut(group, sc, toScale, done)
    tween(group, FADE_OUT, { GroupTransparency = 1 })
    local t = tween(sc, POP_OUT, { Scale = toScale })
    t.Completed:Connect(function(state)
        if state == Enum.PlaybackState.Completed and done then done() end
    end)
end

-- drag + tap detection (works with mouse and touch)
local function makeDraggable(target, opts)
    opts = opts or {}
    local dragging, moved = false, false
    local dragInput, dragStart, startPos

    local function isPointer(input)
        return input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch
    end

    target.InputBegan:Connect(function(input)
        if not isPointer(input) then return end
        dragging, moved = true, false
        dragInput, dragStart, startPos = input, input.Position, target.Position
        if opts.onBegin then opts.onBegin() end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        local ok = (dragInput.UserInputType == Enum.UserInputType.Touch
            and input.UserInputType == Enum.UserInputType.Touch)
            or input.UserInputType == Enum.UserInputType.MouseMovement
        if not ok then return end
        local d = input.Position - dragStart
        if not moved and d.Magnitude > 6 then moved = true end
        if moved then
            target.Position = UDim2.fromOffset(startPos.X.Offset + d.X, startPos.Y.Offset + d.Y)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if not dragging or not isPointer(input) then return end
        if input.UserInputType ~= dragInput.UserInputType then return end
        dragging = false
        if moved then
            if opts.onDrop then opts.onDrop() end
        elseif opts.onTap then
            opts.onTap()
        end
    end)
end

