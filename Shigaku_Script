-- snap to nearest screen edge like AssistiveTouch
local function snapIcon(animate)
    local vp = viewport()
    local half = ICON_SIZE / 2
    local cx = icon.Position.X.Offset
    local cy = icon.Position.Y.Offset
    local x = (cx < vp.X / 2) and (EDGE_MARGIN + half) or (vp.X - EDGE_MARGIN - half)
    local y = math.clamp(cy, EDGE_MARGIN + half, vp.Y - EDGE_MARGIN - half)
    local goal = UDim2.fromOffset(x, y)
    if animate then
        return tween(icon, SNAP, { Position = goal })
    end
    icon.Position = goal
end

------------------------------------------------------------------
-- SHOW / HIDE LOGIC
-- main UI open  -> icon hidden
-- main UI closed -> icon shown
------------------------------------------------------------------
local mainOpen = false
local iconShown = false
local token = 0
local snapTween

local function showIcon()
    iconShown = true
    snapIcon(false)
    popIn(icon, iconScale, 0.05)
end

local function hideIcon()
    if not icon.Visible then return end
    iconShown = false
    popOut(icon, iconScale, 0.05, function()
        if not iconShown then icon.Visible = false end
    end)
end

local function showMain()
    if mainOpen then return end
    mainOpen = true
    token = token + 1
    playSound("open")
    hideIcon()
    popIn(panel, panelScale, 0.8)
end

local function hideMain()
    if not mainOpen then return end
    mainOpen = false
    token = token + 1
    local my = token
    playSound("close")
    popOut(panel, panelScale, 0.8, function()
        if my == token and not mainOpen then
            panel.Visible = false
            showIcon()
        end
    end)
end

