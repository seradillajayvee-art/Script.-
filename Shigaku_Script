    chip.TextSize = 13
    chip.TextColor3 = DIM
    chip.Text = ""
    chip.Parent = panel
    corner(chip, UDim.new(0, 10))
    return chip
end

local chips = { Q = makeChip(16), E = makeChip(114) }
local STATE_COLOR = { red = RED, ["--"] = LIGHT, none = DIM, off = DIM }

local function setChip(letter, state)
    local chip = chips[letter]
    local txt = letter .. ": " .. state
    if chip.Text ~= txt then
        chip.Text = txt
        chip.TextColor3 = STATE_COLOR[state] or DIM
    end
end

